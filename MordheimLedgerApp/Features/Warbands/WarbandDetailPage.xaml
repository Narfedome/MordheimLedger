<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MordheimLedgerApp.Features.Warbands"
             xmlns:models="clr-namespace:MordheimLedgerApp.Core.Models;assembly=MordheimLedgerApp.Core"
             xmlns:header="clr-namespace:MordheimLedgerApp.Components.DetailPageHeader"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             x:Class="MordheimLedgerApp.Features.Warbands.WarbandDetailPage"
             x:DataType="vm:WarbandDetailViewModel"
             Shell.NavBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <components:WatermarkedLayout>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <header:DetailPageHeaderView Grid.Row="0" x:Name="Header" Title="{Binding Warband.Name}" BackCommand="{Binding BackCommand}"/>

        <Label Grid.Row="1" Margin="16,0,16,8" TextColor="{DynamicResource AppTextMuted}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{loc:Loc WarbandsTreasuryLabel}"/>
                    <Span Text="{Binding Warband.Treasury, StringFormat=' {0} gc'}"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!-- Roster / Historique : pas de précédent DmTools pour des "onglets" internes à une page de
             détail - toggle minimal (deux boutons + IsVisible) plutôt qu'un vrai TabbedPage/Shell tab. -->
        <HorizontalStackLayout Grid.Row="2" Spacing="16" Margin="16,0,16,8">
            <Button Text="{loc:Loc TabRoster}" Command="{Binding ShowRosterCommand}"
                    BackgroundColor="Transparent" TextColor="{DynamicResource AppAccent}" Padding="0"/>
            <Button Text="{loc:Loc TabHistory}" Command="{Binding ShowHistoryTabCommand}"
                    BackgroundColor="Transparent" TextColor="{DynamicResource AppAccent}" Padding="0"/>
        </HorizontalStackLayout>

        <CollectionView Grid.Row="3" x:Name="WarriorCollection" ItemsSource="{Binding Warriors}" Margin="0,8"
                        IsVisible="{Binding ShowHistory, Converter={StaticResource InverseBoolConverter}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Warrior">
                    <Border Style="{StaticResource SectionCardBorderStyle}" Margin="12,6">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"/>
                                <Label Grid.Column="1" Text="Hero" TextColor="{DynamicResource AppAccent}"
                                       IsVisible="{Binding IsHero}"/>
                                <Label Grid.Column="1" Text="Henchman" TextColor="{DynamicResource AppTextMuted}"
                                       IsVisible="{Binding IsHero, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Movement, StringFormat='M{0}'}" FontSize="12"/>
                                <Label Text="{Binding WeaponSkill, StringFormat='WS{0}'}" FontSize="12"/>
                                <Label Text="{Binding BallisticSkill, StringFormat='BS{0}'}" FontSize="12"/>
                                <Label Text="{Binding Strength, StringFormat='S{0}'}" FontSize="12"/>
                                <Label Text="{Binding Toughness, StringFormat='T{0}'}" FontSize="12"/>
                                <Label Text="{Binding Wounds, StringFormat='W{0}'}" FontSize="12"/>
                                <Label Text="{Binding Initiative, StringFormat='I{0}'}" FontSize="12"/>
                                <Label Text="{Binding Attacks, StringFormat='A{0}'}" FontSize="12"/>
                                <Label Text="{Binding Leadership, StringFormat='Ld{0}'}" FontSize="12"/>
                            </HorizontalStackLayout>
                            <Label FontSize="12" TextColor="{DynamicResource AppTextMuted}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{loc:Loc WarriorsCostLabel}"/>
                                        <Span Text="{Binding Cost, StringFormat=' {0}gc'}"/>
                                        <Span Text="  ·  "/>
                                        <Span Text="{loc:Loc WarriorsXpLabel}"/>
                                        <Span Text="{Binding Experience, StringFormat=' {0}'}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="0,8" IsVisible="{Binding ShowHistory}">
            <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="16,0,16,8">
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                     Command="{Binding AddNoteCommand}"
                                     Tooltip="{loc:Loc HistoryAddNote}"/>
            </HorizontalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding HistoryEntries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryEntry">
                        <Border Style="{StaticResource SectionCardBorderStyle}" Margin="12,6">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Date, StringFormat='{0:g}'}" FontSize="12"
                                       TextColor="{DynamicResource AppTextMuted}"/>
                                <Label Text="{Binding Text}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <HorizontalStackLayout Grid.Row="4" Spacing="10" HorizontalOptions="Center" Margin="0,8">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                 Command="{Binding RecruitWarriorCommand}"
                                 Tooltip="{loc:Loc BtnRecruit}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.FlagCheckered}"
                                 Command="{Binding EndOfGameCommand}"
                                 Tooltip="{loc:Loc EndOfGameTitle}"/>
        </HorizontalStackLayout>
    </Grid>
    </components:WatermarkedLayout>
</ContentPage>
