<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Components.FaIconButtonView"  x:Name="root">

    <Grid x:Name="RootGrid">

        <!-- Background image : Border + Image ajoutés en code seulement si BackgroundImage est renseignée
             (voir FaIconButtonView.xaml.cs) - jamais le cas dans l'appli aujourd'hui, et ce bouton est
             instancié des centaines de fois (puces, cartes guerrier, tuiles). -->

        <Button
        Text="{Binding Source={x:Reference root}, Path=Icon}"
        FontFamily="{Binding Source={x:Reference root}, Path=IconFont}"
        FontSize="{Binding Source={x:Reference root}, Path=IconSize}"
        TextColor="{Binding Source={x:Reference root}, Path=IconColor}"
        BackgroundColor="{Binding Source={x:Reference root}, Path=IconBackgroundColor}"
        CornerRadius="{Binding Source={x:Reference root}, Path=CornerRadius}"
        Command="{Binding Source={x:Reference root}, Path=Command}"
        CommandParameter="{Binding Source={x:Reference root}, Path=CommandParameter}"
        ToolTipProperties.Text="{Binding Source={x:Reference root}, Path=Tooltip}"
        WidthRequest="{Binding Source={x:Reference root}, Path=ButtonWidthRequest}"
        HeightRequest="{Binding Source={x:Reference root}, Path=ButtonHeightRequest}"
        Padding="0"
        HorizontalOptions="Center"
        VerticalOptions="{Binding Source={x:Reference root}, Path=ButtonVerticalOptions}" />

    </Grid>
</ContentView>
