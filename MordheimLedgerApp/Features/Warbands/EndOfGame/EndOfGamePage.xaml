<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:form="clr-namespace:MordheimLedgerApp.Components.FormPage"
               xmlns:converters="clr-namespace:MordheimLedgerApp.Converters"
               x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.EndOfGamePage"
               x:DataType="local:EndOfGamePageViewModel"
               Shell.NavBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <!-- Une vue par étape (2026-09-22, optimisation de l'ouverture) - voir StepViewConverter's own
             doc. Chaque StepKind a sa propre vue sous Steps/*StepView.xaml (toutes liées au même
             EndOfGamePageViewModel partagé) - seule la vue de l'étape COURANTE est construite. -->
        <converters:StepViewConverter x:Key="StepViewConverter"/>
    </ContentPage.Resources>

    <!-- Même gabarit que les formulaires plein écran (FormPageLayout, maquette « Refonte dialogs et Fin de
         partie ») : ✕ pour abandonner (confirmation si la saisie a commencé, voir Exit), nom de la bande en
         sous-titre, pied Précédent / Suivant (Enregistrer à la dernière étape). Pas de « Étape n/N » : le total
         varie selon les jets et les recrutements (retiré à la demande de l'utilisateur le 2026-09-22). -->
    <form:FormPageLayout x:Name="FormLayout"
                         Title="{loc:Loc EndOfGameTitle}"
                         Subtitle="{Binding HeaderSubtitle}"
                         CloseCommand="{Binding ExitCommand}"
                         IsBusy="{Binding Loading.IsLoading}"
                         SecondaryText="{loc:Loc LibBack}"
                         SecondaryCommand="{Binding BackCommand}"
                         SecondaryEnabled="{Binding CanGoBack}"
                         PrimaryText="{Binding PrimaryButtonText}"
                         PrimaryCommand="{Binding PrimaryButtonCommand}">
        <ContentView Content="{Binding CurrentStepKind, Converter={StaticResource StepViewConverter}}"/>
    </form:FormPageLayout>
</ContentPage>
