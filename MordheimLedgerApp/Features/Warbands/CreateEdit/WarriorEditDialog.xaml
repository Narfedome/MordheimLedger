<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.CreateEdit"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               xmlns:models="clr-namespace:MordheimLedgerApp.Core.Models;assembly=MordheimLedgerApp.Core"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Warbands.CreateEdit.WarriorEditDialog"
               x:DataType="local:WarriorEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <dialogs:StableHeightScrollView>
        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}"
                       Style="{StaticResource DialogTitleLabelStyle}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Trash}"
                                              IconSize="14" ButtonWidthRequest="28" ButtonHeightRequest="28"
                                              Command="{Binding DeleteCommand}"/>
            </Grid>

            <!-- Onglets Profil/Équipement/Compétences/Blessures/Sorts/Mutations - Profil (Nom/XP/stats/
                 Mouvement/Animal) a son propre onglet plutôt que d'être empilé en dur au-dessus de la
                 barre d'onglets (précédent : WarriorArchetypeEditDialog côté Bibliothèque). -->
            <components:ScrollableTabStripView>
                <HorizontalStackLayout Spacing="16">
                    <components:TabToggleButton Text="{loc:Loc LibTabProfile}" Command="{Binding ShowProfilTabCommand}"
                                                 IsActive="{Binding IsProfilTab}" FontSize="12"/>
                    <components:TabToggleButton Text="{loc:Loc WarriorsEquipmentHeading}" Command="{Binding ShowEquipmentTabCommand}"
                                                 IsActive="{Binding IsEquipmentTab}" FontSize="12"/>
                    <components:TabToggleButton Text="{loc:Loc WarriorsSkillsHeading}" Command="{Binding ShowSkillsTabCommand}"
                                                 IsActive="{Binding IsSkillsTab}" FontSize="12"/>
                    <components:TabToggleButton Text="{loc:Loc WarriorsInjuriesHeading}" Command="{Binding ShowInjuriesTabCommand}"
                                                 IsActive="{Binding IsInjuriesTab}" FontSize="12"/>
                    <!-- Onglet Sorts : visible seulement si l'archétype de ce guerrier est un lanceur de
                         sorts (WarriorArchetype.IsSpellcaster) - inutile pour un Homme de main lambda. -->
                    <components:TabToggleButton Text="{loc:Loc WarriorsSpellsHeading}" Command="{Binding ShowSpellsTabCommand}"
                                                 IsActive="{Binding IsSpellsTab}" FontSize="12"
                                                 IsVisible="{Binding IsSpellcaster}"/>
                    <!-- Onglet Mutations : visible seulement si l'archétype de ce guerrier a
                         WarriorArchetype.CanBuyMutations (Mutants/Possédés). -->
                    <components:TabToggleButton Text="{loc:Loc WarriorsMutationsHeading}" Command="{Binding ShowMutationsTabCommand}"
                                                 IsActive="{Binding IsMutationsTab}" FontSize="12"
                                                 IsVisible="{Binding IsMutant}"/>
                </HorizontalStackLayout>
            </components:ScrollableTabStripView>

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsProfilTab}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Loc PromptName}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Entry Text="{Binding Item.Name}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Loc WarriorExperiencePh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Entry Text="{Binding Item.Experience}" Keyboard="Numeric"/>
                </VerticalStackLayout>

                <!-- Abréviations officielles du livre de règles, pas de traduction - StatRowView en mode
                     édition, même composant que WarriorArchetypeEditDialog (onglet Profil). MovementText
                     lié à MovementInput (pas Item.Movement) : champ texte unique qui accepte un nombre ou
                     une surcharge libre ("2D6"), résolu vers Item.Movement/Item.MovementOverride au Save -
                     même mécanisme que WarriorArchetypeEditDialogViewModel.MovementInput, pas besoin d'un
                     second champ "Surcharge Mouvement" séparé en plus de la colonne M. -->
                <components:StatRowView Item="{Binding Item}" MovementText="{Binding MovementInput}" IsEditable="True"/>

                <!-- Règles spéciales : lecture seule (pas d'AddCommand/RemoveCommand) - se changent depuis
                     la Bibliothèque (WarriorArchetypeEditDialog/WarbandArchetypeEditDialog), pas ici. Même
                     puce/icône que la carte guerrier (WarbandDetailPage.xaml). -->
                <components:ChipListView HeaderText="{loc:Loc WarriorsSpecialRulesHeading}"
                                          ItemsSource="{Binding SpecialRules}"
                                          IconGlyph="{x:Static icons:SolidFont.Scroll}"
                                          HeaderFontSize="12" HeaderTextColor="{DynamicResource AppTextMuted}"
                                          Command="{Binding ShowSpecialRuleDetailCommand}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEquipmentTab}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc WarriorsEquipmentHeading}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:SolidFont.Plus}"
                                                  IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                  IsVisible="{Binding Item.CanUseEquipment}"
                                                  Command="{Binding AddEquipmentCommand}"/>
                </Grid>
                <!-- ChipView (pas ChipListView) : l'icône varie par item (EquipmentCategoryIconConverter),
                     même motif que la carte guerrier en lecture seule (WarbandDetailPage.xaml). -->
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Equipment}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WarriorEquipment">
                            <components:ChipView Item="{Binding .}"
                                                  IconGlyph="{Binding Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                  IconFontFamily="RpgAwesome"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=ShowEquipmentDetailCommand}"
                                                  RemoveCommand="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=RemoveEquipmentCommand}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Monture : considérée comme de l'équipement dans le livre des règles (regroupée ici
                     malgré tout), même si le modèle de données la sépare (Warrior.Animal, champ 0..1 -
                     plus simple qu'une liste) - champ objet unique optionnel via ChipItemView (Item
                     nullable, AddCommand="sélectionner"/RemoveCommand="effacer"/Command="détail"). -->
                <components:ChipItemView HeaderText="{loc:Loc WarriorAnimalHeading}"
                                          Item="{Binding Item.Animal}"
                                          IconGlyph="{x:Static icons:RpgFont.RaPawprint}"
                                          IconFontFamily="RpgAwesome"
                                          HeaderFontSize="12"
                                          Command="{Binding ShowAnimalDetailCommand}"
                                          AddCommand="{Binding SelectAnimalCommand}"
                                          RemoveCommand="{Binding ClearAnimalCommand}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSkillsTab}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc WarriorsSkillsHeading}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:SolidFont.Plus}"
                                                  IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                  Command="{Binding AddSkillCommand}"/>
                </Grid>
                <!-- ChipView (pas ChipListView) : l'icône varie par item (SkillCategoryIconConverter). -->
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Skills}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WarriorSkill">
                            <components:ChipView Item="{Binding .}"
                                                  IconGlyph="{Binding Item.Category, Converter={StaticResource SkillCategoryIconConverter}}"
                                                  IconFontFamily="RpgAwesome"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=ShowSkillDetailCommand}"
                                                  RemoveCommand="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=RemoveSkillCommand}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Blessures/Sorts/Mutations : un seul glyphe pour toute la liste - ChipListView directement
                 (header + "+" + puces + "x" en un seul composant), pas de FlexLayout/DataTemplate à la
                 main. Pas de RelativeSource AncestorType nécessaire ici : contrairement aux puces
                 Équipement/Compétences (bindées depuis l'intérieur d'un DataTemplate), ChipListView lui-
                 même reste au niveau racine du dialog, donc son BindingContext est déjà le ViewModel. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsInjuriesTab}">
                <components:ChipListView HeaderText="{loc:Loc WarriorsInjuriesHeading}"
                                          ItemsSource="{Binding Injuries}"
                                          IconGlyph="{x:Static icons:RpgFont.RaBrokenBone}"
                                          IconFontFamily="RpgAwesome"
                                          HeaderFontSize="12" HeaderTextColor="{DynamicResource AppTextMuted}"
                                          Command="{Binding ShowInjuryDetailCommand}"
                                          AddCommand="{Binding AddInjuryCommand}"
                                          RemoveCommand="{Binding RemoveInjuryCommand}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSpellsTab}">
                <components:ChipListView HeaderText="{loc:Loc WarriorsSpellsHeading}"
                                          ItemsSource="{Binding Spells}"
                                          IconGlyph="{x:Static icons:RpgFont.RaBurningBook}"
                                          IconFontFamily="RpgAwesome"
                                          HeaderFontSize="12" HeaderTextColor="{DynamicResource AppTextMuted}"
                                          Command="{Binding ShowSpellDetailCommand}"
                                          AddCommand="{Binding AddSpellCommand}"
                                          RemoveCommand="{Binding RemoveSpellCommand}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsMutationsTab}">
                <components:ChipListView HeaderText="{loc:Loc WarriorsMutationsHeading}"
                                          ItemsSource="{Binding Mutations}"
                                          IconGlyph="{x:Static icons:RpgFont.RaBiohazard}"
                                          IconFontFamily="RpgAwesome"
                                          HeaderFontSize="12" HeaderTextColor="{DynamicResource AppTextMuted}"
                                          Command="{Binding ShowMutationDetailCommand}"
                                          AddCommand="{Binding AddMutationCommand}"
                                          RemoveCommand="{Binding RemoveMutationCommand}"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc BtnSave}"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </VerticalStackLayout>
        </dialogs:StableHeightScrollView>
    </Border>
</dialogs:DialogContent>
