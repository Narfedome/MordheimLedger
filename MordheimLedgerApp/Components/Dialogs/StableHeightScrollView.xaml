<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Components.Dialogs.StableHeightScrollView">
    <!-- Un seul enfant attendu (Content de ContentView n'accepte qu'une View) - même idiome
         ContentPresenter que ScrollableTabStripView/PickerSelectorLayout : l'appelant place son
         VerticalStackLayout directement comme Content, sans x:Name ni SizeChanged à câbler lui-même. -->
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <ScrollView x:Name="PartScrollView" VerticalOptions="Start">
                <ContentPresenter />
            </ScrollView>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
