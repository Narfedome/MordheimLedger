<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               x:TypeArguments="system:Int32"
               x:Class="MordheimLedgerApp.Components.Dialogs.ActionSheetDialog"
               x:DataType="dialogs:ActionSheetDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="320">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>
            <ScrollView MaximumHeightRequest="320">
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:ActionSheetOption">
                            <Grid>
                                <Label Text="{Binding Label}" IsVisible="{Binding IsHeader}"
                                       FontAttributes="Bold" FontSize="12" Margin="4,8,4,2"
                                       TextColor="{DynamicResource AppTextMuted}"/>
                                <Button Text="{Binding Label}"
                                        IsVisible="{Binding IsHeader, Converter={StaticResource InverseBoolConverter}}"
                                        Style="{StaticResource DialogOptionButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type dialogs:ActionSheetDialogViewModel}}, Path=SelectCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
            <Button Text="{Binding CancelLabel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>
        </VerticalStackLayout>
    </Border>
</dialogs:DialogContent>
