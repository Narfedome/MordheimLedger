<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Features.Library.MagicSchools.MagicSchoolView"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.MagicSchools"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Name="root">

    <!-- Pas de filtre par catégorie : une école de magie n'a pas de regroupement par type dans le livre
         de règles. Deux gabarits selon UseTileLayout (voir MagicSchoolView.xaml.cs) : liste à plat
         (MagicSchoolListPage, "Gérer les écoles de magie" depuis l'onglet Sorts) ou grille de tuiles
         (MagicSchoolSelectorPage, même présentation que les autres pickers de bande). -->
    <Grid Margin="5" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="120" HeightRequest="120"/>

        <!-- Liste à plat façon WarbandListPage (BoxView ChapterDividerStyle/SelectionMarkerStyle). -->
        <CollectionView Grid.Row="0" x:Name="ItemsCollection"
                IsVisible="{Binding Source={x:Reference root}, Path=UseTileLayout, Converter={StaticResource InverseBoolConverter}}"
                ItemsSource="{Binding MagicSchools}"
                SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MagicSchoolRow">
                    <Grid ColumnDefinitions="4,*" Padding="{DynamicResource AppChapterRowPadding}" MinimumHeightRequest="48" ColumnSpacing="8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference root}, Path=BindingContext.SelectCommand}"
                                CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <BoxView Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ChapterDividerStyle}"/>
                        <BoxView Grid.Column="0" Style="{StaticResource SelectionMarkerStyle}"/>
                        <Label Grid.Column="1" Text="{Binding Item.Name}"
                               FontSize="{OnIdiom Default=15, Desktop=13}"
                               VerticalOptions="Center" Style="{StaticResource TruncatedLabelStyle}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Grille de tuiles à plat (pas de IsGrouped), même gabarit que les autres catalogues
             (SpecialRuleView/MutationView), juste sans en-tête de groupe. Bouton info : réutilise le
             ChipDetailDialog générique (voir MagicSchoolViewModel.ShowDetails), pas de dialog récap dédié
             comme pour les 8 types catalogués. -->
        <CollectionView Grid.Row="0" x:Name="TilesCollection"
                IsVisible="{Binding Source={x:Reference root}, Path=UseTileLayout}"
                ItemsSource="{Binding MagicSchools}"
                SelectionMode="None"
                ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.Behaviors>
                <components:ResponsiveGridSpanBehavior/>
            </CollectionView.Behaviors>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="5" HorizontalItemSpacing="5" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MagicSchoolRow">
                    <Border Style="{StaticResource SelectableGridItemBorderStyle}" BackgroundColor="Transparent" Stroke="Grey">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList/>
                        </VisualStateManager.VisualStateGroups>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="LightSkyBlue"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference root}, Path=BindingContext.SelectCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Grid Style="{StaticResource CodexTileFrameStyle}">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <components:LibraryItemImageView
                                    ImagePath="{Binding Item.ImagePath}"
                                    DefaultGlyph="{x:Static icons:RpgFont.RaCrystalBall}"
                                    FontFamily="RpgAwesome"
                                    WidthRequest="20" HeightRequest="20"
                                    HorizontalOptions="Center" />
                                <Label Text="{Binding Item.Name}"
                                    Style="{StaticResource CodexTileNameLabelStyle}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Margin="5,0"/>
                            </VerticalStackLayout>
                            <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                          Icon="{x:Static icons:SolidFont.CircleInfo}"
                                                          Tooltip="{loc:Loc LibDetailsTooltip}"
                                                          IconSize="12" ButtonWidthRequest="20" ButtonHeightRequest="20"
                                                          HorizontalOptions="End" VerticalOptions="Start"
                                                          Command="{Binding Source={x:Reference root}, Path=BindingContext.ShowDetailsCommand}"
                                                          CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center" Margin="0,8"
                               IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                         Command="{Binding CreateCommand}"
                                         Tooltip="{loc:Loc BtnAdd}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                         Command="{Binding EditCommand}"
                                         Tooltip="{loc:Loc BtnRename}"
                                         IsEnabled="{Binding SelectedRow, Converter={StaticResource IsNotNullConverter}}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                         Command="{Binding DeleteCommand}"
                                         Tooltip="{loc:Loc BtnDelete}"
                                         IsEnabled="{Binding SelectedRow, Converter={StaticResource IsNotNullConverter}}"/>
        </HorizontalStackLayout>

        <!-- Multi-sélection : un tap bascule le liseré bleu (IsSelected) de la tuile, Confirmer ajoute
             toutes les tuiles cochées d'un coup. -->
        <HorizontalStackLayout Grid.Row="1" Spacing="20" HorizontalOptions="Center" Margin="0,8"
                               IsVisible="{Binding Source={x:Reference root}, Path=IsCrud, Converter={StaticResource InverseBoolConverter}}">
            <!-- Créer un nouvel élément directement depuis le sélecteur - auto-sélectionné à la
                 création (voir MagicSchoolViewModel.Create), pas besoin de fermer/rouvrir le picker. -->
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                         Command="{Binding CreateCommand}"
                                         Tooltip="{loc:Loc BtnAdd}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CircleCheck}"
                                         Command="{Binding ConfirmSelectionCommand}"
                                         Tooltip="{loc:Loc LibConfirm}"
                                         IsEnabled="{Binding HasSelectedRows}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CircleXmark}"
                                         Command="{Binding CancelCommand}"
                                         Tooltip="{loc:Loc LibCancel}"/>
        </HorizontalStackLayout>

    </Grid>
</ContentView>
