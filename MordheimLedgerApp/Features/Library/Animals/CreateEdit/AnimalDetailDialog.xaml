<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.Animals.CreateEdit"
               xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.Animals.CreateEdit.AnimalDetailDialog"
               x:DataType="local:AnimalDetailDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="360">
        <ScrollView x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}"
                       Style="{StaticResource DialogTitleLabelStyle}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Xmark}"
                                              IconSize="14" ButtonWidthRequest="24" ButtonHeightRequest="24"
                                              Command="{Binding CancelCommand}"/>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="{loc:Loc AnimalCostPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Label Text="{Binding CostDisplay}" TextColor="{DynamicResource AppText}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="{loc:Loc AnimalRarityPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Label Text="{Binding RarityDisplay}" TextColor="{DynamicResource AppText}"/>
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout Spacing="4">
                <Label Text="{loc:Loc LibDescriptionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Label Text="{Binding Item.Description}" TextColor="{DynamicResource AppText}"/>
            </VerticalStackLayout>

            <!-- Profil sur une seule ligne (abréviations françaises officielles) - StatRowView partagé
                 avec AnimalEditDialog/WarriorArchetypeDetailDialog/WarbandDetailPage. Pas de
                 MovementDisplay sur Animal (contrairement à WarriorArchetype/Warrior) - MovementText
                 fourni explicitement. -->
            <components:StatRowView Item="{Binding Item}" MovementText="{Binding Item.Movement}"/>

            <components:ChipListView HeaderText="{Binding RestrictedWarbandsHeaderText}"
                                      AlwaysShowSection="True"
                                      ItemsSource="{Binding RestrictedWarbands}"
                                      IconGlyph="{x:Static icons:SolidFont.Shield}"
                                      Command="{Binding ShowWarbandDetailCommand}"/>

            <components:ChipListView HeaderText="{loc:Loc LibSpecialRulesPh}"
                                      ItemsSource="{Binding Item.SpecialRules}"
                                      IconGlyph="{x:Static icons:SolidFont.Scroll}"
                                      Command="{Binding ShowSpecialRuleDetailCommand}"/>
        </VerticalStackLayout>
        </ScrollView>
    </Border>
</dialogs:DialogContent>
