<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.WarriorArchetypes.CreateEdit"
               xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.WarriorArchetypes.CreateEdit.WarriorArchetypeEditDialog"
               x:DataType="local:WarriorArchetypeEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="360">
        <ScrollView x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"
                   TextColor="{DynamicResource AppText}"/>
            <Label Text="{Binding StepLabel}" TextColor="{DynamicResource AppTextMuted}"/>

            <!-- Étape 1 : identité -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep0}">
                <components:LibraryItemImageView ImagePath="{Binding Item.ImagePath}"
                                                  DefaultGlyph="{x:Static icons:SolidFont.UserShield}" MaximumHeightRequest="30"/>
                <Entry Text="{Binding Item.Name}" Placeholder="{loc:Loc WarriorArchetypeNamePh}"/>
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding Item.IsHero}" VerticalOptions="Center"/>
                    <Label Text="{loc:Loc WarriorArchetypeIsHero}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <!-- Mutant/Possédé : ouvre l'onglet Mutations sur la fiche du guerrier recruté (voir
                     WarriorEditDialog.IsMutant). -->
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding Item.CanBuyMutations}" VerticalOptions="Center"/>
                    <Label Text="{loc:Loc WarriorArchetypeCanBuyMutations}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Entry Grid.Column="0" Text="{Binding Item.Cost}" Keyboard="Numeric" Placeholder="{loc:Loc WarriorArchetypeCostPh}"/>
                    <Entry Grid.Column="1" Text="{Binding Item.MaxCount}" Keyboard="Numeric" Placeholder="{loc:Loc WarriorArchetypeMaxCountPh}"/>
                </Grid>
                <Entry Text="{Binding Item.StartingExperience}" Keyboard="Numeric" Placeholder="{loc:Loc WarriorArchetypeStartingExperiencePh}"/>
                <!-- L'école de magie elle-même est liée à la bande (WarbandArchetype.MagicSchools, voir
                     WarbandArchetypeEditDialog) - ici on marque juste ce type de guerrier comme lanceur
                     de sorts. La sélection de sorts (WarriorEditDialog) ne propose alors que les sorts
                     des écoles accordées à la bande. -->
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding Item.IsSpellcaster}" VerticalOptions="Center"/>
                    <Label Text="{loc:Loc WarriorArchetypeIsSpellcaster}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <!-- Quelle liste d'équipement de la bande ce type de guerrier utilise pour son
                     Armement/Armure - "Aucune" pour les archétypes qui n'utilisent jamais d'équipement
                     (Zombies, Squigs des cavernes...). Voir EquipmentList/WarriorArchetype.EquipmentListId. -->
                <Picker Title="{loc:Loc WarriorArchetypeEquipmentListPh}"
                        ItemsSource="{Binding EquipmentListOptions}"
                        SelectedItem="{Binding SelectedEquipmentListLabel}"/>
            </VerticalStackLayout>

            <!-- Étape 2 : profil sur une seule ligne (abréviations françaises officielles, localisées
                 via StatXAbbr). -->
            <Grid IsVisible="{Binding IsStep1}"
                  ColumnDefinitions="*,*,*,*,*,*,*,*,*" ColumnSpacing="4">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{loc:Loc StatMovementAbbr}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
                    <Entry Text="{Binding Item.Movement}" Keyboard="Numeric"/>
                    <!-- Surcharge texte optionnelle (ex. "2D6" pour les Squigs des cavernes, dont le
                         Mouvement n'est pas une caractéristique fixe) - prioritaire sur la valeur
                         numérique ci-dessus partout où le Mouvement est affiché (WarriorArchetype.
                         MovementDisplay/Warrior.MovementDisplay). -->
                    <Entry Text="{Binding Item.MovementOverride}" Placeholder="{loc:Loc WarriorArchetypeMovementOverridePh}" FontSize="11"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="{loc:Loc StatWeaponSkillAbbr}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
                    <Entry Text="{Binding Item.WeaponSkill}" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2">
                    <Label Text="{loc:Loc StatBallisticSkillAbbr}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
                    <Entry Text="{Binding Item.BallisticSkill}" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3">
                    <Label Text="{loc:Loc StatStrengthAbbr}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
                    <Entry Text="{Binding Item.Strength}" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="4">
                    <Label Text="{loc:Loc StatToughnessAbbr}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
                    <Entry Text="{Binding Item.Toughness}" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="5">
                    <Label Text="{loc:Loc StatWoundsAbbr}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
                    <Entry Text="{Binding Item.Wounds}" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="6">
                    <Label Text="{loc:Loc StatInitiativeAbbr}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
                    <Entry Text="{Binding Item.Initiative}" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="7">
                    <Label Text="{loc:Loc StatAttacksAbbr}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
                    <Entry Text="{Binding Item.Attacks}" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="8">
                    <Label Text="{loc:Loc StatLeadershipAbbr}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
                    <Entry Text="{Binding Item.Leadership}" Keyboard="Numeric"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Étape 3 : description + règles spéciales (propres à ce type de guerrier - distinctes des
                 règles spéciales de bande entière, portées par WarbandArchetype.SpecialRules). Chaque
                 règle est une entrée du catalogue partagé SpecialRule (ex. "Chef"), ajoutée/retirée via
                 picker - même principe que les Blessures sur WarriorEditDialog, à ceci près que rien
                 n'est persisté avant Enregistrer (voir SpecialRuleEditDialogViewModel.Save). -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep2}">
                <Editor Text="{Binding Item.Description}" Placeholder="{loc:Loc LibDescriptionPh}" HeightRequest="90"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc LibSpecialRulesPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:SolidFont.Plus}"
                                                  IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                  Command="{Binding AddSpecialRuleCommand}"/>
                </Grid>
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SpecialRules}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="library:SpecialRule">
                            <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{x:Static icons:SolidFont.Scroll}" FontSize="12"
                                           TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                    <Label Text="{Binding Name}" FontSize="11" VerticalOptions="Center"/>
                                    <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                  Icon="{x:Static icons:SolidFont.Xmark}"
                                                                  IconSize="10" ButtonWidthRequest="18" ButtonHeightRequest="18"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorArchetypeEditDialogViewModel}}, Path=RemoveSpecialRuleCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc LibBack}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"/>
                <Button Grid.Column="2"
                        Text="{loc:Loc LibNext}"
                        Command="{Binding NextCommand}"
                        IsVisible="{Binding IsLastStep, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Grid.Column="2"
                        Text="{loc:Loc BtnSave}"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding IsLastStep}"/>
            </Grid>
        </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>
