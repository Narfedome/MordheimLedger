<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:createEdit="clr-namespace:MordheimLedgerApp.Features.Warbands.CreateEdit"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.Steps.RecruitHenchmenEquipmentStepView"
             x:DataType="local:EndOfGamePageViewModel">
            <!-- Étape : Nouveau groupe d'Hommes de main - équipement (achat libre, avec Diviser pour
                 équiper différemment une partie d'un même type recruté - absente si aucun nouveau groupe). -->
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc EndOfGameRecruitHenchmenEquipmentHeading}" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="{Binding RecruitmentTreasuryDisplay}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                </Grid>
                <Label Text="{loc:Loc EndOfGameTreasuryBlockedMessage}" TextColor="{StaticResource AppDanger}" FontSize="12"
                       IsVisible="{Binding IsTreasuryBlocked}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecruitedHenchmanRows}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="createEdit:WarriorRecruitRow">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding HenchmanGroupDrafts}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="createEdit:HenchmanGroupDraft">
                                        <VerticalStackLayout Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                                <Label Grid.Column="0" Text="{Binding Name}" FontSize="13" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding Count, StringFormat='× {0}'}" FontSize="12"
                                                       TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                                                <components:FaIconButtonView Grid.Column="2" Style="{StaticResource GhostIconButtonStyle}"
                                                                              Icon="{x:Static icons:SolidFont.ArrowsSplitUpAndLeft}"
                                                                              Rotation="-90"
                                                                              Tooltip="{loc:Loc WarbandsSplitGroupTitle}"
                                                                              IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                                              IsVisible="{Binding CanSplit}"
                                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=SplitHenchmanGroupDraftCommand}"
                                                                              CommandParameter="{Binding .}"/>
                                            </Grid>
                                            <components:RecruitSlotTabsView Item="{Binding .}"
                                                  IsVisible="{Binding ShowTabsView}"
                                                  AddEquipmentCommand="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=AddRecruitEquipmentCommand}"
                                                  RemoveEquipmentCommand="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=RemoveRecruitEquipmentCommand}"
                                                  ShowEquipmentDetailCommand="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=ShowRecruitEquipmentDetailCommand}"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

</ContentView>
