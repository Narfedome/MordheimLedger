<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MordheimLedgerApp.Features.Warbands"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Class="MordheimLedgerApp.Features.Warbands.WarbandListPage"
             x:DataType="vm:WarbandListViewModel"
             Title="{loc:Loc TabWarbands}">

    <Grid Padding="10,0,10,10" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ActivityIndicator Grid.Row="1" Grid.RowSpan="2" IsRunning="{Binding Loading.IsLoading}"
                   IsVisible="{Binding Loading.IsLoading}"
                   VerticalOptions="Center" HorizontalOptions="Center"
                   WidthRequest="80" HeightRequest="80"/>

        <!-- SelectionMode="None" (pas de sélection native) : cf. WarbandListViewModel, même raison
             que CategoryListPage de DmTools (fond de sélection natif Android teinté par colorAccent
             quel que soit le style posé dessus). SelectedWarband est géré à la main via un
             TapGestureRecognizer par ligne plutôt que SelectedItem. -->
        <CollectionView Grid.Row="1" x:Name="WarbandCollection"
                ItemsSource="{Binding Warbands}"
                SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:WarbandRowItem">
                    <!-- Padding sur ce Grid englobant (pas Margin sur le Border racine) : le Margin de
                         la racine d'un DataTemplate de CollectionView n'est pas fiable sur Windows. -->
                    <Grid Padding="0,0,0,8">
                        <Border Style="{StaticResource RowBorderStyle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandListViewModel}}, Path=SelectWarbandCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="LightSkyBlue"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"
                                       FontSize="{DynamicResource AppFontSizeSectionTitle}"
                                       VerticalOptions="Center" Style="{StaticResource TruncatedLabelStyle}"/>
                                <Label Grid.Column="1" Text="{Binding Treasury, StringFormat='{0} gc'}"
                                       VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center" Margin="0,8">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                 Command="{Binding CreateWarbandCommand}"
                                 Tooltip="{loc:Loc BtnAdd}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.DoorOpen}"
                                 Command="{Binding OpenSelectedWarbandCommand}"
                                 Tooltip="{loc:Loc BtnOpen}"
                                 IsEnabled="{Binding CanModifySelectedWarband}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                 Command="{Binding DeleteSelectedWarbandCommand}"
                                 Tooltip="{loc:Loc BtnDelete}"
                                 IsEnabled="{Binding CanModifySelectedWarband}"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
