<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Components.Dialogs.ConfirmDialog"
               x:DataType="dialogs:ConfirmDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0">
    <!-- Centré comme tous les dialogs (DialogPage). Action à droite, libellé d'action plutôt que Oui / Non
         quand l'appelant en fournit un, en rouge si elle détruit quelque chose (IsDestructive). Simple
         information (pas d'Annuler) : titre, message et bouton centrés. -->
    <Border Style="{StaticResource DialogCardBorderStyle}">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   Style="{StaticResource DialogTitleLabelStyle}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HasCancel}" Value="False">
                        <Setter Property="HorizontalTextAlignment" Value="Center"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label Text="{Binding Message}"
                   TextColor="{DynamicResource AppTextMuted}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HasCancel}" Value="False">
                        <Setter Property="HorizontalTextAlignment" Value="Center"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{Binding CancelLabel}"
                        IsVisible="{Binding HasCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding HasCancel}" Value="False">
                            <Setter Property="Grid.Column" Value="0"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="HorizontalOptions" Value="Center"/>
                            <Setter Property="MinimumWidthRequest" Value="140"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsDestructive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource AppDanger}"/>
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </VerticalStackLayout>
    </Border>
</dialogs:DialogContent>
