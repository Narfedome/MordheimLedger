<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MordheimLedgerApp.Features.Warbands"
             xmlns:models="clr-namespace:MordheimLedgerApp.Core.Models;assembly=MordheimLedgerApp.Core"
             x:Class="MordheimLedgerApp.Features.Warbands.WarbandListPage"
             x:DataType="vm:WarbandListViewModel"
             Title="Warbands">

    <Grid RowDefinitions="*,Auto">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Warbands}" Margin="0,8">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Warband">
                    <Border Style="{StaticResource SectionCardBorderStyle}" Margin="12,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"/>
                                <Label Text="{Binding Treasury, StringFormat='{0} gc'}" TextColor="{DynamicResource AppTextMuted}"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Open"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandListViewModel}}, Path=OpenWarbandCommand}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="+ New Warband" Margin="12" Command="{Binding CreateWarbandCommand}"/>
    </Grid>
</ContentPage>
