<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Components.LibraryItemImageView"
             x:Name="root">

    <Grid>
        <Image Source="{Binding Source={x:Reference root}, Path=ImagePath}">
            <Image.Triggers>
                <DataTrigger TargetType="Image" Binding="{Binding Source={x:Reference root}, Path=ImagePath}" Value="">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </Image.Triggers>
        </Image>

        <!-- Label plutôt que FontImageSource/Image : FontImageSource rastérise le glyphe dans un
             bitmap carré de taille fixe et rogne les glyphes dont l'encre naturelle dépasse ce carré
             (ex. RaFootprint, RaMuscleUp - repéré visuellement, glyphes coupés). Un Label dimensionne
             son texte normalement, sans ce recadrage, comme les icônes de puce ailleurs dans l'app. -->
        <Label Text="{Binding Source={x:Reference root}, Path=DefaultGlyph}"
               FontFamily="{Binding Source={x:Reference root}, Path=FontFamily}"
               FontSize="{Binding Source={x:Reference root}, Path=HeightRequest}"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
               HorizontalOptions="Center" VerticalOptions="Center"
               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
               LineBreakMode="NoWrap" IsVisible="False">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference root}, Path=ImagePath}" Value="">
                    <Setter Property="IsVisible" Value="True"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Grid>
</ContentView>
