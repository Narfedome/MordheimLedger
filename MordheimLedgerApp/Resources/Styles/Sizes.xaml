<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Minimum size (Height/Width) of interactive controls: 44 is the recommended touch target
         (Android, finger) but oversized with a mouse on Desktop, where apps run closer to 32. -->
    <OnIdiom x:Key="AppMinTouchTarget" x:TypeArguments="x:Double" Phone="44" Tablet="44" Desktop="32" />

    <!-- Smaller touch target for inline text-buttons inside a section card (e.g. Settings rows),
         where AppMinTouchTarget would look oversized next to a single line of text. -->
    <OnIdiom x:Key="AppInlineButtonMinSize" x:TypeArguments="x:Double" Phone="36" Tablet="36" Desktop="20" />

    <!-- Base and title font sizes: MAUI doesn't map font sizes 1:1 across platforms — the same value
         renders visibly larger on Windows/WinUI than on Android at equivalent density, hence a
         smaller Desktop base. -->
    <OnIdiom x:Key="AppFontSizeBase" x:TypeArguments="x:Double" Phone="14" Tablet="14" Desktop="12" />
    <OnIdiom x:Key="AppFontSizeSectionTitle" x:TypeArguments="x:Double" Phone="16" Tablet="16" Desktop="14" />

    <!-- Button and dialog card padding: more compact on Desktop. -->
    <OnIdiom x:Key="AppButtonPadding" x:TypeArguments="Thickness" Phone="14,10" Tablet="14,10" Desktop="12,7" />
    <OnIdiom x:Key="AppDialogCardPadding" x:TypeArguments="x:Double" Phone="20" Tablet="20" Desktop="16" />
    <OnIdiom x:Key="AppSectionCardPadding" x:TypeArguments="x:Double" Phone="16" Tablet="16" Desktop="12" />

    <!-- WarbandRow (style "Chapitre" façon SessionTemplate de DmTools) : padding de ligne plus
         compact qu'AppAccordionRowPadding, pas de card autour - cf. WarbandListPage.xaml. Marge
         gauche présente (contrairement à SessionTemplate, dont le "0" initial laisse la place à
         l'indentation/poignée d'une ligne imbriquée) puisque la bande est ici de premier niveau, pas
         nichée sous un groupe. -->
    <OnIdiom x:Key="AppChapterRowPadding" x:TypeArguments="Thickness" Phone="8,5,8,6" Tablet="8,5,8,6" Desktop="8,3,8,3" />

</ResourceDictionary>
