<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MordheimLedgerApp.Components">

    <!-- Discreet variant of FaIconButtonView (transparent background, muted icon) for a
         chevron/back button that should blend into the background rather than stand out as a
         primary action (cf. DetailPageHeaderView). -->
    <Style x:Key="GhostIconButtonStyle" TargetType="components:FaIconButtonView">
        <Setter Property="IconBackgroundColor" Value="Transparent"/>
        <Setter Property="IconColor" Value="{DynamicResource AppTextMuted}"/>
    </Style>

    <!-- Implicit style (no x:Key): solid accent background by default for any FaIconButtonView that
         doesn't set its own Style — an explicit Style="{StaticResource GhostIconButtonStyle}" wins over it. -->
    <Style TargetType="components:FaIconButtonView">
        <Setter Property="IconBackgroundColor" Value="{DynamicResource AppAccent}"/>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource AppAccent}" />
    </Style>


    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"/>
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource AppAccent}"/>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource AppBorder}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 15"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <!-- Card used by themed popups (confirm/prompt/action-sheet dialogs) -->
    <Style TargetType="Border" x:Key="DialogCardBorderStyle">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource AppBorder}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource AppDialogCardPadding}"/>
    </Style>

    <!-- Section card (settings-style groupings): translucent surface so text stays legible over any
         future background art, without Border.Opacity dimming the content on top of it too. -->
    <Style TargetType="Border" x:Key="SectionCardBorderStyle">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppSurfaceTranslucent}" />
        <Setter Property="Stroke" Value="{DynamicResource AppBorder}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource AppSectionCardPadding}"/>
    </Style>

    <!-- Barre de sélection à gauche d'une ligne de liste (WarbandListPage) : couleur fixe (pas liée
         au thème/palette), pour que la sélection ressorte quel que soit le thème choisi. -->
    <Style x:Key="SelectionMarkerStyle" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="4"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="Color" Value="LightSkyBlue"/>
        <Setter Property="IsVisible" Value="{Binding IsSelected}"/>
    </Style>

    <!-- Card sélectionnable (WarbandDetailPage : roster) : liseré seul (pas de barre séparée comme
         SelectionMarkerStyle), piloté par IsSelected (DataTrigger) plutôt que par
         VisualStateManager/sélection native - un Border stylé par VisualState (cf.
         SelectableGridItemBorderStyle) n'empêche pas Android d'afficher son propre fond de sélection
         teinté colorAccent par-dessus, seule une sélection gérée à la main (SelectionMode="None")
         l'évite. Couleur fixe, même raison que SelectionMarkerStyle. -->
    <Style x:Key="SelectableCardBorderStyle" TargetType="Border" BasedOn="{StaticResource SectionCardBorderStyle}">
        <Setter Property="StrokeThickness" Value="2"/>
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Stroke" Value="LightSkyBlue"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Trait fin sous une ligne "Chapitre" (WarbandRow) - cf. ChapterDividerStyle de DmTools. Pas de
         déclinaison IsExpanded ici (contrairement à DmTools) : une bande n'est jamais dépliable. -->
    <Style x:Key="ChapterDividerStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="VerticalOptions" Value="End"/>
        <Setter Property="Color" Value="Grey"/>
    </Style>

    <!-- Tuile de grille sélectionnable (Library : archétypes de bande/guerrier, objets) - reprise mot
         pour mot de SelectableGridItemBorderStyle chez DmTools (Resources/Styles/Styles.xaml). Ce
         style garde son VisualStateManager (Normal/Selected) tel quel ; c'est l'INSTANCE du Border
         dans chaque tuile qui neutralise ce VSM (VisualStateGroupList vide) et porte son propre
         Border.Triggers DataTrigger sur IsSelected - cf. EquipmentItemView/WarriorArchetypeView/
         WarbandArchetypeView.xaml et le commentaire sur la tuile elle-même pour la raison (VSM
         prioritaire sur Trigger en MAUI, sélection native Android non fiable). -->
    <Style x:Key="SelectableGridItemBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppSurfaceTranslucent}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 5"/>
        <Setter Property="HorizontalOptions" Value="{OnPlatform Default=Fill, WinUI=Center}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="Grey" />
                            <Setter Property="StrokeThickness" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="LightSkyBlue" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Secondary button (Cancel/No) for themed popups: outline instead of a solid accent fill -->
    <Style TargetType="Button" x:Key="DialogSecondaryButtonStyle">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource AppAccent}" />
        <Setter Property="BorderColor" Value="{DynamicResource AppAccent}" />
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{DynamicResource AppButtonPadding}"/>
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
    </Style>

    <!-- Option button (choice list) for ActionSheetDialog -->
    <Style TargetType="Button" x:Key="DialogOptionButtonStyle">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="BorderColor" Value="{DynamicResource AppBorder}" />
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{DynamicResource AppButtonPadding}"/>
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppText}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource AppBackground}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AppAccent}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{DynamicResource AppButtonPadding}"/>
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.7" />
                            <Setter Property="Scale" Value="0.97" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource AppAccent}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}"/>
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="Keyboard" Value="Text"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="Keyboard" Value="Text"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource AppTextMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="TextColor" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="TruncatedLabelStyle">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}" />
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
        <Setter Property="MaxLines" Value="1"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource AppTextMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Tuiles du Codex (8 onglets + WarriorArchetypeView/Selector, EquipmentListView) - nom enroulé sur
         3 lignes plutôt que tronqué à 1, contrairement à TruncatedLabelStyle (encore utilisé tel quel par
         WarbandListPage et MagicSchoolView - liste à plat, pas une grille de tuiles - hors périmètre ici). -->
    <Style TargetType="Label" x:Key="CodexTileNameLabelStyle" BasedOn="{StaticResource TruncatedLabelStyle}">
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="MaxLines" Value="3"/>
    </Style>

    <!-- Taille fixe et carrée du Grid racine de chaque tuile - un seul endroit à retoucher pour les 11
         usages plutôt que WidthRequest/HeightRequest dupliqués en dur dans chaque fichier. -->
    <Style TargetType="Grid" x:Key="CodexTileFrameStyle">
        <Setter Property="WidthRequest" Value="130"/>
        <Setter Property="HeightRequest" Value="130"/>
    </Style>

    <!-- Ligne d'info secondaire sous le nom (coût, rareté, jet de sort...) - Mutation/Animal/Spell
         l'utilisaient déjà en style ad hoc (AppTextMuted) ; formalisé ici en AppAccent pour mieux
         ressortir, et étendu à Equipment lors de ce même passage. -->
    <Style TargetType="Label" x:Key="CodexTileSecondaryLabelStyle">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="TextColor" Value="{DynamicResource AppAccent}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
    </Style>

    <!-- En-tête de groupe des grilles de tuiles Codex (ex. "Vitesse"/"Spécial" dans Compétences) -
         repris tel quel dans les 8 onglets catalogués. AppFontSizeBase plutôt que
         AppFontSizeSectionTitle (repris par erreur du titre de page, trop proche visuellement) et marge
         resserrée : le picker de section (LibraryPage) et le picker de catégorie au-dessus prenaient
         déjà pas mal de hauteur avant d'ajouter celle des group headers. Le DataTrigger IsFirst annule
         la marge haute pour le tout premier groupe (sinon il hérite en plus de l'espace du picker de
         catégorie juste au-dessus) - propriété portée par la classe XxxGroup, à ajouter au fur et à
         mesure que chaque onglet migre vers le groupement "maison" (voir SkillGroup.IsFirst). -->
    <Style TargetType="Label" x:Key="CodexGroupHeaderStyle">
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}"/>
        <Setter Property="TextColor" Value="{DynamicResource AppText}"/>
        <Setter Property="Margin" Value="4,20,4,2"/>
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsFirst}" Value="True">
                <Setter Property="Margin" Value="4,0,4,2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="TitleColor" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource AppAccent}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}"/>
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource AppTextMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource AppAccent}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
    </Style>

    <Style TargetType="SearchHandler">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}" />
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="15" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Brush" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
        <Setter Property="Offset" Value="10,10" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource AppAccent}" />
        <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
        <Setter Property="ThumbColor" Value="{DynamicResource AppAccent}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                            <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppSurface}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource AppAccentSecondary}" />
        <Setter Property="ThumbColor" Value="{StaticResource White}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{DynamicResource AppAccentSecondary}" />
                            <Setter Property="ThumbColor" Value="{DynamicResource AppAccent}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        </VisualState.Setters>
