<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               x:TypeArguments="system:String"
               x:Class="MordheimLedgerApp.Components.Dialogs.PromptDialog"
               x:DataType="dialogs:PromptDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0">
    <!-- Centré comme tous les dialogs (DialogPage) : la page se réduit à l'ouverture du clavier, le dialog
         reste centré dans la place restante. -->
    <Border Style="{StaticResource DialogCardBorderStyle}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
            <Label Grid.Row="0" Text="{Binding Title}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>
            <dialogs:AnimatedHeightScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding Message}"
                           IsVisible="{Binding HasMessage}"
                           TextColor="{DynamicResource AppTextMuted}"/>
                    <Entry x:Name="InputEntry" Text="{Binding Text}" Placeholder="{Binding Placeholder}"/>
                </VerticalStackLayout>
            </dialogs:AnimatedHeightScrollView>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{Binding CancelLabel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}"/>
            </Grid>
        </Grid>
    </Border>
</dialogs:DialogContent>
