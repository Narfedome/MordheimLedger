<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.HiredSwords"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:picker="clr-namespace:MordheimLedgerApp.Components.PickerSelectorLayout"
             x:Class="MordheimLedgerApp.Features.Library.HiredSwords.HiredSwordSelectorPage"
             Shell.NavBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <!-- Poussée nue (pas de NavigationPage, voir HiredSwordPickerService) - même raison/composant que
         MagicSchoolSelectorPage. -->
    <picker:PickerSelectorLayout Title="{loc:Loc LibTabHiredSwords}" BackCommand="{Binding CancelCommand}">
        <local:HiredSwordView IsCrud="False"/>
    </picker:PickerSelectorLayout>
</ContentPage>
