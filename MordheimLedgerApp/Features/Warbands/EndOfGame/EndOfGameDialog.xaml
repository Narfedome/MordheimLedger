<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.EndOfGameDialog"
               x:DataType="local:EndOfGameDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="380">
        <dialogs:StableHeightScrollView>
        <VerticalStackLayout Spacing="16">
            <Label Text="{loc:Loc EndOfGameTitle}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>
            <Label Text="{Binding StepLabel}" TextColor="{DynamicResource AppTextMuted}"/>

            <!-- Étape : Résultat (contexte pour la phrase d'Historique - pas une étape du livre) -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsResultStep}">
                <Picker Title="{loc:Loc EndOfGameResultPh}"
                        ItemsSource="{Binding ResultOptions}"
                        SelectedItem="{Binding SelectedResult}"/>
            </VerticalStackLayout>

            <!-- Étape : Hors de combat - vue d'ensemble, juste les cases à cocher, aucun outil de jet
                 ici (chaque guerrier coché reçoit sa propre étape Blessure juste après, une carte par
                 écran plutôt que toutes en même temps). -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsOutOfActionStep}">
                <Label Text="{loc:Loc EndOfGameOutOfAction}" FontAttributes="Bold"/>
                <Label Text="{loc:Loc EndOfGameOutOfActionHint}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <Border Style="{StaticResource SectionCardBorderStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                        <Label Text="{Binding RoleLabel}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                                    </VerticalStackLayout>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsOutOfAction}" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Étape : Blessure - une carte par guerrier coché hors de combat, un seul à la fois
                 (CurrentInjuryWarrior), pas une liste. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsInjuryStep}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc EndOfGameInjuriesHeading}" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="{Binding InjuryProgressLabel}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                </Grid>
                <Border Style="{StaticResource SectionCardBorderStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding CurrentInjuryWarrior.Name}" FontAttributes="Bold"/>
                            <!-- Héros et Hommes de main ont des tables de Blessures Graves totalement
                                 différentes (D66 vs D6) - toujours afficher le rôle pour lever
                                 l'ambiguïté. -->
                            <Label Grid.Column="1" Text="{Binding CurrentInjuryWarrior.RoleLabel}" TextColor="{DynamicResource AppTextMuted}"/>
                            <!-- Statut auto-géré : passe à Mort tout seul sur un résultat de mort (voir
                                 ApplyInjuryRoll), pas de saisie manuelle. -->
                            <Label Grid.Column="2" Text="{loc:Loc EndOfGameDeadLabel}"
                                   IsVisible="{Binding CurrentInjuryWarrior.IsDead}"
                                   TextColor="{DynamicResource AppDanger}" FontAttributes="Bold"/>
                        </Grid>
                        <!-- Le joueur peut soit laisser l'appli tirer les dés (Dice = jet aléatoire +
                             popup de résultat immédiate), soit lancer ses propres dés à la table et
                             saisir le score lui-même (Entry + Eye = affiche le résultat correspondant
                             sans en tirer un nouveau). -->
                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                            <Entry Grid.Column="0" Text="{Binding CurrentInjuryWarrior.ManualRoll}" Keyboard="Numeric"
                                   Placeholder="{Binding CurrentInjuryWarrior.RollPlaceholder}" WidthRequest="70"/>
                            <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}"
                                                          Command="{Binding AutoRollCommand}"
                                                          CommandParameter="{Binding CurrentInjuryWarrior}"
                                                          Tooltip="{loc:Loc EndOfGameRoll}"/>
                            <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Eye}"
                                                          Command="{Binding ShowInjuryResultCommand}"
                                                          CommandParameter="{Binding CurrentInjuryWarrior}"
                                                          Tooltip="{loc:Loc EndOfGameShowResult}"/>
                        </Grid>
                        <Label Text="{Binding CurrentInjuryWarrior.InjuryResultText}" FontSize="12"/>

                        <!-- Résultat "Blessures multiples" (16/21, Héros) : 1D6 pour savoir combien de
                             sous-jets faire sur cette même table, puis un jet D66 par sous-jet - chacun
                             avec ses propres outils Tirer/Voir le résultat. -->
                        <VerticalStackLayout IsVisible="{Binding CurrentInjuryWarrior.ShowMultipleInjuriesSection}" Spacing="6">
                            <Label Text="{loc:Loc EndOfGameMultipleInjuriesHeading}" FontSize="12"
                                   FontAttributes="Bold" TextColor="{DynamicResource AppTextMuted}"/>
                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                <Entry Grid.Column="0" Text="{Binding CurrentInjuryWarrior.MultipleInjuryCountRoll}" Keyboard="Numeric"
                                       Placeholder="{loc:Loc EndOfGameMultipleInjuryCountPh}" WidthRequest="70"/>
                                <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}"
                                                              Command="{Binding AutoRollMultipleInjuryCountCommand}"
                                                              CommandParameter="{Binding CurrentInjuryWarrior}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"/>
                                <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Eye}"
                                                              Command="{Binding ShowMultipleInjuryCountResultCommand}"
                                                              CommandParameter="{Binding CurrentInjuryWarrior}"
                                                              Tooltip="{loc:Loc EndOfGameShowResult}"/>
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentInjuryWarrior.MultipleInjuryRolls}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:InjurySubRollEntry">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Label}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                                <Entry Grid.Column="0" Text="{Binding ManualRoll}" Keyboard="Numeric"
                                                       Placeholder="{loc:Loc EndOfGameRollPh}" WidthRequest="70"/>
                                                <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}"
                                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=AutoRollSubInjuryCommand}"
                                                                              CommandParameter="{Binding .}"
                                                                              Tooltip="{loc:Loc EndOfGameRoll}"/>
                                                <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Eye}"
                                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=ShowSubInjuryResultCommand}"
                                                                              CommandParameter="{Binding .}"
                                                                              Tooltip="{loc:Loc EndOfGameShowResult}"/>
                                            </Grid>
                                            <Label Text="{Binding InjuryResultText}" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Étape : Expérience (livre - saisie libre, pas de calcul assisté). Pas de Statut ici :
                 entièrement auto-géré depuis l'étape Blessure. Le jet de progression (palier franchi)
                 est déplacé dans sa propre étape juste après, voir IsAdvanceStep - un guerrier peut
                 franchir plusieurs paliers d'un coup, ça ne tient plus sur une carte imbriquée ici. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExperienceStep}">
                <Label Text="{loc:Loc EndOfGameExperienceHeading}" FontAttributes="Bold"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <!-- Un guerrier mort (étape Blessure) ne gagne plus d'XP - retiré de cette
                                 étape plutôt que juste grisé. -->
                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    IsVisible="{Binding IsDead, Converter={StaticResource InverseBoolConverter}}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="{Binding RoleLabel}" TextColor="{DynamicResource AppTextMuted}"/>
                                    </Grid>
                                    <Entry Text="{Binding ExperienceGained}" Keyboard="Numeric"
                                           Placeholder="{loc:Loc EndOfGameXpPh}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Étape : Progression - seulement si au moins un guerrier a franchi un palier d'XP à
                 l'étape précédente (HasAnyMilestone, voir Steps dans le ViewModel : le wizard saute
                 carrément cette étape sinon). Un guerrier qui saute plusieurs paliers d'un coup a une
                 carte par palier (AdvanceRolls), chacune avec ses propres outils Tirer/Voir le
                 résultat - même principe que les Blessures Graves, purement descriptif. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAdvanceStep}">
                <Label Text="{loc:Loc EndOfGameAdvanceHeading}" FontAttributes="Bold"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <Border Style="{StaticResource SectionCardBorderStyle}" IsVisible="{Binding HasMilestone}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="{Binding RoleLabel}" TextColor="{DynamicResource AppTextMuted}"/>
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AdvanceRolls}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="local:AdvanceRollEntry">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding Label}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                                        <Entry Grid.Column="0" Text="{Binding ManualRoll}" Keyboard="Numeric"
                                                               Placeholder="{loc:Loc EndOfGameAdvanceRollPh}" WidthRequest="70"/>
                                                        <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}"
                                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=AutoRollAdvanceCommand}"
                                                                                      CommandParameter="{Binding .}"
                                                                                      Tooltip="{loc:Loc EndOfGameRoll}"/>
                                                        <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Eye}"
                                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=ShowAdvanceResultCommand}"
                                                                                      CommandParameter="{Binding .}"
                                                                                      Tooltip="{loc:Loc EndOfGameShowResult}"/>
                                                    </Grid>
                                                    <Label Text="{Binding ResultText}" FontSize="12"/>
                                                    <!-- Résultat "Compétence" (Héros 2-5/10-12 uniquement, voir
                                                         HeroAdvanceTable.IsSkill) : choix direct dans la Bibliothèque,
                                                         rattachée au guerrier à l'enregistrement du wizard. -->
                                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSkillResult}">
                                                        <Button Text="{loc:Loc EndOfGamePickSkill}"
                                                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                                                FontSize="12" Padding="8,4"
                                                                IsVisible="{Binding HasSkillSelected, Converter={StaticResource InverseBoolConverter}}"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=PickAdvanceSkillCommand}"
                                                                CommandParameter="{Binding .}"/>
                                                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SelectedSkills}"
                                                                    IsVisible="{Binding HasSkillSelected}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="library:Skill">
                                                                    <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,0">
                                                                        <Border.GestureRecognizers>
                                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=ShowSkillDetailCommand}"
                                                                                                   CommandParameter="{Binding .}"/>
                                                                        </Border.GestureRecognizers>
                                                                        <Label Text="{Binding Name}" FontSize="12"
                                                                               FontAttributes="Bold" TextColor="{DynamicResource AppAccent}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </FlexLayout>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Étape : Revenus (livre - trésor trouvé) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsTreasuryStep}">
                <Label Text="{loc:Loc EndOfGameTreasuryHeading}" FontAttributes="Bold"/>
                <Entry Text="{Binding TreasuryFound}" Keyboard="Numeric" Placeholder="{loc:Loc EndOfGameTreasuryPh}"/>
            </VerticalStackLayout>

            <!-- Étape : Récapitulatif (pas une étape du livre - relecture avant d'enregistrer) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRecapStep}">
                <Label Text="{loc:Loc EndOfGameRecapHeading}" FontAttributes="Bold"/>
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Loc EndOfGameResultPh}"/>
                            <Span Text=" : "/>
                            <Span Text="{Binding SelectedResult}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Loc EndOfGameTreasuryPh}"/>
                            <Span Text=" : "/>
                            <Span Text="{Binding TreasuryFound}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <Label Text="{Binding SummaryText}" FontSize="13"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc LibBack}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"/>
                <Button Grid.Column="2"
                        Text="{loc:Loc LibNext}"
                        Command="{Binding NextCommand}"
                        IsVisible="{Binding IsLastStep, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Grid.Column="2"
                        Text="{loc:Loc BtnSave}"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding IsLastStep}"/>
            </Grid>
        </VerticalStackLayout>
        </dialogs:StableHeightScrollView>
    </Border>
</dialogs:DialogContent>
