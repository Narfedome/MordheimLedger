<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>MordheimLedgerApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- MVVMTK0045: partial properties needed for strict WinRT/AOT targets, not a goal here -->
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Mordheim Ledger</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.cyrilbezard.mordheimledger</ApplicationId>

		<!-- Versions — patch auto-incremented via git at build time, major/minor set by hand -->
		<AppVersionMajor>0</AppVersionMajor>
		<AppVersionMinor>0</AppVersionMinor>
		<ApplicationDisplayVersion>$(AppVersionMajor).$(AppVersionMinor).0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
	  <ApplicationId>com.narfedome.mordheimledgerapp</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
	  <ApplicationId>com.narfedome.mordheimledgerapp</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-maccatalyst|AnyCPU'">
	  <ApplicationId>com.narfedome.mordheimledgerapp</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationId>com.narfedome.mordheimledgerapp</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
	  <ApplicationId>com.narfedome.mordheimledgerapp</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-ios|AnyCPU'">
	  <ApplicationId>com.narfedome.mordheimledgerapp</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-maccatalyst|AnyCPU'">
	  <ApplicationId>com.narfedome.mordheimledgerapp</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationId>com.narfedome.mordheimledgerapp</ApplicationId>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0D0B0A" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D0B0A" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Images\Warbands\Averland Mercenaries.jpg" />
	  <None Remove="Resources\Images\Warbands\Beastmen.jpg" />
	  <None Remove="Resources\Images\Warbands\Carnival of Chaos.jpg" />
	  <None Remove="Resources\Images\Warbands\Cult of the Possessed.jpg" />
	  <None Remove="Resources\Images\Warbands\Dwarf Treasure Hunters.jpg" />
	  <None Remove="Resources\Images\Warbands\Kislevites.jpg" />
	  <None Remove="Resources\Images\Warbands\Mercenaries.jpg" />
	  <None Remove="Resources\Images\Warbands\Middenheimers.jpg" />
	  <None Remove="Resources\Images\Warbands\Orc Mob.jpg" />
	  <None Remove="Resources\Images\Warbands\Ostlanders.jpg" />
	  <None Remove="Resources\Images\Warbands\Sisters of Sigmar.jpg" />
	  <None Remove="Resources\Images\Warbands\Skaven.jpg" />
	  <None Remove="Resources\Images\Warbands\Undead.jpg" />
	  <None Remove="Resources\Images\Warbands\Witch Hunters.jpg" />
	  <None Remove="Resources\WatermarkImages\gold.png" />
	  <None Remove="Resources\WatermarkImages\green.png" />
	</ItemGroup>

	<!-- LogicalName explicite requis : sans lui, le nom de ressource embarquée par défaut est préfixé du
	     namespace/chemin complet (MordheimLedgerApp.Resources.WatermarkImages.gold.png), pas juste
	     "gold.png" - ce que ThemeService.WatermarkImageSource passe à ImageSource.FromResource. Sans ce
	     LogicalName, la résolution échoue silencieusement (aucune erreur, le filigrane ne s'affiche
	     simplement jamais). -->
	<ItemGroup>
	  <EmbeddedResource Include="Resources\WatermarkImages\gold.png">
	    <LogicalName>gold.png</LogicalName>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Resources\WatermarkImages\green.png">
	    <LogicalName>green.png</LogicalName>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <MauiFont Update="Resources\Fonts\Font Awesome 7 Brands-Regular-400.otf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </MauiFont>
	  <MauiFont Update="Resources\Fonts\Font Awesome 7 Free-Regular-400.otf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </MauiFont>
	  <MauiFont Update="Resources\Fonts\Font Awesome 7 Free-Solid-900.otf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </MauiFont>
	  <MauiFont Update="Resources\Fonts\rpgawesome-webfont.ttf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </MauiFont>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Components\FaIconButton\FaIconButtonView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Warbands\CreateEdit\WarbandEditDialog.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
		<PackageReference Include="CommunityToolkit.Maui.Core" Version="15.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Strings\AppStrings.resx" />
	  <EmbeddedResource Update="Strings\AppStrings.en.resx">
	    <Culture>en</Culture>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\MordheimLedgerApp.Core\MordheimLedgerApp.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Resources\Images\icon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<!-- Auto-increments the patch version from the git commit count, same mechanism as DmTools
	     (see MordheimLedgerApp.Core sibling project's notes): the app reads its version at runtime
	     via AppInfo.Current.VersionString, which reflects exactly what got packaged. -->
	<Target Name="SetVersionFromGit" BeforeTargets="CoreCompile;_GenerateJavaStubs;GetAssemblyVersion;_GetAndroidPackageName;MauiGeneratePackageAppxManifest;GetAssemblyAttributes">
		<Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCount" />
		</Exec>
		<PropertyGroup Condition="'$(_GitCommitCount)' != ''">
			<_AppPatch>$(_GitCommitCount.Trim())</_AppPatch>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_AppPatch)' == ''">
			<_AppPatch>0</_AppPatch>
		</PropertyGroup>
		<PropertyGroup>
			<ApplicationDisplayVersion>$(AppVersionMajor).$(AppVersionMinor).$(_AppPatch)</ApplicationDisplayVersion>
		</PropertyGroup>
		<Message Text="Version: $(ApplicationDisplayVersion)" Importance="high" />

		<ItemGroup Condition="Exists('$(_AndroidStampDirectory)_GenerateJavaStubs.stamp')">
			<_StampToDelete Include="$(_AndroidStampDirectory)_GenerateJavaStubs.stamp" />
		</ItemGroup>
		<ItemGroup Condition="Exists('$(IntermediateOutputPath)mauimanifest.stamp')">
			<_StampToDelete Include="$(IntermediateOutputPath)mauimanifest.stamp" />
		</ItemGroup>
		<Delete Files="@(_StampToDelete)" Condition="'@(_StampToDelete)' != ''" />
	</Target>

	<!-- Régénère l'asset de base pré-seedée (Resources\Raw\seed.db3, copié tel quel au premier lancement
	     plutôt que rejoué à froid - voir MauiProgram.EnsureDatabaseFileExists) dès qu'un JSON de
	     Data\SeedData a changé depuis la dernière génération - voir Tools\DbSeedGenerator, qui réutilise
	     AppDatabase telle quelle (aucune logique de seed dupliquée). Inputs/Outputs : ne relance le
	     générateur (un `dotnet run` séparé, potentiellement plusieurs secondes) que si nécessaire, pas à
	     chaque build. Ne surveille que les JSON, pas le code de seed C# (AppDatabase.cs etc.) - si ce
	     dernier change sans qu'un JSON change aussi, supprimer seed.db3 à la main pour forcer la
	     régénération. -->
	<ItemGroup>
		<CoreSeedJsonFiles Include="..\MordheimLedgerApp.Core\Data\SeedData\*.json" />
	</ItemGroup>
	<ItemGroup>
	  <MauiImage Include="Resources\Images\Warbands\Averland Mercenaries.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Beastmen.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Carnival of Chaos.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Cult of the Possessed.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Dwarf Treasure Hunters.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Kislevites.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Mercenaries.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Middenheimers.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Orc Mob.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Ostlanders.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Sisters of Sigmar.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Skaven.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Undead.jpg" />
	  <MauiImage Include="Resources\Images\Warbands\Witch Hunters.jpg" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Features\Warbands\CreateEdit\WarbandEditDialog.xaml.cs">
	    <DependentUpon>WarbandEditDialog.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<Target Name="GenerateSeedDatabase" BeforeTargets="BeforeBuild" Inputs="@(CoreSeedJsonFiles)" Outputs="$(MSBuildProjectDirectory)\Resources\Raw\seed.db3">
		<Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\Tools\DbSeedGenerator\DbSeedGenerator.csproj&quot; -- &quot;$(MSBuildProjectDirectory)\Resources\Raw\seed.db3&quot;" />
	</Target>

</Project>
