<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.EquipmentLists"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:header="clr-namespace:MordheimLedgerApp.Components.DetailPageHeader"
             x:Class="MordheimLedgerApp.Features.Library.EquipmentLists.EquipmentListListPage"
             x:DataType="local:EquipmentListViewModel"
             Shell.NavBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <components:WatermarkedLayout>
        <Grid RowDefinitions="Auto,*">
            <header:DetailPageHeaderView Grid.Row="0" Title="{Binding WarbandArchetypeName}" BackCommand="{Binding BackCommand}"/>
            <local:EquipmentListView Grid.Row="1"/>
        </Grid>
    </components:WatermarkedLayout>
</ContentPage>
