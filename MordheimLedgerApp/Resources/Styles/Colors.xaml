<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Semantic palette tokens — overwritten at runtime by ThemeService.Apply -->
    <Color x:Key="AppBackground">#17151A</Color>
    <Color x:Key="AppSurface">#241F26</Color>
    <Color x:Key="AppSurfaceTranslucent">#D9241F26</Color>
    <Color x:Key="AppAccent">#7FA34F</Color>
    <Color x:Key="AppAccentSecondary">#5C6B73</Color>
    <Color x:Key="AppText">#E8E4D8</Color>
    <Color x:Key="AppTextMuted">#948C7E</Color>
    <Color x:Key="AppBorder">#35303A</Color>
    <Color x:Key="AppDanger">#8B3A3A</Color>
    <!-- Fixed (not palette-dependent), like AppDanger — a stat that's dropped since recruitment
         (StatRowView) needs to read as "down" regardless of theme/palette, same reasoning as
         AppDanger itself for the Malade/Mort chips it's shared with. -->
    <Color x:Key="AppSuccess">#3F9142</Color>
    <!-- Fixed (not palette-dependent), like AppDanger — milestone boxes on an ExperienceTrackView
         (see WarbandDetailPage roster) need to read as "highlighted" regardless of theme. -->
    <Color x:Key="AppMilestone">#C9A227</Color>

    <!-- Static neutrals -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
