<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:models="clr-namespace:MordheimLedgerApp.Core.Models;assembly=MordheimLedgerApp.Core"
             x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.Steps.RecruitVeteranTopUpStepView"
             x:DataType="local:EndOfGamePageViewModel">
            <!-- Étape : Recrutement des vétérans - groupes d'Hommes de main déjà existants (budget
                 vétérans, équipement TOUJOURS AUTOMATIQUE, livre des règles) - absente s'il n'y en a
                 aucun (HasExistingHenchmanGroups gate déjà l'étape elle-même). -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc EndOfGameRecruitVeteranTopUpHeading}" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="{Binding RecruitmentTreasuryDisplay}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                </Grid>
                <Label Text="{Binding RecruitmentRosterCountDisplay}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Label Text="{Binding RecruitHenchmenExistingHintDisplay}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                <Label Text="{loc:Loc EndOfGameTreasuryBlockedMessage}" TextColor="{StaticResource AppDanger}" FontSize="12"
                       IsVisible="{Binding IsTreasuryBlocked}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExistingHenchmanTopUps}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ExistingHenchmanTopUp">
                            <Border Style="{StaticResource SectionCardBorderStyle}" Padding="10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <components:ChipView Grid.Column="0" Item="{Binding Row}" NameOverride="{Binding Name}"
                                                              IconGlyph="{x:Static icons:RpgFont.RaKnightHelmet}"
                                                              IconFontFamily="RpgAwesome"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=ShowWarriorRecapCommand}"/>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                            <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                          Icon="{x:Static icons:SolidFont.Minus}"
                                                                          IconSize="11" ButtonWidthRequest="26" ButtonHeightRequest="26"
                                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=DecrementHenchmanTopUpCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                            <Label Text="{Binding CountDisplay}" FontSize="12" WidthRequest="38"
                                                   HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                            <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                          Icon="{x:Static icons:SolidFont.Plus}"
                                                                          IconSize="11" ButtonWidthRequest="26" ButtonHeightRequest="26"
                                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=IncrementHenchmanTopUpCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CurrentEquipment}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:WarriorEquipment">
                                                <components:ChipView Item="{Binding .}"
                                                                      IconGlyph="{Binding Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                                      IconFontFamily="RpgAwesome"
                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=ShowInjuryEquipmentDetailCommand}"/>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                    <VerticalStackLayout Spacing="2" IsVisible="{Binding HasAddCount}">
                                        <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" Margin="0,2"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{loc:Loc EndOfGameRecruitHenchmenRecruitmentCostLabel}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                            <Label Grid.Column="1" Text="{Binding Breakdown.RecruitmentCost}" FontSize="11"/>
                                        </Grid>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Breakdown.EquipmentLines}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="local:HenchmanEquipmentCostLine">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label Grid.Column="0" Text="{Binding Name}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                                        <Label Grid.Column="1" Text="{Binding Cost}" FontSize="11"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{loc:Loc EndOfGameRecruitHenchmenSurchargeLabel}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                            <Label Grid.Column="1" Text="{Binding Breakdown.SurchargeCost}" FontSize="11"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{loc:Loc EndOfGameRecruitHenchmenTotalLabel}" FontSize="12" FontAttributes="Bold"/>
                                            <Label Grid.Column="1" Text="{Binding Breakdown.Total}" FontSize="12" FontAttributes="Bold"/>
                                        </Grid>
                                        <Label Text="{Binding StashItemsUsedDisplay}" FontSize="11" TextColor="{DynamicResource AppAccent}"
                                               IsVisible="{Binding Breakdown.HasStashSavings}"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

</ContentView>
