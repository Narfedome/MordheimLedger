<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Features.Library.WarbandArchetypes.WarbandArchetypeView"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.WarbandArchetypes"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Name="root">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Filtre par Grade (Core/1a/1b/1c/2a, classification mordheimer.net) - même en-tête que
             SpellView (bouton texte = filtre courant, ouvre l'ActionSheet). Pas d'icône "gérer" ici,
             contrairement aux Sorts/Écoles de magie : le Grade est un champ direct de WarbandArchetype,
             pas un sous-catalogue séparé. -->
        <Grid Grid.Row="0" Margin="8,0,8,8" VerticalOptions="Center">
            <Button Text="{Binding SelectedGradeFilter}"
                    Command="{Binding SelectGradeFilterCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource AppAccent}"
                    FontSize="{OnIdiom Default=15, Desktop=13}"
                    HorizontalOptions="Start"
                    Padding="8,4"/>
        </Grid>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="120" HeightRequest="120"/>

        <CollectionView Grid.Row="1" x:Name="ItemsCollection"
                ItemsSource="{Binding WarbandArchetypeGroups}"
                IsGrouped="True"
                SelectionMode="None"
                ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.Behaviors>
                <components:ResponsiveGridSpanBehavior TileWidth="140"/>
            </CollectionView.Behaviors>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="5" HorizontalItemSpacing="5" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}"
                           IsVisible="{Binding Source={x:Reference root}, Path=BindingContext.ShowGroupHeaders}"
                           FontAttributes="Bold"
                           FontSize="{DynamicResource AppFontSizeSectionTitle}"
                           TextColor="{DynamicResource AppText}"
                           Margin="4,12,4,4"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:WarbandArchetypeRow">
                    <!-- Sélection gérée à la main (IsSelected, pas SelectionMode) - reprise mot pour mot
                         de LibraryTrackView chez DmTools (commit 09c71545a) : BackgroundColor/Stroke
                         posés en dur sur l'instance (plus besoin du fond translucide, la sélection
                         native n'est plus utilisée du tout ici), VisualStateGroupList vide pour
                         neutraliser le VSM du style partagé (prioritaire sur un Trigger en MAUI, ce qui
                         empêchait tout affichage du liseré), Border.Triggers (pas Style.Triggers) pour
                         le DataTrigger sur IsSelected. -->
                    <Border Style="{StaticResource SelectableGridItemBorderStyle}" BackgroundColor="Transparent" Stroke="Grey">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList/>
                        </VisualStateManager.VisualStateGroups>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="LightSkyBlue"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference root}, Path=BindingContext.SelectCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Grid WidthRequest="120" HeightRequest="120">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <components:LibraryItemImageView
                                Grid.Row="0"
                                ImagePath="{Binding Item.ImagePath}"
                                DefaultGlyph="{x:Static icons:SolidFont.Shield}"
                                Padding="20" />
                            <Label Text="{Binding Item.Name}"
                                   Grid.Row="1"
                                   Style="{StaticResource TruncatedLabelStyle}"
                                   HorizontalOptions="Center"
                                   Margin="5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center" Margin="0,8"
                               IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                         Command="{Binding CreateCommand}"
                                         Tooltip="{loc:Loc BtnAdd}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                         Command="{Binding EditCommand}"
                                         Tooltip="{loc:Loc BtnRename}"
                                         IsEnabled="{Binding SelectedRow, Converter={StaticResource IsNotNullConverter}}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                         Command="{Binding DeleteCommand}"
                                         Tooltip="{loc:Loc BtnDelete}"
                                         IsEnabled="{Binding SelectedRow, Converter={StaticResource IsNotNullConverter}}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.UserShield}"
                                         Command="{Binding ManageWarriorsCommand}"
                                         Tooltip="{loc:Loc LibManageWarriors}"
                                         IsEnabled="{Binding SelectedRow, Converter={StaticResource IsNotNullConverter}}"/>
        </HorizontalStackLayout>

        <!-- Multi-sélection : un tap bascule le liseré bleu (IsSelected) de la tuile, Confirmer ajoute
             toutes les tuiles cochées d'un coup - même pattern que SpecialRuleView. -->
        <HorizontalStackLayout Grid.Row="2" Spacing="20" HorizontalOptions="Center" Margin="0,8"
                               IsVisible="{Binding Source={x:Reference root}, Path=IsCrud, Converter={StaticResource InverseBoolConverter}}">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CircleCheck}"
                                         Command="{Binding ConfirmSelectionCommand}"
                                         Tooltip="{loc:Loc LibConfirm}"
                                         IsEnabled="{Binding HasSelectedRows}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CircleXmark}"
                                         Command="{Binding CancelCommand}"
                                         Tooltip="{loc:Loc LibCancel}"/>
        </HorizontalStackLayout>

    </Grid>
</ContentView>
