<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.EquipmentItems.CreateEdit"
               xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.EquipmentItems.CreateEdit.EquipmentItemEditDialog"
               x:DataType="local:EquipmentItemEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <Grid RowDefinitions="*,Auto" RowSpacing="16">
        <ScrollView Grid.Row="0" x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>

            <HorizontalStackLayout Spacing="16">
                <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabGeneral}" Command="{Binding ShowGeneralTabCommand}"
                                             IsActive="{Binding IsGeneralTab}" FontSize="12"/>
                <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabRules}" Command="{Binding ShowRulesTabCommand}"
                                             IsActive="{Binding IsRulesTab}" FontSize="12"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGeneralTab}">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="12" TextColor="{DynamicResource AppTextMuted}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc EquipmentItemNamePh}"/>
                                <Span Text=" *" TextColor="{StaticResource AppDanger}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry Text="{Binding Item.Name}"/>
                    <Label Text="{Binding NameError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                           IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}"/>
                </VerticalStackLayout>
                <Picker Title="{loc:Loc EquipmentItemCategoryPh}"
                        ItemsSource="{Binding CategoryOptions}"
                        SelectedItem="{Binding SelectedCategoryLabel}"/>
                <Entry Text="{Binding Item.Cost}" Keyboard="Numeric" Placeholder="{loc:Loc EquipmentItemCostPh}"/>
                <Entry Text="{Binding Item.Rarity}" Keyboard="Numeric" Placeholder="{loc:Loc EquipmentItemRarityPh}"/>
                <Entry Text="{Binding Item.CostRandomMax}" Keyboard="Numeric" Placeholder="{loc:Loc EquipmentItemCostRandomMaxPh}"/>
                <Editor Text="{Binding Item.Description}" Placeholder="{loc:Loc LibDescriptionPh}" HeightRequest="100"/>

                <!-- Réservé à ces bandes : vide = commun à toutes les bandes (voir EquipmentItem.
                     RestrictedToWarbandArchetypeIds). HeaderText dynamique plutôt qu'un titre fixe + un
                     indice affichés en même temps liste vide - même principe que MutationEditDialog. -->
                <components:ChipListView HeaderText="{Binding RestrictedWarbandsHeaderText}"
                                          ItemsSource="{Binding RestrictedWarbands}"
                                          IconGlyph="{x:Static icons:SolidFont.Shield}"
                                          AddCommand="{Binding AddRestrictionCommand}"
                                          RemoveCommand="{Binding RemoveRestrictionCommand}"/>
            </VerticalStackLayout>

            <!-- Règles spéciales propres à l'objet (ex. "Parry", "Cutting Edge"). -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsRulesTab}">
                <components:ChipListView HeaderText="{loc:Loc LibSpecialRulesPh}"
                                          ItemsSource="{Binding SpecialRules}"
                                          IconGlyph="{x:Static icons:SolidFont.Scroll}"
                                          AddCommand="{Binding AddSpecialRuleCommand}"
                                          RemoveCommand="{Binding RemoveSpecialRuleCommand}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="{loc:Loc BtnCancel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="1"
                    Text="{loc:Loc BtnSave}"
                    Command="{Binding SaveCommand}"/>
        </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
