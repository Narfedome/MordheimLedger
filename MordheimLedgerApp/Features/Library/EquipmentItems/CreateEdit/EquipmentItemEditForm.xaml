<?xml version="1.0" encoding="utf-8" ?>
<form:FormContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:form="clr-namespace:MordheimLedgerApp.Components.FormPage"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.EquipmentItems.CreateEdit"
               xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.EquipmentItems.CreateEdit.EquipmentItemEditForm"
               x:DataType="local:EquipmentItemEditDialogViewModel">
    <!-- Page plein écran (autrefois EquipmentItemEditDialog, voir Components/FormPage) : titre et
         ✕ dans l'en-tête, Annuler / Enregistrer dans le pied, contenu en carte. -->
    <form:FormPageLayout Title="{Binding Title}"
                         CloseCommand="{Binding CancelCommand}"
                         SecondaryText="{loc:Loc BtnCancel}"
                         SecondaryCommand="{Binding CancelCommand}"
                         PrimaryText="{loc:Loc BtnSave}"
                         PrimaryCommand="{Binding SaveCommand}">
        <Border Style="{StaticResource SectionCardBorderStyle}">
            <VerticalStackLayout Spacing="16">

                <components:ScrollableTabStripView>
                    <HorizontalStackLayout Spacing="16">
                        <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabGeneral}" Command="{Binding ShowGeneralTabCommand}"
                                                     IsActive="{Binding IsGeneralTab}" FontSize="12"/>
                        <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabRules}" Command="{Binding ShowRulesTabCommand}"
                                                     IsActive="{Binding IsRulesTab}" FontSize="12"/>
                    </HorizontalStackLayout>
                </components:ScrollableTabStripView>

                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGeneralTab}">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="12" TextColor="{DynamicResource AppTextMuted}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{loc:Loc EquipmentItemNamePh}"/>
                                    <Span Text=" *" TextColor="{StaticResource AppDanger}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Entry Text="{Binding Item.Name}"/>
                        <Label Text="{Binding NameError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                               IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Loc EquipmentItemCategoryPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <components:SelectFieldView Title="{loc:Loc EquipmentItemCategoryPh}" ItemsSource="{Binding CategoryOptions}"
                                SelectedItem="{Binding SelectedCategoryLabel}"/>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{loc:Loc EquipmentItemCostPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                            <Entry Text="{Binding Item.Cost}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{loc:Loc EquipmentItemRarityPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                            <Entry Text="{Binding Item.Rarity}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Loc EquipmentItemCostRandomMaxPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Entry Text="{Binding Item.CostRandomMax}" Keyboard="Numeric"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Loc LibDescriptionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Editor Text="{Binding Item.Description}" HeightRequest="100"/>
                    </VerticalStackLayout>

                    <!-- Profil (Mouvement/CC/CT/F/E/PV/I/A/Cd) - uniquement pour la catégorie Animal (une
                         monture, ex. Cheval de guerre) : ces 9 champs n'ont pas de sens pour les autres
                         catégories. Même composant StatRowView que WarriorArchetypeEditDialog. -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsAnimalCategory}">
                        <Label Text="{loc:Loc LibTabProfile}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <components:StatRowView Item="{Binding Item}" MovementText="{Binding Item.Movement}" IsEditable="True"/>
                    </VerticalStackLayout>

                    <!-- Réservé à ces bandes : vide = commun à toutes les bandes (voir EquipmentItem.
                         RestrictedToWarbandArchetypeIds). Contrôle unique factorisant chips + bascule
                         Inclure/Exclure (ex. Chien de guerre "toutes sauf Skavens"). -->
                    <components:WarbandRestrictionEditorView Editor="{Binding WarbandRestriction}"/>

                </VerticalStackLayout>

                <!-- Règles spéciales propres à l'objet (ex. "Parry", "Cutting Edge"). -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsRulesTab}">
                    <components:ChipListView HeaderText="{loc:Loc LibSpecialRulesPh}"
                                              ItemsSource="{Binding SpecialRules}"
                                              IconGlyph="{x:Static icons:SolidFont.Scroll}"
                                              AddCommand="{Binding AddSpecialRuleCommand}"
                                              RemoveCommand="{Binding RemoveSpecialRuleCommand}"/>

                    <!-- Objets à usage unique (drogues, poisons, Ail...) - maquette « Codex : effets modifiables ». L'appli propose,
                         le joueur décide : les messages ambre (tranches qui se chevauchent, hors des dés) ne bloquent jamais. -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Loc SingleUsePh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <components:SelectFieldView Title="{loc:Loc SingleUsePh}" ItemsSource="{Binding SingleUseOptions}"
                                SelectedItem="{Binding SelectedSingleUseLabel}"/>
                        <Label Text="{loc:Loc SingleUseHint}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsSingleUse}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Loc SingleUseTargetPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                            <components:SelectFieldView Title="{loc:Loc SingleUseTargetPh}" ItemsSource="{Binding TargetOptions}"
                                    SelectedItem="{Binding SelectedTargetLabel}"/>
                            <Label Text="{Binding TargetHint}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        </VerticalStackLayout>

                        <!-- Bonus pour la partie : caractéristique, valeur fixe, dé lancé au début de partie. -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:Loc SingleUseBonusesHeading}" FontAttributes="Bold" FontSize="14"/>
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Bonuses}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:StatModifierEditRow">
                                        <Grid ColumnDefinitions="*,64,84,Auto" ColumnSpacing="6">
                                            <components:SelectFieldView Grid.Column="0" Title="{loc:Loc SingleUseStatPh}" ItemsSource="{Binding StatOptions}"
                                                    SelectedItem="{Binding SelectedStat}"/>
                                            <Entry Grid.Column="1" Text="{Binding Value}" Keyboard="Telephone" HorizontalTextAlignment="Center"
                                                   SemanticProperties.Description="{loc:Loc SingleUseFixedValuePh}"/>
                                            <components:SelectFieldView Grid.Column="2" Title="{loc:Loc SingleUseDiePh}" ItemsSource="{Binding DieOptions}"
                                                    SelectedItem="{Binding SelectedDie}"/>
                                            <components:FaIconButtonView Grid.Column="3" Icon="{x:Static icons:SolidFont.Xmark}"
                                                                          Style="{StaticResource GhostIconButtonStyle}" VerticalOptions="Center"
                                                                          AccessibleName="{Binding RemoveLabel}"
                                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type local:EquipmentItemEditDialogViewModel}}, Path=RemoveBonusCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Button Text="{loc:Loc SingleUseAddBonus}" HorizontalOptions="Start" Command="{Binding AddBonusCommand}"/>
                            <Label Text="{Binding BonusPreview}" FontSize="12" TextColor="{DynamicResource AppGameModifier}"/>
                        </VerticalStackLayout>

                        <!-- Jet après la bataille : dés, puis lignes « De – À → effet ». -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:Loc SingleUseAfterBattleTableHeading}" FontAttributes="Bold" FontSize="14"/>
                            <Grid ColumnDefinitions="64,Auto,96" ColumnSpacing="6">
                                <Entry Grid.Column="0" Text="{Binding AfterBattleDiceCount}" Keyboard="Numeric" HorizontalTextAlignment="Center"
                                       SemanticProperties.Description="{loc:Loc SingleUseDiceCountPh}"/>
                                <Label Grid.Column="1" Text="×" VerticalOptions="Center"/>
                                <components:SelectFieldView Grid.Column="2" Title="{loc:Loc SingleUseDiePh}" ItemsSource="{Binding AfterBattleDiceOptions}"
                                        SelectedItem="{Binding SelectedAfterBattleDie}"/>
                            </Grid>
                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding AfterBattleRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:AfterBattleEditRow">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="52,Auto,52,*,Auto" ColumnSpacing="6">
                                                <Entry Grid.Column="0" Text="{Binding Min}" Keyboard="Numeric" HorizontalTextAlignment="Center"
                                                       SemanticProperties.Description="{loc:Loc SingleUseFromPh}"/>
                                                <Label Grid.Column="1" Text="–" VerticalOptions="Center"/>
                                                <Entry Grid.Column="2" Text="{Binding Max}" Keyboard="Numeric" HorizontalTextAlignment="Center"
                                                       SemanticProperties.Description="{loc:Loc SingleUseToPh}"/>
                                                <components:SelectFieldView Grid.Column="3" Title="{loc:Loc SingleUseEffectPh}" ItemsSource="{Binding KindOptions}"
                                                        SelectedItem="{Binding SelectedKind}"/>
                                                <components:FaIconButtonView Grid.Column="4" Icon="{x:Static icons:SolidFont.Xmark}"
                                                                              Style="{StaticResource GhostIconButtonStyle}" VerticalOptions="Center"
                                                                              AccessibleName="{Binding RemoveLabel}"
                                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type local:EquipmentItemEditDialogViewModel}}, Path=RemoveAfterBattleRowCommand}"
                                                                              CommandParameter="{Binding .}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,72" ColumnSpacing="6" IsVisible="{Binding IsCharacteristic}">
                                                <components:SelectFieldView Grid.Column="0" Title="{loc:Loc SingleUseStatPh}" ItemsSource="{Binding StatOptions}"
                                                        SelectedItem="{Binding SelectedStat}"/>
                                                <Entry Grid.Column="1" Text="{Binding Delta}" Keyboard="Telephone" HorizontalTextAlignment="Center"
                                                       SemanticProperties.Description="{loc:Loc SingleUseDeltaPh}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding IsRule}">
                                                <Label Grid.Column="0" Text="{Binding RuleName}" VerticalOptions="Center"/>
                                                <Button Grid.Column="1" Text="{loc:Loc SingleUseChangeRule}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:EquipmentItemEditDialogViewModel}}, Path=ChangeAfterBattleRuleCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Button Text="{loc:Loc SingleUseAddRow}" HorizontalOptions="Start" Command="{Binding AddAfterBattleRowCommand}"/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasTableWarning}">
                                <Label Grid.Column="0" Text="{x:Static icons:SolidFont.TriangleExclamation}" FontFamily="FontSolid" FontSize="12"
                                       TextColor="{DynamicResource AppWarning}" VerticalOptions="Start" Margin="0,2,0,0"/>
                                <Label Grid.Column="1" Text="{Binding TableWarning}" FontSize="12" TextColor="{DynamicResource AppWarning}"/>
                            </Grid>
                            <Label Text="{loc:Loc SingleUseTableHint}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Perdu si le porteur est mis hors de combat (Habits de soie : 1-3, chef) - indépendant de l'usage unique. -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding HasLoss}" VerticalOptions="Center"
                                      SemanticProperties.Description="{loc:Loc SingleUseLossPh}"/>
                            <Label Grid.Column="1" Text="{loc:Loc SingleUseLossPh}" VerticalOptions="Center"/>
                        </Grid>
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding HasLoss}">
                            <Grid ColumnDefinitions="Auto,64" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{loc:Loc SingleUseLossUpToPh}" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" Text="{Binding LossUpTo}" Keyboard="Numeric" HorizontalTextAlignment="Center"
                                       SemanticProperties.Description="{loc:Loc SingleUseLossUpToPh}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <CheckBox Grid.Column="0" IsChecked="{Binding LossLeaderOnly}" VerticalOptions="Center"
                                          SemanticProperties.Description="{loc:Loc SingleUseLossLeaderOnlyPh}"/>
                                <Label Grid.Column="1" Text="{loc:Loc SingleUseLossLeaderOnlyPh}" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <components:ChipListView HeaderText="{loc:Loc NoEffectOnRacesPh}"
                                              ItemsSource="{Binding NoEffectOnRaces}"
                                              IconGlyph="{x:Static icons:SolidFont.Ban}"
                                              AlwaysShowSection="True"
                                              EmptyHintText="{loc:Loc NoEffectOnRacesEmpty}"
                                              AddCommand="{Binding AddNoEffectRaceCommand}"
                                              RemoveCommand="{Binding RemoveNoEffectRaceCommand}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </form:FormPageLayout>
</form:FormContent>
