<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Components.CodexGroupedGridView"
             x:Name="root">

    <!-- Groupement "maison" (header Label + FlexLayout Wrap de tuiles) partagé par les 8 onglets Codex,
         au lieu de CollectionView IsGrouped/GroupHeaderTemplate : sur Windows/WinUI, le conteneur natif
         du group header a un padding/chrome non contrôlable depuis le Label qu'on y place (essayé via
         Margin/HeightRequest, sans effet - voir CLAUDE.md). ItemsSource attend une liste de groupes
         implémentant ICodexGroup, chaque groupe étant lui-même une IEnumerable de ses lignes (cf.
         SkillGroup : ObservableCollection<SkillRow>, ICodexGroup) - le ViewModel ne change pas.
         ItemTemplate est le template d'UNE tuile (fourni par la page appelante, différent par onglet :
         icône par défaut, ligne secondaire éventuelle...) ; le binding interne au template reste défini
         dans le fichier de la page appelante, donc x:Reference root à l'intérieur pointe toujours vers
         le root de CETTE page, pas celui de ce contrôle.

         ScrollView + VerticalStackLayout/BindableLayout plutôt que CollectionView : CollectionView.
         Scrolled ne se déclenche pas de façon fiable sur WinUI (confirmé - la liste défile bien, mais
         l'event handler n'est jamais atteint, y compris en debug), alors que ScrollView.Scrolled est
         une API bien plus ancienne/éprouvée sur toutes les plateformes MAUI. Contrepartie : plus de
         virtualisation des GROUPES non plus (déjà perdue pour les tuiles avec le passage au FlexLayout)
         - sans impact vu les volumes actuels. -->
    <Grid>
        <ScrollView x:Name="InnerScroll" Scrolled="OnScrolled">
            <VerticalStackLayout x:Name="GroupsStack"
                    BindableLayout.ItemsSource="{Binding Source={x:Reference root}, Path=ItemsSource}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}"
                                   IsVisible="{Binding Source={x:Reference root}, Path=ShowGroupHeaders}"
                                   Style="{StaticResource CodexGroupHeaderStyle}"/>
                            <FlexLayout Wrap="Wrap" JustifyContent="Start"
                                        BindableLayout.ItemsSource="{Binding .}"
                                        BindableLayout.ItemTemplate="{Binding Source={x:Reference root}, Path=ItemTemplate}"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- En-tête épinglé : reprend le comportement "sticky" du GroupHeaderTemplate natif abandonné -
             mis à jour sur ScrollView.Scrolled en comparant ScrollY à la position Y de chaque groupe
             réel dans GroupsStack.Children (pas de cache : recalculé à chaque scroll, coût négligeable
             vu le nombre de groupes). Toujours visible dès qu'il y a des groupes (y compris ScrollY=0) -
             masqué seulement en dessous d'un seuil, ça faisait "sauter" le bandeau à l'apparition
             (signalé par l'utilisateur) ; en restant permanent il coïncide avec le header inline du
             groupe en haut plutôt que de le dupliquer. Padding top=0 pour s'aligner sur la marge du
             header inline du 1er groupe (IsFirst, cf. CodexGroupHeaderStyle) au repos.
             StrokeShape="Rectangle" explicite : le style implicite TargetType="Border" (Styles.xaml)
             pose RoundRectangle 15 - même avec StrokeThickness=0 la découpe du BackgroundColor suit
             cette forme, donnant un bandeau à coins arrondis au lieu d'une bande pleine largeur. Label
             sans CodexGroupHeaderStyle : sa marge (espacement ENTRE groupes dans le flux normal, dont le
             DataTrigger IsFirst) n'a pas de sens ici, juste un Padding propre au bandeau. -->
        <Border x:Name="PinnedHeaderBorder" IsVisible="False" InputTransparent="True"
                BackgroundColor="{DynamicResource AppBackground}" Stroke="Transparent" StrokeThickness="0"
                StrokeShape="Rectangle" Padding="4,0,4,4"
                VerticalOptions="Start" HorizontalOptions="Fill">
            <Label x:Name="PinnedHeaderLabel"
                   FontAttributes="Bold"
                   FontSize="{DynamicResource AppFontSizeBase}"
                   TextColor="{DynamicResource AppText}"/>
        </Border>
    </Grid>
</ContentView>
