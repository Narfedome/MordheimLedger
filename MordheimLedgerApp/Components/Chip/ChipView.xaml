<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Class="MordheimLedgerApp.Components.ChipView"
             x:Name="root">

    <Border Style="{StaticResource ChipBorderStyle}" Margin="0,0,4,4" HorizontalOptions="Start">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Command, Source={x:Reference root}}"
                CommandParameter="{Binding Item, Source={x:Reference root}}"/>
        </Border.GestureRecognizers>
        <Grid x:Name="ChipGrid" BindingContext="{Binding Item, Source={x:Reference root}}"
              ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="4" HeightRequest="36" Margin="8,0">
            <Label Grid.Column="0" Text="{Binding IconGlyph, Source={x:Reference root}}"
                   FontFamily="{Binding IconFontFamily, Source={x:Reference root}}"
                   FontSize="12" TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
            <Label Grid.Column="1" FontSize="11" VerticalOptions="Center">
                <Label.Text>
                    <MultiBinding Converter="{StaticResource FirstNonEmptyMultiConverter}">
                        <Binding Path="NameOverride" Source="{x:Reference root}"/>
                        <Binding Path="Name"/>
                    </MultiBinding>
                </Label.Text>
            </Label>
            <!-- Colonnes 2/3 : boutons ⇄ (MoveCommand) et ✕ (RemoveCommand), créés en code seulement si
                 la commande est fournie - voir LazyIconButton. -->
        </Grid>
    </Border>
</ContentView>
