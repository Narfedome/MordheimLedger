<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.Steps.AvailableVeteransStepView"
             x:DataType="local:EndOfGamePageViewModel">
            <!-- Étape : Disponibilité des Vétérans (livre, étape 5) - simple jet 2D6 saisi/tapé, jamais
                 dépensé dans ce wizard (étape 8 "Engager de nouvelles recrues", pas encore construite) -
                 juste enregistré sur Warband.AvailableVeteranExperience, affiché en attendant sur
                 WarbandDetailPage. Toujours présente (aucune condition, voir Steps). -->
            <VerticalStackLayout Spacing="12">
                <Label Text="{loc:Loc EndOfGameAvailableVeteransHeading}" FontAttributes="Bold"/>
                <Label Text="{loc:Loc EndOfGameAvailableVeteransIntro}" TextColor="{DynamicResource AppTextMuted}"/>
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                    <Entry Grid.Column="0" Text="{Binding VeteranExperienceRoll}" Keyboard="Numeric"
                           Placeholder="{loc:Loc EndOfGameXpPh}" WidthRequest="90">
                        <Entry.Behaviors>
                            <components:DigitsOnlyBehavior/>
                        </Entry.Behaviors>
                    </Entry>
                    <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                  Command="{Binding AutoRollVeteranExperienceCommand}"
                                                  Tooltip="{loc:Loc EndOfGameRoll}"/>
                </Grid>
                <Label Text="{Binding VeteranExperienceRollError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                       IsVisible="{Binding VeteranExperienceRollError, Converter={StaticResource IsNotNullConverter}}"/>
            </VerticalStackLayout>

</ContentView>
