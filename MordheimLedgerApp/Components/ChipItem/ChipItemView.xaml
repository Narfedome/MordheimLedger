<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Class="MordheimLedgerApp.Components.ChipItemView"
             x:Name="root"
             IsVisible="{Binding ShowSection, Source={RelativeSource Self}}">
    <!-- Voir ChipListView.xaml pour la raison de ce doublon avec le IsVisible du VerticalStackLayout
         interne ci-dessous (bug de collapse Android sur un ContentView dont seul le contenu est masqué). -->

    <VerticalStackLayout
        BindingContext="{x:Reference root}"
        IsVisible="{Binding ShowSection}">

        <!-- Header -->
        <Grid x:Name="HeaderGrid" ColumnDefinitions="*,Auto">


            <!-- Centré sur la hauteur du « + » (44 points) au lieu d'être écrit en haut de la ligne. -->
            <Label FontSize="{Binding HeaderFontSize}" TextColor="{DynamicResource AppTextMuted}" IsVisible="{Binding IsMandatory}" VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding HeaderText}"/>
                        <Span Text=" *" TextColor="{StaticResource AppDanger}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>


            <!-- Bouton "+" (AddCommand) créé en code seulement si la commande est fournie - voir LazyIconButton. -->

        </Grid>

        <!-- Message lorsqu'il n'y a pas d'item -->
        <Label
            Text="{Binding EmptyHintText}"
            FontSize="11"
            TextColor="{DynamicResource AppTextMuted}"
            IsVisible="{Binding HasItem, Converter={StaticResource InverseBoolConverter}}" />

        <!-- Chip -->
        <components:ChipView Item="{Binding Item, Source={x:Reference root}}"
                              IconGlyph="{Binding IconGlyph, Source={x:Reference root}}"
                              IconFontFamily="{Binding IconFontFamily, Source={x:Reference root}}"
                              Command="{Binding Command, Source={x:Reference root}}"
                              RemoveCommand="{Binding RemoveCommand, Source={x:Reference root}}"
                              IsVisible="{Binding HasItem}"/>

    </VerticalStackLayout>

</ContentView>
