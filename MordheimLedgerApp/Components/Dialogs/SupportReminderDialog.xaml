<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:services="clr-namespace:MordheimLedgerApp.Core.Services;assembly=MordheimLedgerApp.Core"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               x:TypeArguments="services:SupportReminderChoice"
               x:Class="MordheimLedgerApp.Components.Dialogs.SupportReminderDialog"
               x:DataType="dialogs:SupportReminderDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0">
    <!-- Rappel « Soutenir le projet » après une Fin de partie (voir Core.Services.SupportReminder) : centré comme le dialog
         Nouveautés, Soutenir en bouton principal, Plus tard / Ne plus demander en dessous. -->
    <Border Style="{StaticResource DialogCardBorderStyle}">
        <VerticalStackLayout Spacing="16">
            <Label Text="{loc:Loc SettingsSupportTitle}" Style="{StaticResource DialogTitleLabelStyle}" HorizontalTextAlignment="Center"/>
            <Label Text="{loc:Loc SupportReminderMessage}" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
            <Button Text="{loc:Loc SupportReminderSupport}"
                    Command="{Binding SupportCommand}"
                    HorizontalOptions="Center"
                    MinimumWidthRequest="180"
                    AutomationId="SupportReminderSupport"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc SupportReminderLater}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"
                        AutomationId="SupportReminderLater"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc SupportReminderNever}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding NeverCommand}"
                        AutomationId="SupportReminderNever"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</dialogs:DialogContent>
