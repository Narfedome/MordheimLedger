<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Components.IconTextButton" x:Name="root"
             MinimumHeightRequest="44" MinimumWidthRequest="44">

    <!-- Une seule zone de tap pour l'icône ET le texte : les avoir séparés (icône décorative, texte
         seul cliquable) portait à confusion sur ce qu'on pouvait taper.
         MinimumHeightRequest/Width=44 et le pulse au tap (cf. code-behind) rejouent ce que le style
         Button implicite (Styles.xaml) donnait gratuitement aux anciens Button "transparents" : taille
         de cible tactile correcte + retour visuel au tap, perdus en passant à des Label nus. -->
    <!-- Grille : la mise en page dessine, le bouton transparent posé dessus reçoit le toucher, le clavier et
         Narrateur/TalkBack (2026-11-14, accessibilité - un geste sur une mise en page n'était actionnable ni au
         clavier ni par un lecteur d'écran), et porte le nom accessible (Text). -->
    <Grid>
        <!-- Survol sur la grille, pas sur le bouton : sous Android, un geste posé sur un Button avale son clic. -->
        <Grid.GestureRecognizers>
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"/>
        </Grid.GestureRecognizers>
    <HorizontalStackLayout x:Name="RootLayout" VerticalOptions="Center" InputTransparent="True"
                            Spacing="{Binding Source={x:Reference root}, Path=Spacing}">
        <!-- États gérés en code-behind (VisualStateManager.GoToState) plutôt qu'en DataTrigger : Normal/
             PointerOver/Disabled se marchaient dessus sur la même propriété Opacity une fois le survol
             souris réintroduit, un seul groupe de VisualState évite le conflit de précédence. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <Label Text="{Binding Source={x:Reference root}, Path=Icon}"
               FontFamily="{Binding Source={x:Reference root}, Path=IconFont}"
               FontSize="{Binding Source={x:Reference root}, Path=IconSize}"
               TextColor="{Binding Source={x:Reference root}, Path=TextColor}"
               VerticalOptions="Center"/>
        <Label Text="{Binding Source={x:Reference root}, Path=Text}"
               FontSize="{Binding Source={x:Reference root}, Path=FontSize}"
               TextColor="{Binding Source={x:Reference root}, Path=TextColor}"
               LineBreakMode="TailTruncation"
               IsVisible="{Binding Source={x:Reference root}, Path=ShowText}"
               MaximumWidthRequest="{Binding Source={x:Reference root}, Path=TextMaximumWidth}"
               VerticalOptions="Center"/>
    </HorizontalStackLayout>
    <Button BackgroundColor="Transparent" BorderWidth="0" Padding="0" CornerRadius="0"
            SemanticProperties.Description="{Binding Source={x:Reference root}, Path=Text}"
            Clicked="OnTapped"/>
    </Grid>
</ContentView>
