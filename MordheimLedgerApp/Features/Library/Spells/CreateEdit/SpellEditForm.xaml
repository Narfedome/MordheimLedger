<?xml version="1.0" encoding="utf-8" ?>
<form:FormContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:form="clr-namespace:MordheimLedgerApp.Components.FormPage"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.Spells.CreateEdit"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.Spells.CreateEdit.SpellEditForm"
               x:DataType="local:SpellEditDialogViewModel">
    <!-- Page plein écran (autrefois SpellEditDialog, voir Components/FormPage) : titre et
         ✕ dans l'en-tête, Annuler / Enregistrer dans le pied, contenu en carte. -->
    <form:FormPageLayout Title="{Binding Title}"
                         CloseCommand="{Binding CancelCommand}"
                         SecondaryText="{loc:Loc BtnCancel}"
                         SecondaryCommand="{Binding CancelCommand}"
                         PrimaryText="{loc:Loc BtnSave}"
                         PrimaryCommand="{Binding SaveCommand}">
        <Border Style="{StaticResource SectionCardBorderStyle}">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="12" TextColor="{DynamicResource AppTextMuted}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc SpellNamePh}"/>
                                <Span Text=" *" TextColor="{StaticResource AppDanger}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry Text="{Binding Item.Name}"/>
                    <Label Text="{Binding NameError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                           IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Loc SpellMagicSchoolPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <components:SelectFieldView Title="{loc:Loc SpellMagicSchoolPh}" ItemsSource="{Binding MagicSchoolOptions}"
                            SelectedItem="{Binding SelectedMagicSchoolLabel}"/>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{loc:Loc SpellRollValuePh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Entry Text="{Binding Item.RollValue}" Keyboard="Numeric"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="{loc:Loc SpellDifficultyPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Entry Text="{Binding Item.Difficulty}" Keyboard="Numeric"/>
                    </VerticalStackLayout>
                </Grid>
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Loc LibDescriptionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Editor Text="{Binding Item.Description}" HeightRequest="100"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </form:FormPageLayout>
</form:FormContent>
