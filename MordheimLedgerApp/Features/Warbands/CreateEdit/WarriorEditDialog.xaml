<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.CreateEdit"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               xmlns:models="clr-namespace:MordheimLedgerApp.Core.Models;assembly=MordheimLedgerApp.Core"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Warbands.CreateEdit.WarriorEditDialog"
               x:DataType="local:WarriorEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <dialogs:StableHeightScrollView>
        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}"
                       Style="{StaticResource DialogTitleLabelStyle}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Trash}"
                                              IconSize="14" ButtonWidthRequest="28" ButtonHeightRequest="28"
                                              Command="{Binding DeleteCommand}"/>
            </Grid>

            <VerticalStackLayout Spacing="2">
                <Label Text="{loc:Loc PromptName}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Entry Text="{Binding Item.Name}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="2">
                <Label Text="{loc:Loc WarriorExperiencePh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Entry Text="{Binding Item.Experience}" Keyboard="Numeric"/>
            </VerticalStackLayout>

            <!-- Abréviations officielles du livre de règles, pas de traduction - StatRowView en mode
                 édition, même composant que WarriorArchetypeEditDialog (onglet Profil). -->
            <components:StatRowView Item="{Binding Item}" MovementText="{Binding Item.Movement}" IsEditable="True"/>

            <!-- Surcharge texte optionnelle du Mouvement (ex. "2D6" pour les Squigs des cavernes) -
                 prioritaire sur la valeur M ci-dessus partout où le Mouvement est affiché, copiée
                 depuis l'archétype au recrutement (voir WarriorArchetype.MovementOverride). -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{loc:Loc WarriorArchetypeMovementOverridePh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Entry Text="{Binding Item.MovementOverride}"/>
            </VerticalStackLayout>

            <!-- Animal : champ 0..1 (pas une liste/onglet) - même famille que Nom/stats, soumis au
                 Enregistrer/Annuler du dialog plutôt qu'à une persistance immédiate. -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{loc:Loc WarriorAnimalHeading}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Label Grid.Column="0" Text="{Binding Item.Animal.Name}" VerticalOptions="Center"
                           TextColor="{DynamicResource AppText}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowAnimalDetailCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:RpgFont.RaPawprint}"
                                                  IconSize="14" ButtonWidthRequest="28" ButtonHeightRequest="28"
                                                  Command="{Binding SelectAnimalCommand}"/>
                    <components:FaIconButtonView Grid.Column="2" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:SolidFont.Xmark}"
                                                  IconSize="14" ButtonWidthRequest="28" ButtonHeightRequest="28"
                                                  IsVisible="{Binding Item.Animal, Converter={StaticResource IsNotNullConverter}}"
                                                  Command="{Binding ClearAnimalCommand}"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Onglets Équipement/Compétences/Blessures - même pattern toggle (pas de vrai TabbedPage)
                 que Roster/Historique sur WarbandDetailPage : la carte guerrier reste lecture seule pour
                 ces trois listes, tout se gère ici. ScrollableTabStripView : jusqu'à 5 onglets dans ce
                 dialog large de 340px. -->
            <components:ScrollableTabStripView>
                <HorizontalStackLayout Spacing="16">
                    <components:TabToggleButton Text="{loc:Loc WarriorsEquipmentHeading}" Command="{Binding ShowEquipmentTabCommand}"
                                                 IsActive="{Binding IsEquipmentTab}" FontSize="12"/>
                    <components:TabToggleButton Text="{loc:Loc WarriorsSkillsHeading}" Command="{Binding ShowSkillsTabCommand}"
                                                 IsActive="{Binding IsSkillsTab}" FontSize="12"/>
                    <components:TabToggleButton Text="{loc:Loc WarriorsInjuriesHeading}" Command="{Binding ShowInjuriesTabCommand}"
                                                 IsActive="{Binding IsInjuriesTab}" FontSize="12"/>
                    <!-- Onglet Sorts : visible seulement si l'archétype de ce guerrier est un lanceur de
                         sorts (WarriorArchetype.IsSpellcaster) - inutile pour un Homme de main lambda. -->
                    <components:TabToggleButton Text="{loc:Loc WarriorsSpellsHeading}" Command="{Binding ShowSpellsTabCommand}"
                                                 IsActive="{Binding IsSpellsTab}" FontSize="12"
                                                 IsVisible="{Binding IsSpellcaster}"/>
                    <!-- Onglet Mutations : visible seulement si l'archétype de ce guerrier a
                         WarriorArchetype.CanBuyMutations (Mutants/Possédés). -->
                    <components:TabToggleButton Text="{loc:Loc WarriorsMutationsHeading}" Command="{Binding ShowMutationsTabCommand}"
                                                 IsActive="{Binding IsMutationsTab}" FontSize="12"
                                                 IsVisible="{Binding IsMutant}"/>
                </HorizontalStackLayout>
            </components:ScrollableTabStripView>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEquipmentTab}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc WarriorsEquipmentHeading}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:SolidFont.Plus}"
                                                  IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                  IsVisible="{Binding Item.CanUseEquipment}"
                                                  Command="{Binding AddEquipmentCommand}"/>
                </Grid>
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Equipment}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WarriorEquipment">
                            <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=ShowEquipmentDetailCommand}"
                                                           CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                           FontFamily="RpgAwesome" FontSize="12"
                                           TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                    <Label Text="{Binding NameDisplay}" FontSize="11" VerticalOptions="Center"/>
                                    <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                  Icon="{x:Static icons:SolidFont.Xmark}"
                                                                  IconSize="10" ButtonWidthRequest="18" ButtonHeightRequest="18"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=RemoveEquipmentCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSkillsTab}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc WarriorsSkillsHeading}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:SolidFont.Plus}"
                                                  IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                  Command="{Binding AddSkillCommand}"/>
                </Grid>
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Skills}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WarriorSkill">
                            <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=ShowSkillDetailCommand}"
                                                           CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Item.Category, Converter={StaticResource SkillCategoryIconConverter}}"
                                           FontFamily="RpgAwesome" FontSize="12"
                                           TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                    <Label Text="{Binding Item.Name}" FontSize="11" VerticalOptions="Center"/>
                                    <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                  Icon="{x:Static icons:SolidFont.Xmark}"
                                                                  IconSize="10" ButtonWidthRequest="18" ButtonHeightRequest="18"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=RemoveSkillCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsInjuriesTab}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc WarriorsInjuriesHeading}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:SolidFont.Plus}"
                                                  IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                  Command="{Binding AddInjuryCommand}"/>
                </Grid>
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Injuries}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WarriorInjury">
                            <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=ShowInjuryDetailCommand}"
                                                           CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{x:Static icons:RpgFont.RaBrokenBone}"
                                           FontFamily="RpgAwesome" FontSize="12"
                                           TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                    <Label Text="{Binding Item.Name}" FontSize="11" VerticalOptions="Center"/>
                                    <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                  Icon="{x:Static icons:SolidFont.Xmark}"
                                                                  IconSize="10" ButtonWidthRequest="18" ButtonHeightRequest="18"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=RemoveInjuryCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSpellsTab}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc WarriorsSpellsHeading}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:SolidFont.Plus}"
                                                  IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                  Command="{Binding AddSpellCommand}"/>
                </Grid>
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Spells}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WarriorSpell">
                            <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=ShowSpellDetailCommand}"
                                                           CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{x:Static icons:RpgFont.RaBurningBook}"
                                           FontFamily="RpgAwesome" FontSize="12"
                                           TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                    <Label Text="{Binding Item.Name}" FontSize="11" VerticalOptions="Center"/>
                                    <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                  Icon="{x:Static icons:SolidFont.Xmark}"
                                                                  IconSize="10" ButtonWidthRequest="18" ButtonHeightRequest="18"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=RemoveSpellCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsMutationsTab}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc WarriorsMutationsHeading}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{x:Static icons:SolidFont.Plus}"
                                                  IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                  Command="{Binding AddMutationCommand}"/>
                </Grid>
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Mutations}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WarriorMutation">
                            <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=ShowMutationDetailCommand}"
                                                           CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{x:Static icons:RpgFont.RaBiohazard}"
                                           FontFamily="RpgAwesome" FontSize="12"
                                           TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                    <Label Text="{Binding Item.Name}" FontSize="11" VerticalOptions="Center"/>
                                    <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                  Icon="{x:Static icons:SolidFont.Xmark}"
                                                                  IconSize="10" ButtonWidthRequest="18" ButtonHeightRequest="18"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=RemoveMutationCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc BtnSave}"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </VerticalStackLayout>
        </dialogs:StableHeightScrollView>
    </Border>
</dialogs:DialogContent>
