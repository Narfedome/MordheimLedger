<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             x:Class="MordheimLedgerApp.Components.ScrollableTabStripView"
             x:Name="root">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <!-- Un seul enfant attendu (Content de ContentView n'accepte qu'une View) - l'appelant
                 enveloppe ses TabToggleButton dans son propre HorizontalStackLayout plutôt que de les
                 placer un par un ici (sinon seul le dernier survit, chaque enfant XAML réécrivant
                 Content). Générique : ne connaît rien du concept "wizard"/StepLabel - c'est à l'appelant
                 de basculer entre son libellé d'étape et cette bande d'onglets. HorizontalOptions/
                 VerticalOptions="Fill" explicites - même raison que PickerSelectorLayout/WatermarkedLayout :
                 sans eux, sur WinUI, ce ScrollView se dimensionnait sur le contenu mesuré (les boutons)
                 plutôt que l'espace disponible du dialog parent, donc aucun dépassement à faire défiler.

                 AutomationId="DragScrollTabStrip" : ni la molette ni PanGestureRecognizer (voir
                 OnApplyTemplate côté .xaml.cs, actif sur tactile/stylet) ne pilotent le ScrollViewer natif
                 pour un clic-glisser souris pur sur WinUI - limitation MAUI connue sur Windows. Le vrai
                 fix vit côté natif (MauiProgram.cs, ConfigureMauiHandlers sous #if WINDOWS), ciblé sur ce
                 seul ScrollViewer via cet AutomationId plutôt qu'un mapping global à tous les ScrollView
                 de l'appli - molette + drag souris + scrollbar masquée y sont câblés directement sur le
                 ScrollViewer WinUI. -->
            <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                <ScrollView x:Name="TabScrollView" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                            AutomationId="DragScrollTabStrip"
                            HorizontalOptions="Fill" VerticalOptions="Fill">
                    <ContentPresenter />
                </ScrollView>
                <!-- Indices de défilement (2026-09-24, retour utilisateur - rien ne signalait qu'il restait
                     des onglets hors champ, la scrollbar étant masquée) : un badge ‹ / › collé au bord,
                     visible seulement quand il reste du contenu de ce côté (UpdateScrollHints), tapable pour
                     défiler d'une largeur visible. AngleLeft/AngleRight plutôt que ChevronLeft (déjà la
                     flèche "retour" de DetailPageHeaderView - un glyphe = un concept). Fond AppSurface : la
                     plupart des usages vivent dans une carte de dialog. -->
                <Border x:Name="LeftHint" IsVisible="False" HorizontalOptions="Start" VerticalOptions="Center"
                        BackgroundColor="{DynamicResource AppSurface}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" Padding="6,2">
                    <Label Text="{x:Static icons:SolidFont.AngleLeft}" FontFamily="FontSolid" FontSize="14"
                           TextColor="{DynamicResource AppAccent}"/>
                </Border>
                <Border x:Name="RightHint" IsVisible="False" HorizontalOptions="End" VerticalOptions="Center"
                        BackgroundColor="{DynamicResource AppSurface}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" Padding="6,2">
                    <Label Text="{x:Static icons:SolidFont.AngleRight}" FontFamily="FontSolid" FontSize="14"
                           TextColor="{DynamicResource AppAccent}"/>
                </Border>
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
