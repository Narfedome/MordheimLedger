<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Components.ExperienceTrack.ExperienceTrackView"
             x:Name="root">
    <!-- Une seule GraphicsView qui dessine toute la piste (voir ExperienceTrackDrawable) plutôt qu'un
         Border natif par case - positions, paliers et taille des cases calculés en code-behind. -->
    <GraphicsView x:Name="Track" HorizontalOptions="Center"/>
</ContentView>
