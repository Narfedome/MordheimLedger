<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.Steps.RecruitHeroesCountStepView"
             x:DataType="local:EndOfGamePageViewModel">
            <!-- Recrutement (livre, étape 8 - "Hire New Recruits & Buy Common Items" - "this is done in
                 any order and may be done several times") : refondu en étapes séquentielles dédiées
                 (2026-09-21, retour utilisateur - "on manque d'homogénéité... on reprend le système qu'on
                 a dans WarbandEditDialog... écran par écran, step by step"), après qu'une première version
                 à 2 onglets librement navigables (Guerriers/Équipement, une seule carte pour Héros ET
                 Hommes de main) se soit révélée confuse - voir EndOfGamePageViewModel.Recruitment.cs. -->

            <!-- Étape : Héros - effectif (steppers seuls, toujours présente). -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc EndOfGameRecruitmentHeading}" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="{Binding RecruitmentTreasuryDisplay}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                </Grid>
                <Label Text="{Binding RecruitmentRosterCountDisplay}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <components:WarriorRecruitListView ItemsSource="{Binding HeroRecruitRows}"
                                                    HeaderText="{loc:Loc EndOfGameRecruitmentHeroesHeading}"
                                                    IncrementCommand="{Binding IncrementRecruitCommand}"
                                                    DecrementCommand="{Binding DecrementRecruitCommand}"
                                                    DetailCommand="{Binding ShowWarriorDetailCommand}"/>
            </VerticalStackLayout>

</ContentView>
