<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.EndOfGameDialog"
               x:DataType="local:EndOfGameDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="380">
        <dialogs:StableHeightScrollView>
        <VerticalStackLayout Spacing="16">
            <Label Text="{loc:Loc EndOfGameTitle}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>
            <Label Text="{Binding StepLabel}" TextColor="{DynamicResource AppTextMuted}"/>

            <!-- Étape : Résultat (contexte pour la phrase d'Historique - pas une étape du livre) -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsResultStep}">
                <Picker Title="{loc:Loc EndOfGameResultPh}"
                        ItemsSource="{Binding ResultOptions}"
                        SelectedItem="{Binding SelectedResult}"/>
            </VerticalStackLayout>

            <!-- Étape : Hors de combat - vue d'ensemble, aucun outil de jet ici (chaque guerrier/groupe
                 concerné reçoit sa propre étape Blessure juste après, une carte par écran plutôt que
                 toutes en même temps). Un Héros (toujours 1 figurine) se coche/décoche ; un groupe
                 d'Hommes de main indique combien de figurines sont hors de combat via un stepper - le
                 jet de Blessure Grave se fait par figurine, pas une fois pour tout le groupe. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsOutOfActionStep}">
                <Label Text="{loc:Loc EndOfGameOutOfAction}" FontAttributes="Bold"/>
                <Label Text="{loc:Loc EndOfGameOutOfActionHint}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <Border Style="{StaticResource SectionCardBorderStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                        <Label Text="{Binding ArchetypeName}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                                    </VerticalStackLayout>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsOutOfAction}" VerticalOptions="Center"
                                              IsVisible="{Binding IsHero}"/>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center"
                                                            IsVisible="{Binding IsHero, Converter={StaticResource InverseBoolConverter}}">
                                        <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Minus}" Style="{StaticResource GhostIconButtonStyle}"
                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=DecrementOutOfActionCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                        <Label Text="{Binding OutOfActionLabel}" WidthRequest="36" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                        <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}" Style="{StaticResource GhostIconButtonStyle}"
                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=IncrementOutOfActionCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Étape : Blessure - une carte par guerrier/groupe coché hors de combat, un seul à la
                 fois (CurrentInjuryWarrior), pas une liste. Héros et groupe d'Hommes de main divergent
                 ici : un Héros a un seul jet (+ ses éventuels sous-jets de Blessures multiples) ;
                 un groupe a un jet D6 indépendant par figurine hors de combat (FigureInjuryRolls). -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsInjuryStep}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc EndOfGameInjuriesHeading}" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="{Binding InjuryProgressLabel}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                </Grid>
                <Border Style="{StaticResource SectionCardBorderStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding CurrentInjuryWarrior.Name}" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding CurrentInjuryWarrior.ArchetypeName}" TextColor="{DynamicResource AppTextMuted}"/>
                            <!-- Statut auto-géré : passe à Mort tout seul sur un résultat de mort (voir
                                 ApplyInjuryRoll), pas de saisie manuelle. Héros uniquement - un groupe
                                 perd des figurines (HeadCount) plutôt que de passer Mort d'un coup. -->
                            <Label Grid.Column="2" Text="{loc:Loc EndOfGameDeadLabel}"
                                   IsVisible="{Binding CurrentInjuryWarrior.IsDead}"
                                   TextColor="{DynamicResource AppDanger}" FontAttributes="Bold"/>
                        </Grid>

                        <!-- Héros : un seul jet (+ Blessures multiples éventuelles). Le joueur peut soit
                             laisser l'appli tirer les dés (Dice = jet aléatoire + popup de résultat
                             immédiate), soit lancer ses propres dés à la table et saisir le score
                             lui-même : dès que la saisie est un jet complet et valide, le résultat
                             s'affiche tout seul sous le champ (pas de bouton à cliquer). -->
                        <VerticalStackLayout IsVisible="{Binding CurrentInjuryWarrior.IsHero}" Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                                <Entry Grid.Column="0" Text="{Binding CurrentInjuryWarrior.ManualRoll}" Keyboard="Numeric"
                                       Placeholder="{Binding CurrentInjuryWarrior.RollPlaceholder}" WidthRequest="70">
                                    <Entry.Behaviors>
                                        <components:DigitsOnlyBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                                <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                              Command="{Binding AutoRollCommand}"
                                                              CommandParameter="{Binding CurrentInjuryWarrior}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"/>
                            </Grid>
                            <Label Text="{Binding CurrentInjuryWarrior.RollError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                   IsVisible="{Binding CurrentInjuryWarrior.RollError, Converter={StaticResource IsNotNullConverter}}"/>
                            <Label Text="{Binding CurrentInjuryWarrior.InjuryResultText}" FontSize="12"/>

                            <!-- Résultat "Blessures multiples" (16/21) : 1D6 pour savoir combien de
                                 sous-jets faire sur cette même table, puis un jet D66 par sous-jet. -->
                            <VerticalStackLayout IsVisible="{Binding CurrentInjuryWarrior.ShowMultipleInjuriesSection}" Spacing="6">
                                <Label Text="{loc:Loc EndOfGameMultipleInjuriesHeading}" FontSize="12"
                                       FontAttributes="Bold" TextColor="{DynamicResource AppTextMuted}"/>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                                    <Entry Grid.Column="0" Text="{Binding CurrentInjuryWarrior.MultipleInjuryCountRoll}" Keyboard="Numeric"
                                           Placeholder="{loc:Loc EndOfGameMultipleInjuryCountPh}" WidthRequest="70">
                                        <Entry.Behaviors>
                                            <components:DigitsOnlyBehavior/>
                                        </Entry.Behaviors>
                                    </Entry>
                                    <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                                  Command="{Binding AutoRollMultipleInjuryCountCommand}"
                                                                  CommandParameter="{Binding CurrentInjuryWarrior}"
                                                                  Tooltip="{loc:Loc EndOfGameRoll}"/>
                                </Grid>
                                <Label Text="{Binding CurrentInjuryWarrior.MultipleInjuryCountError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                       IsVisible="{Binding CurrentInjuryWarrior.MultipleInjuryCountError, Converter={StaticResource IsNotNullConverter}}"/>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentInjuryWarrior.MultipleInjuryRolls}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:InjurySubRollEntry">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Label}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                                                    <Entry Grid.Column="0" Text="{Binding ManualRoll}" Keyboard="Numeric"
                                                           Placeholder="{loc:Loc EndOfGameRollPh}" WidthRequest="70">
                                                        <Entry.Behaviors>
                                                            <components:DigitsOnlyBehavior/>
                                                        </Entry.Behaviors>
                                                    </Entry>
                                                    <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=AutoRollSubInjuryCommand}"
                                                                                  CommandParameter="{Binding .}"
                                                                                  Tooltip="{loc:Loc EndOfGameRoll}"/>
                                                </Grid>
                                                <Label Text="{Binding RollError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                                       IsVisible="{Binding RollError, Converter={StaticResource IsNotNullConverter}}"/>
                                                <Label Text="{Binding InjuryResultText}" FontSize="12"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Groupe d'Hommes de main : un jet D6 indépendant par figurine hors de combat
                             (FigureInjuryRolls, déjà peuplé au nombre indiqué à l'étape précédente),
                             même résolution automatique que côté Héros ci-dessus. -->
                        <VerticalStackLayout IsVisible="{Binding CurrentInjuryWarrior.IsHero, Converter={StaticResource InverseBoolConverter}}" Spacing="10">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentInjuryWarrior.FigureInjuryRolls}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:InjurySubRollEntry">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Label}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                                                <Entry Grid.Column="0" Text="{Binding ManualRoll}" Keyboard="Numeric"
                                                       Placeholder="{loc:Loc EndOfGameHenchmanRollPh}" WidthRequest="70">
                                                    <Entry.Behaviors>
                                                        <components:DigitsOnlyBehavior/>
                                                    </Entry.Behaviors>
                                                </Entry>
                                                <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=AutoRollSubInjuryCommand}"
                                                                              CommandParameter="{Binding .}"
                                                                              Tooltip="{loc:Loc EndOfGameRoll}"/>
                                            </Grid>
                                            <Label Text="{Binding RollError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                                   IsVisible="{Binding RollError, Converter={StaticResource IsNotNullConverter}}"/>
                                            <Label Text="{Binding InjuryResultText}" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Étape : Expérience (livre - saisie libre, pas de calcul assisté). Pas de Statut ici :
                 entièrement auto-géré depuis l'étape Blessure. Le jet de progression (palier franchi)
                 est déplacé dans sa propre étape juste après, voir IsAdvanceStep - un guerrier peut
                 franchir plusieurs paliers d'un coup, ça ne tient plus sur une carte imbriquée ici. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExperienceStep}">
                <Label Text="{loc:Loc EndOfGameExperienceHeading}" FontAttributes="Bold"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <!-- Un guerrier mort (étape Blessure) ou qui ne gagne jamais d'XP (règle
                                 "Never Gains Experience", ex. Zombies) n'a rien à faire ici - retiré de
                                 cette étape plutôt que juste grisé, voir ShowsInExperienceStep. -->
                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    IsVisible="{Binding ShowsInExperienceStep}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="{Binding ArchetypeName}" TextColor="{DynamicResource AppTextMuted}"/>
                                    </Grid>
                                    <Entry Text="{Binding ExperienceGainedText}" Keyboard="Numeric"
                                           Placeholder="{loc:Loc EndOfGameXpPh}">
                                        <Entry.Behaviors>
                                            <components:DigitsOnlyBehavior/>
                                        </Entry.Behaviors>
                                    </Entry>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Étape : Progression - une carte par guerrier ayant franchi un palier d'XP à l'étape
                 précédente (CurrentAdvanceWarrior, même principe que CurrentInjuryWarrior - le wizard
                 saute entièrement cette étape si personne n'a franchi de palier, voir Steps dans le
                 ViewModel). Un guerrier qui saute plusieurs paliers d'un coup a une carte par palier
                 (AdvanceRolls) empilée dans cette même étape - même résolution automatique que les
                 Blessures Graves, purement descriptif. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAdvanceStep}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc EndOfGameAdvanceHeading}" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="{Binding AdvanceProgressLabel}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                </Grid>
                <Border Style="{StaticResource SectionCardBorderStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding CurrentAdvanceWarrior.Name}" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding CurrentAdvanceWarrior.ArchetypeName}" TextColor="{DynamicResource AppTextMuted}"/>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentAdvanceWarrior.AdvanceRolls}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:AdvanceRollEntry">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Label}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                                            <Entry Grid.Column="0" Text="{Binding ManualRoll}" Keyboard="Numeric"
                                                   Placeholder="{loc:Loc EndOfGameAdvanceRollPh}" WidthRequest="70">
                                                <Entry.Behaviors>
                                                    <components:DigitsOnlyBehavior/>
                                                </Entry.Behaviors>
                                            </Entry>
                                            <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=AutoRollAdvanceCommand}"
                                                                          CommandParameter="{Binding .}"
                                                                          Tooltip="{loc:Loc EndOfGameRoll}"/>
                                        </Grid>
                                        <Label Text="{Binding RollError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                               IsVisible="{Binding RollError, Converter={StaticResource IsNotNullConverter}}"/>
                                        <Label Text="{Binding ResultText}" FontSize="12"/>
                                        <!-- Résultat "Compétence" (Héros 2-5/10-12 uniquement, voir
                                             HeroAdvanceTable.IsSkill) : choix direct dans la Bibliothèque,
                                             rattachée au guerrier à l'enregistrement du wizard. -->
                                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSkillResult}">
                                            <Button Text="{loc:Loc EndOfGamePickSkill}"
                                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                                    FontSize="12" Padding="8,4"
                                                    IsVisible="{Binding HasSkillSelected, Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=PickAdvanceSkillCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SelectedSkills}"
                                                        IsVisible="{Binding HasSkillSelected}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="library:Skill">
                                                        <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,0">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=ShowSkillDetailCommand}"
                                                                                       CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Label Text="{Binding Name}" FontSize="12"
                                                                   FontAttributes="Bold" TextColor="{DynamicResource AppAccent}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Étape : Exploration - jet (livre, chapitre "Revenus"). Nombre de dés calculé
                 automatiquement (1D6 par Héros survivant + 1D6 si victoire, plafonné à 6 - voir
                 Core.Rules.ExplorationChart), le joueur saisit ou tire chaque dé. La résolution du
                 résultat éventuellement déclenché (au plus un, voir ExplorationChart.DetectMultiples)
                 vit dans une étape séparée juste après (IsExplorationResultStep, n'apparaît que si un
                 doublon/triple/etc a effectivement été trouvé) plutôt que sur ce même écran - même
                 découpage "une étape par sujet" que Hors de combat/Blessure ailleurs dans ce wizard. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExplorationRollStep}">
                <Label Text="{loc:Loc EndOfGameExplorationHeading}" FontAttributes="Bold"/>
                <Label Text="{loc:Loc EndOfGameExplorationDiceHint}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>

                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding ExplorationDice}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ExplorationDieEntry">
                            <VerticalStackLayout Spacing="4" Margin="0,0,10,10">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <Entry Grid.Column="0" Text="{Binding ManualRoll}" Keyboard="Numeric"
                                           Placeholder="{loc:Loc EndOfGameHenchmanRollPh}" WidthRequest="60">
                                        <Entry.Behaviors>
                                            <components:DigitsOnlyBehavior/>
                                        </Entry.Behaviors>
                                    </Entry>
                                    <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=AutoRollExplorationDieCommand}"
                                                                  CommandParameter="{Binding .}"
                                                                  Tooltip="{loc:Loc EndOfGameRoll}"/>
                                </Grid>
                                <Label Text="{Binding RollError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                       IsVisible="{Binding RollError, Converter={StaticResource IsNotNullConverter}}"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Étape : Exploration - résultat. N'apparaît dans le wizard que si le jet précédent a
                 déclenché un résultat (voir EndOfGameDialogViewModel.Steps) - jamais plusieurs à la
                 fois. Les objets trouvés vont dans l'inventaire de bande (pas de choix de guerrier ici,
                 voir WarbandEquipment) - à équiper plus tard depuis la fiche de bande. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExplorationResultStep}">
                <Label Text="{Binding TriggeredExplorationResult.Name}" FontAttributes="Bold"/>
                <Border Style="{StaticResource SectionCardBorderStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding TriggeredExplorationResult.Description}" FontSize="12"/>

                        <!-- Sous-jet D6 départageant les branches à choix exclusif (Groupe A, ex.
                             Cadavre) - sans objet pour un résultat à une seule branche déjà résolue. -->
                        <VerticalStackLayout IsVisible="{Binding ShowExplorationSubRoll}" Spacing="6">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                                <Entry Grid.Column="0" Text="{Binding ExplorationSubRoll}" Keyboard="Numeric"
                                       Placeholder="{loc:Loc EndOfGameHenchmanRollPh}" WidthRequest="70">
                                    <Entry.Behaviors>
                                        <components:DigitsOnlyBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                                <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                              Command="{Binding AutoRollExplorationSubRollCommand}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"/>
                            </Grid>
                            <Label Text="{Binding ExplorationSubRollError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                   IsVisible="{Binding ExplorationSubRollError, Converter={StaticResource IsNotNullConverter}}"/>
                        </VerticalStackLayout>

                        <!-- Test de caractéristique (Puits/Endurance, Taverne et Bâtiment Éventré/
                             Commandement plus tard) : choisir un Héros, comparer son jet à sa stat -
                             l'appli calcule elle-même Réussite/Échec (arithmétique sur des valeurs déjà
                             connues, pas une décision aléatoire) et bascule vers la branche
                             correspondante ci-dessous. -->
                        <VerticalStackLayout IsVisible="{Binding ShowStatTest}" Spacing="6">
                            <Picker Title="{loc:Loc EndOfGameStatTestHeroPh}"
                                    ItemsSource="{Binding StatTestEligibleHeroes}" ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding StatTestHero}"/>
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" IsVisible="{Binding StatTestHero, Converter={StaticResource IsNotNullConverter}}">
                                <Entry Grid.Column="0" Text="{Binding StatTestRoll}" Keyboard="Numeric"
                                       Placeholder="{loc:Loc EndOfGameHenchmanRollPh}" WidthRequest="70">
                                    <Entry.Behaviors>
                                        <components:DigitsOnlyBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                                <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                              Command="{Binding AutoRollStatTestCommand}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"/>
                                <Label Grid.Column="2" VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding StatTestFieldLabel}"/>
                                            <Span Text=" "/>
                                            <Span Text="{Binding StatTestStatValue}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                            <Label Text="{Binding StatTestError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                   IsVisible="{Binding StatTestError, Converter={StaticResource IsNotNullConverter}}"/>
                        </VerticalStackLayout>

                        <!-- Double au 2D6 (Maison du Marchand) : 2 dés séparés, indispensables ici car
                             le total seul (2D6x5) ne dit pas si c'était un double (ex. 6 peut venir de
                             3+3 comme de 1+5) - voir ShowDoubleRollCheck. -->
                        <VerticalStackLayout IsVisible="{Binding ShowDoubleRollCheck}" Spacing="6">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                <Entry Grid.Column="0" Text="{Binding ExplorationDoubleDie1}" Keyboard="Numeric" WidthRequest="50">
                                    <Entry.Behaviors>
                                        <components:DigitsOnlyBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                                <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                              Command="{Binding AutoRollExplorationDoubleDie1Command}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"/>
                                <Entry Grid.Column="2" Text="{Binding ExplorationDoubleDie2}" Keyboard="Numeric" WidthRequest="50">
                                    <Entry.Behaviors>
                                        <components:DigitsOnlyBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                                <components:FaIconButtonView Grid.Column="3" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                              Command="{Binding AutoRollExplorationDoubleDie2Command}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"/>
                            </Grid>
                            <Label Text="{Binding ExplorationDoubleRollError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                   IsVisible="{Binding ExplorationDoubleRollError, Converter={StaticResource IsNotNullConverter}}"/>
                        </VerticalStackLayout>

                        <!-- Branche résolue : montant d'or/pierres magiques éditable, ou objet trouvé
                             (quantité éditable, va dans l'inventaire de bande à la sauvegarde). -->
                        <VerticalStackLayout IsVisible="{Binding ResolvedExplorationOutcome, Converter={StaticResource IsNotNullConverter}}" Spacing="8">
                            <!-- Résolue via le double au 2D6 (Maison du Marchand, voir ShowDoubleRollCheck) :
                                 le montant est déjà calculé depuis les 2 dés tapés plus haut (voir
                                 ShowExplorationGoldRoll/ResolveDoubleRoll) - lecture seule, pas de second
                                 jet redondant pour le même 2D6x5. -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsExplorationGold}">
                                <Label Grid.Column="0" Text="{loc:Loc EndOfGameExplorationGoldLabel}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding ExplorationGoldAmount}"
                                       VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"
                                       IsVisible="{Binding ShowExplorationGoldRoll, Converter={StaticResource InverseBoolConverter}}"/>
                                <Entry Grid.Column="1" Text="{Binding ExplorationGoldAmount}" Keyboard="Numeric" WidthRequest="70"
                                       IsVisible="{Binding ShowExplorationGoldRoll}">
                                    <Entry.Behaviors>
                                        <components:DigitsOnlyBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                                <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                              Command="{Binding AutoRollExplorationGoldCommand}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"
                                                              IsVisible="{Binding ShowExplorationGoldRoll}"/>
                            </Grid>

                            <!-- Sauf indication contraire du livre (ex. Forge : "D3 Hallebardes"), un seul
                                 exemplaire est trouvé - ni champ ni dé, juste "x1" en lecture seule (voir
                                 ShowExplorationItemQuantityRoll) : ce n'est pas un jet, rien à faire
                                 trancher au joueur. -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsExplorationItem}">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <!-- Choix du joueur entre 2 objets (ex. Armurerie 1-2 : Bouclier OU
                                         Rondache, voir ExplorationOutcome.AlternativeEquipmentItemName) -
                                         invisible pour toute autre branche Item. 2 RadioButton plutôt
                                         qu'un Picker : les deux options tiennent affichées d'un coup,
                                         pas de tap "pour ouvrir" en plus pour un choix binaire.
                                         RadioButtonGroup.SelectedValue lié directement au nom ANGLAIS du
                                         catalogue (Value de chaque RadioButton), pas un index - voir
                                         EndOfGameDialogViewModel.SelectedExplorationItemName. Chaque
                                         option affiche le vrai ChipView tapable (icône + popup détail) en
                                         FRÈRE du RadioButton, jamais dans RadioButton.Content : un View
                                         arbitraire en Content ne s'affichait pas côté Windows/WinUI
                                         (repéré le 2026-08-18 - cercle vide, contenu flottant ailleurs à
                                         l'écran) ; en frère plutôt qu'imbriqué, le tap du ChipView (popup
                                         détail) et celui du RadioButton (sélection) ne se marchent pas
                                         dessus, chacun sur sa propre cible. -->
                                    <VerticalStackLayout Spacing="0" IsVisible="{Binding HasExplorationItemChoice}"
                                                          RadioButtonGroup.GroupName="ExplorationItemChoice"
                                                          RadioButtonGroup.SelectedValue="{Binding SelectedExplorationItemName, Mode=TwoWay}">
                                        <HorizontalStackLayout Spacing="6">
                                            <RadioButton Value="{Binding ResolvedExplorationOutcome.EquipmentItemName}"/>
                                            <components:ChipView Item="{Binding ExplorationItemChoicePrimaryItem}"
                                                                  IconGlyph="{Binding ExplorationItemChoicePrimaryItem.Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                                  IconFontFamily="RpgAwesome"
                                                                  Command="{Binding ShowExplorationItemDetailCommand}"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6">
                                            <RadioButton Value="{Binding ResolvedExplorationOutcome.AlternativeEquipmentItemName}"/>
                                            <components:ChipView Item="{Binding ExplorationItemChoiceAlternativeItem}"
                                                                  IconGlyph="{Binding ExplorationItemChoiceAlternativeItem.Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                                  IconFontFamily="RpgAwesome"
                                                                  Command="{Binding ShowExplorationItemDetailCommand}"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <!-- ChipView tapable (icône de catégorie + popup détail), même langage
                                         d'interaction que toute autre référence Équipement dans l'app.
                                         ResolvedExplorationSecondaryItem (ex. Charrette Renversée : Épée
                                         + Dague, voir ExplorationOutcome.SecondaryEquipmentItemName) ne
                                         s'affiche PAS ici - une section dédiée plus bas, hors de ce Grid
                                         IsExplorationItem, la montre pour n'importe quel Kind (ex.
                                         Laboratoire de l'Alchimiste : Or + Carnet), pas seulement Item -
                                         éviter de l'afficher deux fois. Masqué pour une branche à choix :
                                         les 2 RadioButton du bloc ci-dessus montrent déjà chaque option. -->
                                    <HorizontalStackLayout Spacing="0" IsVisible="{Binding HasExplorationItemChoice, Converter={StaticResource InverseBoolConverter}}">
                                        <components:ChipView Item="{Binding ResolvedExplorationItem}"
                                                              IconGlyph="{Binding ResolvedExplorationItem.Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                              IconFontFamily="RpgAwesome"
                                                              Command="{Binding ShowExplorationItemDetailCommand}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <!-- VerticalOptions="Center" explicite sur les 3 : la colonne 0 grandit
                                     désormais (2 RadioButton + chip) pour une branche à choix, la
                                     colonne "jet" doit rester centrée sur la hauteur de la ligne plutôt
                                     que collée en haut. -->
                                <Label Grid.Column="1" Text="{Binding ExplorationItemQuantity, StringFormat='x{0}'}"
                                       VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"
                                       IsVisible="{Binding ShowExplorationItemQuantityRoll, Converter={StaticResource InverseBoolConverter}}"/>
                                <Entry Grid.Column="1" Text="{Binding ExplorationItemQuantity}" Keyboard="Numeric" WidthRequest="70"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding ShowExplorationItemQuantityRoll}">
                                    <Entry.Behaviors>
                                        <components:DigitsOnlyBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                                <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                              Command="{Binding AutoRollExplorationItemQuantityCommand}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"
                                                              VerticalOptions="Center"
                                                              IsVisible="{Binding ShowExplorationItemQuantityRoll}"/>
                            </Grid>

                            <!-- Valeur de revente trouvée (ex. Bijoutier : Pierres de Quartz "D6x5 CG",
                                 Rubis "D6x15 CG") - uniquement pour une branche Item dont la valeur
                                 n'est pas le Cost fixe du catalogue (voir
                                 ExplorationOutcome.FoundValueFormula/ShowExplorationItemFoundValueRoll).
                                 Même idiome que l'Or : jamais rempli automatiquement, le joueur tape son
                                 jet physique ou clique le dé. -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ShowExplorationItemFoundValueRoll}">
                                <Label Grid.Column="0" Text="{loc:Loc EndOfGameExplorationFoundValueLabel}" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" Text="{Binding ExplorationItemFoundValue}" Keyboard="Numeric" WidthRequest="70">
                                    <Entry.Behaviors>
                                        <components:DigitsOnlyBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                                <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                              Command="{Binding AutoRollExplorationItemFoundValueCommand}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"/>
                            </Grid>

                            <!-- Même convention que l'Objet ci-dessus : une quantité fixe (ex. Puits :
                                 toujours 1 pierre) s'affiche en lecture seule, sans jet (voir
                                 ShowExplorationWyrdstoneRoll). -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsExplorationWyrdstone}">
                                <Label Grid.Column="0" Text="{loc:Loc EndOfGameExplorationWyrdstoneLabel}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding ExplorationWyrdstoneAmount}"
                                       VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"
                                       IsVisible="{Binding ShowExplorationWyrdstoneRoll, Converter={StaticResource InverseBoolConverter}}"/>
                                <Entry Grid.Column="1" Text="{Binding ExplorationWyrdstoneAmount}" Keyboard="Numeric" WidthRequest="70"
                                       IsVisible="{Binding ShowExplorationWyrdstoneRoll}">
                                    <Entry.Behaviors>
                                        <components:DigitsOnlyBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                                <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                              Command="{Binding AutoRollExplorationWyrdstoneCommand}"
                                                              Tooltip="{loc:Loc EndOfGameRoll}"
                                                              IsVisible="{Binding ShowExplorationWyrdstoneRoll}"/>
                            </Grid>

                            <!-- Un seul des trois Grid ci-dessus est jamais visible à la fois
                                 (IsExplorationGold/Item/Wyrdstone mutuellement exclusifs) - une seule
                                 Label d'erreur partagée suffit. -->
                            <Label Text="{Binding ExplorationAmountError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                   IsVisible="{Binding ExplorationAmountError, Converter={StaticResource IsNotNullConverter}}"/>

                            <!-- Branche sans effet trésorerie/inventaire (ex. Traînard/"autres bandes")
                                 - purement informatif, consigné dans l'Historique à la sauvegarde plutôt
                                 que silencieusement perdu. -->
                            <Label IsVisible="{Binding IsExplorationNone}" Text="{Binding ExplorationNoteText}"
                                   FontSize="12" FontAttributes="Italic" TextColor="{DynamicResource AppTextMuted}"/>

                        </VerticalStackLayout>

                        <!-- Second objet du même branch, indépendant du Kind (ex. Charrette Renversée,
                             Kind Item : Épée + Dague ornées ; Laboratoire de l'Alchimiste, Kind Gold :
                             Or + Carnet de l'Alchimiste) - voir ExplorationOutcome.
                             SecondaryEquipmentItemName. Volontairement en dehors du Grid IsExplorationItem
                             ci-dessus (qui ne s'affiche que pour Kind.Item) : ce second objet peut
                             accompagner N'IMPORTE quel Kind, pas seulement Item. -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ResolvedExplorationSecondaryItem, Converter={StaticResource IsNotNullConverter}}">
                            <components:ChipView Grid.Column="0" Item="{Binding ResolvedExplorationSecondaryItem}"
                                                  IconGlyph="{Binding ResolvedExplorationSecondaryItem.Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                  IconFontFamily="RpgAwesome"
                                                  Command="{Binding ShowExplorationItemDetailCommand}"/>
                            <Label Grid.Column="1" Text="x1" VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"/>
                        </Grid>

                        <!-- Objet bonus sur le même dé que l'or (ex. Boutique : "sur un 1, en plus, un
                             Porte-bonheur") - voir BonusItemOutcome, déduit d'ExplorationGoldAmount sans
                             second jet. Indépendant du bloc ResolvedExplorationOutcome ci-dessus
                             (peut s'afficher en plus de l'or, jamais à la place). Toujours un seul
                             exemplaire (même convention que ShowExplorationItemQuantityRoll), pas de
                             champ ni de dé ici non plus. -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasBonusItem}">
                            <components:ChipView Grid.Column="0" Item="{Binding BonusItem}"
                                                  IconGlyph="{Binding BonusItem.Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                  IconFontFamily="RpgAwesome"
                                                  Command="{Binding ShowExplorationItemDetailCommand}"/>
                            <Label Grid.Column="1" Text="x1" VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Étape : Récapitulatif (pas une étape du livre - relecture avant d'enregistrer) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRecapStep}">
                <Label Text="{loc:Loc EndOfGameRecapHeading}" FontAttributes="Bold"/>
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Loc EndOfGameResultPh}"/>
                            <Span Text=" : "/>
                            <Span Text="{Binding SelectedResult}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label IsVisible="{Binding HasExplorationResult}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Loc EndOfGameExplorationHeading}"/>
                            <Span Text=" : "/>
                            <Span Text="{Binding TriggeredExplorationResult.Name}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <Label Text="{Binding SummaryText}" FontSize="13"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc LibBack}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"/>
                <Button Grid.Column="2"
                        Text="{loc:Loc LibNext}"
                        Command="{Binding NextCommand}"
                        IsVisible="{Binding IsLastStep, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Grid.Column="2"
                        Text="{loc:Loc BtnSave}"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding IsLastStep}"/>
            </Grid>
        </VerticalStackLayout>
        </dialogs:StableHeightScrollView>
    </Border>
</dialogs:DialogContent>
