<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MordheimLedgerApp.Features.Warbands"
             xmlns:models="clr-namespace:MordheimLedgerApp.Core.Models;assembly=MordheimLedgerApp.Core"
             xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
             xmlns:header="clr-namespace:MordheimLedgerApp.Components.DetailPageHeader"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:xp="clr-namespace:MordheimLedgerApp.Components.ExperienceTrack"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             x:Class="MordheimLedgerApp.Features.Warbands.WarbandDetailPage"
             x:DataType="vm:WarbandDetailViewModel"
             Shell.NavBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Carte guerrier partagée entre les sections Heroes/Henchmen : le contenu ne dépend que
                 du Warrior lié (IsHero pilote directement ExperienceTrackView), pas du groupe qui
                 l'affiche. -->
            <DataTemplate x:Key="WarriorCardTemplate" x:DataType="vm:WarriorRow">
                <Border Style="{StaticResource SectionCardBorderStyle}" Margin="12,6">
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="{Binding Warrior.Name}" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"/>
                                <!-- Effectif d'un groupe d'Hommes de main (Warrior.HeadCount > 1) - vide donc
                                     invisible pour un Héros ou un groupe à 1 seul survivant. -->
                                <Label Text="{Binding HeadCountDisplay}" TextColor="{DynamicResource AppTextMuted}"
                                       FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center"/>
                                <!-- Pense-bête visuel seulement (voir WarriorRow.IsSick) - masqué tant
                                     qu'il est Actif, s'efface tout seul à la fin de partie suivante,
                                     rien à cliquer ici (contrairement à un ChipView catalogue). -->
                                <Border Style="{StaticResource ChipBorderStyle}" IsVisible="{Binding IsSick}"
                                        Padding="6,2" Stroke="{DynamicResource AppDanger}" VerticalOptions="Center">
                                    <Label Text="{loc:Loc WarriorStatusSick}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{DynamicResource AppDanger}"/>
                                </Border>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="{Binding RoleName}" TextColor="{DynamicResource AppAccent}" FontSize="12" VerticalOptions="Center"/>
                            <components:FaIconButtonView Grid.Column="2" Style="{StaticResource GhostIconButtonStyle}"
                                                          Icon="{x:Static icons:SolidFont.Pen}"
                                                          IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                          IsVisible="{Binding IsDead, Converter={StaticResource InverseBoolConverter}}"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=EditWarriorCommand}"
                                                          CommandParameter="{Binding .}"/>
                        </Grid>

                        <!-- StatRowView partagé avec AnimalDetailDialog/WarriorArchetypeDetailDialog -
                             abréviations françaises officielles (StatXAbbr), resserré à 10/13 (au lieu
                             du défaut 12/14) pour rester dense sur un roster qui peut afficher beaucoup
                             de cartes guerrier d'affilée. -->
                        <components:StatRowView Item="{Binding Warrior}" MovementText="{Binding Warrior.MovementDisplay}" Margin="0,0,0,8"
                                                 AbbrFontSize="10" ValueFontSize="13"/>

                        <!-- Règles spéciales : lecture seule, non éditable ici du tout - résolues par le
                             ViewModel depuis WarriorArchetype.SpecialRules + WarbandArchetype.
                             SpecialRules (règles bande-entière), pas stockées sur le Warrior. Pour
                             changer les règles d'un type de guerrier, ça se passe dans la Bibliothèque
                             (WarriorArchetypeEditDialog/WarbandArchetypeEditDialog), pas ici. -->
                        <components:ChipListView HeaderText="{loc:Loc WarriorsSpecialRulesHeading}"
                                                  ItemsSource="{Binding SpecialRules}"
                                                  IconGlyph="{x:Static icons:SolidFont.Scroll}"
                                                  HeaderFontSize="10" HeaderTextColor="{DynamicResource AppTextMuted}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=ShowSpecialRuleDetailCommand}"/>

                        <!-- Blessures : lecture seule ici (pas de bouton "+"/"x") - gérées depuis le
                             dialog d'édition (voir WarriorEditDialog). Alimenté à la fois par le jet de
                             Fin de partie et par les ajouts manuels. Même style de puce que
                             Équipement/Compétences. -->
                        <components:ChipListView HeaderText="{loc:Loc WarriorsInjuriesHeading}"
                                                  ItemsSource="{Binding Injuries}"
                                                  IconGlyph="{x:Static icons:RpgFont.RaBrokenBone}"
                                                  IconFontFamily="RpgAwesome"
                                                  HeaderFontSize="10" HeaderTextColor="{DynamicResource AppTextMuted}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=ShowInjuryDetailCommand}"/>

                        <!-- École(s) de magie : celle(s) de LA BANDE (pas propre au guerrier - voir
                             WarriorRow.MagicSchools), résolue seulement pour les guerriers lanceurs de
                             sorts (WarriorArchetype.IsSpellcaster) - invisible pour tous les autres
                             (HasMagicSchools vide). Même popup récap (Nom+Description+Sorts) que
                             l'onglet Magie du Codex/WarbandArchetypeDetailDialog. -->
                        <components:ChipListView HeaderText="{loc:Loc LibMagicSchoolsPh}"
                                                  ItemsSource="{Binding MagicSchools}"
                                                  IconGlyph="{x:Static icons:RpgFont.RaCrystalBall}"
                                                  IconFontFamily="RpgAwesome"
                                                  HeaderFontSize="10" HeaderTextColor="{DynamicResource AppTextMuted}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=ShowMagicSchoolDetailCommand}"/>

                        <!-- Sorts connus : lecture seule, gérés depuis l'onglet Sorts de WarriorEditDialog
                             (visible seulement si l'archétype de ce guerrier est un lanceur de sorts). -->
                        <components:ChipListView HeaderText="{loc:Loc WarriorsSpellsHeading}"
                                                  ItemsSource="{Binding Spells}"
                                                  IconGlyph="{x:Static icons:RpgFont.RaBurningBook}"
                                                  IconFontFamily="RpgAwesome"
                                                  HeaderFontSize="10" HeaderTextColor="{DynamicResource AppTextMuted}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=ShowSpellDetailCommand}"/>

                        <!-- Mutations : lecture seule, gérées depuis l'onglet Mutations de
                             WarriorEditDialog (visible seulement si l'archétype de ce guerrier a
                             CanBuyMutations). -->
                        <components:ChipListView HeaderText="{loc:Loc WarriorsMutationsHeading}"
                                                  ItemsSource="{Binding Mutations}"
                                                  IconGlyph="{x:Static icons:RpgFont.RaBiohazard}"
                                                  IconFontFamily="RpgAwesome"
                                                  HeaderFontSize="10" HeaderTextColor="{DynamicResource AppTextMuted}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=ShowMutationDetailCommand}"/>

                        <!-- Animal : lecture seule, un seul chip (champ 0..1, pas une liste) - gérée
                             depuis WarriorEditDialog. -->
                        <components:ChipItemView HeaderText="{loc:Loc WarriorAnimalHeading}"
                                                  Item="{Binding Animal}"
                                                  IconGlyph="{x:Static icons:RpgFont.RaPawprint}"
                                                  IconFontFamily="RpgAwesome"
                                                  HeaderFontSize="10"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=ShowAnimalDetailCommand}"/>

                        <!-- Équipement/Compétences : lecture seule ici, même traitement que Blessures -
                             gérées depuis le dialog d'édition (voir WarriorEditDialog, onglets dédiés). -->
                        <VerticalStackLayout Spacing="2" IsVisible="{Binding HasEquipment}">
                            <Label Text="{loc:Loc WarriorsEquipmentHeading}" FontSize="10" TextColor="{DynamicResource AppTextMuted}"/>
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Equipment}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WarriorEquipment">
                                        <components:ChipView Item="{Binding .}"
                                                              IconGlyph="{Binding Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                              IconFontFamily="RpgAwesome"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=ShowEquipmentDetailCommand}"/>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2" IsVisible="{Binding HasSkills}">
                            <Label Text="{loc:Loc WarriorsSkillsHeading}" FontSize="10" TextColor="{DynamicResource AppTextMuted}"/>
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Skills}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WarriorSkill">
                                        <components:ChipView Item="{Binding .}"
                                                              IconGlyph="{Binding Item.Category, Converter={StaticResource SkillCategoryIconConverter}}"
                                                              IconFontFamily="RpgAwesome"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=ShowSkillDetailCommand}"/>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <Label Text="{loc:Loc WarriorsExperienceHeading}" FontSize="10" TextColor="{DynamicResource AppTextMuted}"/>
                        <!-- Pas de HorizontalOptions="Center" ici : ExperienceTrackView a besoin de sa
                             largeur réellement disponible (voir CalculateRowSize) pour choisir combien
                             de cases tiennent par ligne - un Center le ferait se réduire à son propre
                             contenu, rendant ce calcul circulaire. Le centrage visuel se fait déjà à
                             l'intérieur du composant (TrackLayout). -->
                        <xp:ExperienceTrackView Experience="{Binding Warrior.Experience}" IsHero="{Binding Warrior.IsHero}"/>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <components:WatermarkedLayout>
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" x:Name="Header" ColumnDefinitions="*,Auto">
            <header:DetailPageHeaderView Grid.Column="0" Title="{Binding Warband.Name}" BackCommand="{Binding BackCommand}"/>
            <components:IconTextButton Grid.Column="1" Margin="0,0,16,0"
                                        IsVisible="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                        Icon="{x:Static icons:SolidFont.FlagCheckered}"
                                        Text="{loc:Loc EndOfGameTitle}"
                                        TextColor="{DynamicResource AppAccent}"
                                        Command="{Binding EndOfGameCommand}"/>
        </Grid>

        <!-- Contenu de la page (trésorerie/rating, onglets Roster/Historique, recruter, roster,
             historique) entièrement masqué pendant Loading.IsLoading - seul le header (titre + retour)
             reste visible, pour ne pas bloquer la navigation pendant un chargement/rechargement. -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
        <Label Grid.Row="0" Margin="16,0,16,8" TextColor="{DynamicResource AppTextMuted}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{loc:Loc WarbandsTreasuryLabel}"/>
                    <Span Text="{Binding Warband.Treasury, StringFormat=' {0} gc'}"/>
                    <Span Text=" · "/>
                    <Span Text="{loc:Loc WarbandRatingPh}"/>
                    <Span Text="{Binding Rating, StringFormat=' {0}'}"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!-- Roster / Historique : pas de précédent DmTools pour des "onglets" internes à une page de
             détail - toggle minimal (deux boutons + IsVisible) plutôt qu'un vrai TabbedPage/Shell tab.
             Recruter (et l'effectif des groupes d'Hommes de main) ne se gère plus depuis ici - retour
             utilisateur explicite : ces changements de roster passent désormais par Fin de Partie
             (l'étape "entre deux parties" du livre des règles), pas en action libre à tout moment. -->
        <Grid Grid.Row="1" Margin="16,0,16,8">
            <components:ScrollableTabStripView>
                <HorizontalStackLayout Spacing="16">
                    <components:TabToggleButton Text="{loc:Loc TabRoster}" Command="{Binding ShowRosterCommand}"
                                                 IsActive="{Binding ShowHistory, Converter={StaticResource InverseBoolConverter}}"/>
                    <components:TabToggleButton Text="{loc:Loc TabHistory}" Command="{Binding ShowHistoryTabCommand}"
                                                 IsActive="{Binding ShowHistory}"/>
                </HorizontalStackLayout>
            </components:ScrollableTabStripView>
        </Grid>

        <!-- Pas de CollectionView ici (virtualisation inutile pour un roster de quelques dizaines de
             guerriers max, et une CollectionView imbriquée dans un ScrollView pose des soucis de
             hauteur) : un simple ScrollView + BindableLayout par groupe. -->
        <ScrollView Grid.Row="2" x:Name="RosterScroll" IsVisible="{Binding ShowHistory, Converter={StaticResource InverseBoolConverter}}">
            <VerticalStackLayout Spacing="0" Margin="0,8">

                <Grid Padding="16,10,16,4" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleHeroesCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc WarriorsGroupHeroes}"/>
                                <Span Text="{Binding Heroes.Count, StringFormat=' · {0}'}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{Binding HeroesExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                  Command="{Binding ToggleHeroesCommand}"/>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding HeroesExpanded}"
                                     BindableLayout.ItemsSource="{Binding Heroes}"
                                     BindableLayout.ItemTemplate="{StaticResource WarriorCardTemplate}"/>

                <Grid Padding="16,10,16,4" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleHenchmenCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc WarriorsGroupHenchmen}"/>
                                <Span Text="{Binding Henchmen.Count, StringFormat=' · {0}'}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{Binding HenchmenExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                  Command="{Binding ToggleHenchmenCommand}"/>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding HenchmenExpanded}"
                                     BindableLayout.ItemsSource="{Binding Henchmen}"
                                     BindableLayout.ItemTemplate="{StaticResource WarriorCardTemplate}"/>

                <!-- Morts : lecture seule (les boutons Éditer/+/x sont masqués sur la carte via
                     WarriorRow.IsDead), regroupe Héros et Hommes de main morts ensemble - conservés
                     dans le roster pour l'historique de la bande plutôt que retirés à la fin de partie. -->
                <Grid Padding="16,10,16,4" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDeadCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc WarriorsGroupDead}"/>
                                <Span Text="{Binding DeadWarriors.Count, StringFormat=' · {0}'}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{Binding DeadExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                  Command="{Binding ToggleDeadCommand}"/>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding DeadExpanded}"
                                     BindableLayout.ItemsSource="{Binding DeadWarriors}"
                                     BindableLayout.ItemTemplate="{StaticResource WarriorCardTemplate}"/>

                <!-- Inventaire de bande : objets trouvés (ex. étape Exploration du wizard Fin de
                     Partie) pas encore assignés à un guerrier - voir Models.WarbandEquipment. Masqué
                     entièrement si vide plutôt qu'un groupe permanent à 0, contrairement à Héros/Hommes
                     de main/Morts qui existent toujours. -->
                <Grid Padding="16,10,16,4" ColumnDefinitions="*,Auto" IsVisible="{Binding HasInventory}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleInventoryCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc InventoryHeading}"/>
                                <Span Text="{Binding Inventory.Count, StringFormat=' · {0}'}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{Binding InventoryExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                  Command="{Binding ToggleInventoryCommand}"/>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding InventoryExpanded}" Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Inventory}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WarbandEquipment">
                            <Border Style="{StaticResource SectionCardBorderStyle}" Margin="16,4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                        <Label Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="12"
                                               TextColor="{DynamicResource AppTextMuted}"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="{loc:Loc InventoryEquip}"
                                            Style="{StaticResource DialogSecondaryButtonStyle}"
                                            FontSize="12" Padding="10,4" VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=EquipInventoryItemCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,8" IsVisible="{Binding ShowHistory}">
            <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="16,0,16,8">
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                     Command="{Binding AddNoteCommand}"
                                     Tooltip="{loc:Loc HistoryAddNote}"/>
            </HorizontalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding HistoryEntries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryEntry">
                        <Border Style="{StaticResource SectionCardBorderStyle}" Margin="12,6">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Date, StringFormat='{0:g}'}" FontSize="12"
                                       TextColor="{DynamicResource AppTextMuted}"/>
                                <Label Text="{Binding Text}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        </Grid>

        <!-- Même emplacement (Grid.Row="1") que le contenu qu'il remplace pendant le chargement - même
             idiome que les dialogs (ActivityIndicator + Loading.IsLoading). -->
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                            HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="60" HeightRequest="60"/>
    </Grid>
    </components:WatermarkedLayout>
</ContentPage>
