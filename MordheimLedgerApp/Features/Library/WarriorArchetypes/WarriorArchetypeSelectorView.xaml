<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Features.Library.WarriorArchetypes.WarriorArchetypeSelectorView"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.WarriorArchetypes"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Name="root">

    <!-- Sélecteur-only (pas de mode CRUD, contrairement à WarriorArchetypeView) : pas de filtre, pas
         de groupage (voir WarriorArchetypeSelectorViewModel - en pratique 0 ou 1 bande sélectionnée
         quand ce picker s'ouvre depuis SkillEditDialog). -->
    <Grid Margin="5" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="120" HeightRequest="120"/>

        <CollectionView Grid.Row="0" x:Name="ItemsCollection"
                ItemsSource="{Binding Items}"
                SelectionMode="None"
                ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.Behaviors>
                <components:ResponsiveGridSpanBehavior TileWidth="140"/>
            </CollectionView.Behaviors>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="5" HorizontalItemSpacing="5" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:WarriorArchetypeRow">
                    <Border Style="{StaticResource SelectableGridItemBorderStyle}" BackgroundColor="Transparent" Stroke="Grey">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList/>
                        </VisualStateManager.VisualStateGroups>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="LightSkyBlue"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference root}, Path=BindingContext.SelectCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Grid WidthRequest="120" HeightRequest="120">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <components:LibraryItemImageView
                                Grid.Row="0"
                                ImagePath="{Binding Item.ImagePath}"
                                DefaultGlyph="{x:Static icons:SolidFont.User}"
                                Padding="20" />
                            <Label Text="{Binding Item.Name}"
                                   Grid.Row="1"
                                   Style="{StaticResource TruncatedLabelStyle}"
                                   HorizontalOptions="Center"
                                   Margin="5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="1" Spacing="20" HorizontalOptions="Center" Margin="0,8">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CircleCheck}"
                                         Command="{Binding ConfirmSelectionCommand}"
                                         Tooltip="{loc:Loc LibConfirm}"
                                         IsEnabled="{Binding HasSelectedRows}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CircleXmark}"
                                         Command="{Binding CancelCommand}"
                                         Tooltip="{loc:Loc LibCancel}"/>
        </HorizontalStackLayout>

    </Grid>
</ContentView>
