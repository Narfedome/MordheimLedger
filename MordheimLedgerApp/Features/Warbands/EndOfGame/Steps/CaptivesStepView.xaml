<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.Steps.CaptivesStepView"
             x:DataType="local:EndOfGamePageViewModel">
            <!-- Étape : Prisonniers ennemis - une seule fois pour toute la bande (pas par guerrier),
                 juste après les étapes Blessure. Ce que CETTE bande a capturé sur l'adversaire, sans
                 rapport avec Capturé (61, l'inverse - un DE NOS guerriers capturé PAR l'adversaire, voir
                 IsInjuryStep). Demandé par l'utilisateur (2026-08-27) en repensant Capturé : la bande
                 adverse n'est pas modélisée, mais NOTRE propre type de bande l'est bien - Tué (Zombie)/
                 Sacrifié (XP) n'apparaissent donc que pour les Morts-Vivants/le Culte des Possédés (voir
                 IsUndeadWarband/IsPossessedWarband), Rançon/Vendu aux esclavagistes toujours proposés. -->
            <VerticalStackLayout Spacing="12">
                <Label Text="{loc:Loc EndOfGameCaptivesHeading}" FontAttributes="Bold"/>
                <!-- Partie connectée (v2, lot 4b) : les guerriers que les adversaires déclarent capturés par cette bande,
                     une carte chacun - proposer une rançon, attendre la réponse, décider du sort sur un refus. À la table
                     = saisi dans la liste habituelle ci-dessous. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ConnectedCaptives}" Spacing="8" IsVisible="{Binding HasConnectedCaptives}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ConnectedCaptiveRow">
                            <Border Style="{StaticResource SectionCardBorderStyle}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Detail}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" IsVisible="{Binding CanOffer}">
                                        <Entry Grid.Column="0" Text="{Binding RansomInput}" Keyboard="Numeric" AutomationId="ConnectedRansomAmount"
                                               Placeholder="{loc:Loc EndOfGameCapturedRansomAmountPh}" WidthRequest="110">
                                            <Entry.Behaviors>
                                                <components:DigitsOnlyBehavior/>
                                            </Entry.Behaviors>
                                        </Entry>
                                        <Button Grid.Column="1" Text="{loc:Loc ConnectedRansomSend}" Padding="12,6" AutomationId="ConnectedRansomSend"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=OfferRansomCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                    <Label Text="{Binding StatusText}" FontSize="13"
                                           IsVisible="{Binding StatusText, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsRefused}">
                                        <components:SelectFieldView Title="{loc:Loc EndOfGameCapturedEnemyFatePh}"
                                                                    ItemsSource="{Binding RefusedFate.FateLabels}"
                                                                    SelectedItem="{Binding RefusedFate.SelectedFateLabel}"/>
                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" IsVisible="{Binding RefusedFate.ShowGoldAmount}">
                                            <Entry Grid.Column="0" Text="{Binding RefusedFate.GoldAmount}" Keyboard="Numeric"
                                                   Placeholder="{loc:Loc EndOfGameCapturedEnemyGoldPh}" WidthRequest="90">
                                                <Entry.Behaviors>
                                                    <components:DigitsOnlyBehavior/>
                                                </Entry.Behaviors>
                                            </Entry>
                                            <components:FaIconButtonView AutomationId="AutoRollButton" Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=AutoRollConnectedSoldToSlaversCommand}"
                                                                          CommandParameter="{Binding .}"
                                                                          Tooltip="{loc:Loc EndOfGameRoll}"/>
                                        </Grid>
                                        <Label Text="{Binding RefusedFate.FateError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                               IsVisible="{Binding RefusedFate.FateError, Converter={StaticResource IsNotNullConverter}}"/>
                                    </VerticalStackLayout>
                                    <Button Text="{loc:Loc ConnectedDecideAtTable}" Style="{StaticResource DialogSecondaryButtonStyle}"
                                            FontSize="12" Padding="8,4" HorizontalOptions="Start"
                                            IsVisible="{Binding CanOffer}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=CaptiveToTableCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <Label Text="{Binding Error}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                           IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <!-- Grid Auto,* plutôt que HorizontalStackLayout (2026-09-01, retour utilisateur -
                     "Corruption de Marquand Volker & Ulli Leitpold (Une Poignée d'Or)" coupé net par le
                     bord du dialog) : dans un HorizontalStackLayout, le Label reçoit une largeur non
                     bornée et ne peut donc jamais retourner à la ligne, quel que soit son
                     LineBreakMode - la colonne * borne sa largeur disponible et laisse le retour à la
                     ligne par défaut faire son travail. -->
                <Border Style="{StaticResource SectionCardBorderStyle}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasCapturedEnemies}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{loc:Loc EndOfGameCapturedEnemiesToggle}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasCapturedEnemies}">
                    <Border Style="{StaticResource SectionCardBorderStyle}">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{loc:Loc EndOfGameCapturedEnemyCountLabel}" VerticalOptions="Center"/>
                            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Minus}" Style="{StaticResource GhostIconButtonStyle}"
                                                          Command="{Binding DecrementCapturedEnemyCountCommand}"/>
                            <Label Text="{Binding CapturedEnemyCount}" WidthRequest="24" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}" Style="{StaticResource GhostIconButtonStyle}"
                                                          Command="{Binding IncrementCapturedEnemyCountCommand}"/>
                        </HorizontalStackLayout>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CapturedEnemies}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:CapturedEnemyEntry">
                                <Border Style="{StaticResource SectionCardBorderStyle}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Index, StringFormat='{0}'}" FontAttributes="Bold"/>
                                        <components:SelectFieldView Title="{loc:Loc EndOfGameCapturedEnemyFatePh}"
                                                ItemsSource="{Binding FateLabels}"
                                                SelectedItem="{Binding SelectedFateLabel}"/>
                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" IsVisible="{Binding ShowGoldAmount}">
                                            <Entry Grid.Column="0" Text="{Binding GoldAmount}" Keyboard="Numeric"
                                                   Placeholder="{loc:Loc EndOfGameCapturedEnemyGoldPh}" WidthRequest="90">
                                                <Entry.Behaviors>
                                                    <components:DigitsOnlyBehavior/>
                                                </Entry.Behaviors>
                                            </Entry>
                                            <components:FaIconButtonView AutomationId="AutoRollButton" Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}" Style="{StaticResource GhostIconButtonStyle}"
                                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=AutoRollSoldToSlaversCommand}"
                                                                          CommandParameter="{Binding .}"
                                                                          Tooltip="{loc:Loc EndOfGameRoll}"/>
                                        </Grid>
                                        <Label Text="{Binding FateError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                               IsVisible="{Binding FateError, Converter={StaticResource IsNotNullConverter}}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>

</ContentView>
