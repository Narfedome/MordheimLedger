<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.SpecialRules.CreateEdit"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.SpecialRules.CreateEdit.SpecialRuleDetailDialog"
               x:DataType="local:SpecialRuleDetailDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <ScrollView x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}"
                       Style="{StaticResource DialogTitleLabelStyle}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Xmark}"
                                              IconSize="14" ButtonWidthRequest="24" ButtonHeightRequest="24"
                                              Command="{Binding CancelCommand}"/>
            </Grid>
            <VerticalStackLayout Spacing="4">
                <Label Text="{loc:Loc LibDescriptionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Label Text="{Binding Item.Description}" TextColor="{DynamicResource AppText}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4" IsVisible="{Binding Item.CostMultiplier, Converter={StaticResource IsNotNullConverter}}">
                <Label Text="{loc:Loc SpecialRuleCostMultiplierPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Label Text="{Binding Item.CostMultiplier, StringFormat='×{0}'}" TextColor="{DynamicResource AppText}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4" IsVisible="{Binding Item.Abbreviation, Converter={StaticResource IsNotNullConverter}}">
                <Label Text="{loc:Loc SpecialRuleAbbreviationPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Label Text="{Binding Item.Abbreviation}" TextColor="{DynamicResource AppText}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4" IsVisible="{Binding Item.Rarity, Converter={StaticResource IsNotNullConverter}}">
                <Label Text="{loc:Loc EquipmentItemRarityPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Label Text="{Binding Item.Rarity}" TextColor="{DynamicResource AppText}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
        </ScrollView>
    </Border>
</dialogs:DialogContent>
