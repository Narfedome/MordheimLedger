<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               x:TypeArguments="system:Int32"
               x:Class="MordheimLedgerApp.Components.Dialogs.ActionSheetDialog"
               x:DataType="dialogs:ActionSheetDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0">
    <Border Style="{StaticResource DialogCardBorderStyle}">
        <VerticalStackLayout Spacing="16">
            <!-- ✕ dans l'en-tête plutôt qu'un bouton Annuler en pied (refonte de novembre 2026) - un tap à côté
                 ferme aussi. -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}" Style="{StaticResource DialogTitleLabelStyle}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Xmark}"
                                              IconSize="14" ButtonWidthRequest="36" ButtonHeightRequest="36"
                                              Command="{Binding CancelCommand}"/>
            </Grid>
            <components:ScrollHintHost>
            <ScrollView MaximumHeightRequest="{x:Static dialogs:DialogSizing.MaxListHeight}">
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:ActionSheetOption">
                            <Grid>
                                <Label Text="{Binding Label}" IsVisible="{Binding IsHeader}"
                                       FontAttributes="Bold" FontSize="12" Margin="4,8,4,2"
                                       TextColor="{DynamicResource AppTextMuted}"/>
                                <Button Text="{Binding Label}"
                                        IsVisible="{Binding IsHeader, Converter={StaticResource InverseBoolConverter}}"
                                        Style="{StaticResource DialogOptionButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type dialogs:ActionSheetDialogViewModel}}, Path=SelectCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
            </components:ScrollHintHost>
        </VerticalStackLayout>
    </Border>
</dialogs:DialogContent>
