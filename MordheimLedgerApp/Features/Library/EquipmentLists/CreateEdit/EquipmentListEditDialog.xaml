<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.EquipmentLists.CreateEdit"
               xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.EquipmentLists.CreateEdit.EquipmentListEditDialog"
               x:DataType="local:EquipmentListEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <Grid RowDefinitions="*,Auto" RowSpacing="16">
        <ScrollView Grid.Row="0" x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>

            <HorizontalStackLayout Spacing="16">
                <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabGeneral}" Command="{Binding ShowGeneralTabCommand}"
                                             IsActive="{Binding IsGeneralTab}" FontSize="12"/>
                <components:TabToggleButton Text="{loc:Loc EquipmentListItemsPh}" Command="{Binding ShowItemsTabCommand}"
                                             IsActive="{Binding IsItemsTab}" FontSize="12"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGeneralTab}">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="12" TextColor="{DynamicResource AppTextMuted}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc EquipmentListNamePh}"/>
                                <Span Text=" *" TextColor="{StaticResource AppDanger}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry Text="{Binding Item.Name}"/>
                    <Label Text="{Binding NameError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                           IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Objets de la liste : ajoutés/retirés via le picker Équipement existant (déjà multi-
                 sélection). -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsItemsTab}">
                <components:ChipListView HeaderText="{loc:Loc EquipmentListItemsPh}"
                                          ItemsSource="{Binding Items}"                                         
                                      Command="{Binding ShowItemDetailCommand}"
                                          IconGlyph="{x:Static icons:SolidFont.Coins}"
                                          AddCommand="{Binding AddItemCommand}"
                                          RemoveCommand="{Binding RemoveItemCommand}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="{loc:Loc BtnCancel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="1"
                    Text="{loc:Loc BtnSave}"
                    Command="{Binding SaveCommand}"/>
        </Grid>
        </Grid>
    </Border>
</dialogs:DialogContent>
