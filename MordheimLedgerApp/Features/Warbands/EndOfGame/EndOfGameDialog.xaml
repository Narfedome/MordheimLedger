<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.EndOfGameDialog"
               x:DataType="local:EndOfGameDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="380">
        <ScrollView x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout Spacing="16">
            <Label Text="{loc:Loc EndOfGameTitle}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>
            <Label Text="{Binding StepLabel}" TextColor="{DynamicResource AppTextMuted}"/>

            <!-- Étape 1 : Résultat (contexte pour la phrase d'Historique - pas une étape du livre) -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep0}">
                <Picker Title="{loc:Loc EndOfGameResultPh}"
                        ItemsSource="{Binding ResultOptions}"
                        SelectedItem="{Binding SelectedResult}"/>
            </VerticalStackLayout>

            <!-- Étape 2 : Blessures Graves (livre de règles, étape 1 de la séquence d'après-bataille) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsStep1}">
                <Label Text="{loc:Loc EndOfGameInjuriesHeading}" FontAttributes="Bold"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <Border Style="{StaticResource SectionCardBorderStyle}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"/>
                                        <!-- Héros et Hommes de main ont des tables de Blessures Graves
                                             totalement différentes (D66 vs D6) - toujours afficher le
                                             rôle pour lever l'ambiguïté. -->
                                        <Label Grid.Column="1" Text="{Binding RoleLabel}" TextColor="{DynamicResource AppTextMuted}"/>
                                        <!-- Statut auto-géré : passe à Mort tout seul sur un résultat de
                                             mort (voir ApplyInjuryRoll), pas de saisie manuelle. -->
                                        <Label Grid.Column="2" Text="{loc:Loc EndOfGameDeadLabel}"
                                               IsVisible="{Binding IsDead}"
                                               TextColor="{DynamicResource AppDanger}" FontAttributes="Bold"/>
                                    </Grid>
                                    <HorizontalStackLayout Spacing="10">
                                        <CheckBox IsChecked="{Binding IsOutOfAction}" VerticalOptions="Center"/>
                                        <Label Text="{loc:Loc EndOfGameOutOfAction}" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <!-- Le joueur peut soit laisser l'appli tirer les dés (Dice = jet
                                         aléatoire + popup de résultat immédiate), soit lancer ses propres
                                         dés à la table et saisir le score lui-même (Entry + Eye = affiche
                                         le résultat correspondant sans en tirer un nouveau). -->
                                    <Grid IsVisible="{Binding ShowInjuryTools}" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                        <Entry Grid.Column="0" Text="{Binding ManualRoll}" Keyboard="Numeric"
                                               Placeholder="{Binding RollPlaceholder}" WidthRequest="70"/>
                                        <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}"
                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=AutoRollCommand}"
                                                                      CommandParameter="{Binding .}"
                                                                      Tooltip="{loc:Loc EndOfGameRoll}"/>
                                        <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Eye}"
                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=ShowInjuryResultCommand}"
                                                                      CommandParameter="{Binding .}"
                                                                      Tooltip="{loc:Loc EndOfGameShowResult}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Étape 3 : Expérience (livre, étape 2 - saisie libre, pas de calcul assisté). Pas de
                 Statut ici : entièrement auto-géré depuis l'étape Blessures Graves. Le jet de
                 progression (palier franchi) est déplacé dans sa propre étape juste après, voir
                 IsStep3 - un guerrier peut franchir plusieurs paliers d'un coup, ça ne tient plus sur
                 une carte imbriquée ici. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsStep2}">
                <Label Text="{loc:Loc EndOfGameExperienceHeading}" FontAttributes="Bold"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <!-- Un guerrier mort (Blessures Graves, étape précédente) ne gagne plus
                                 d'XP - retiré de cette étape plutôt que juste grisé. -->
                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    IsVisible="{Binding IsDead, Converter={StaticResource InverseBoolConverter}}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="{Binding RoleLabel}" TextColor="{DynamicResource AppTextMuted}"/>
                                    </Grid>
                                    <Entry Text="{Binding ExperienceGained}" Keyboard="Numeric"
                                           Placeholder="{loc:Loc EndOfGameXpPh}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Étape 4 : Progression - seulement si au moins un guerrier a franchi un palier d'XP à
                 l'étape précédente (HasAnyMilestone, voir ActiveSteps dans le ViewModel : le wizard
                 saute carrément cette étape sinon, elle n'apparaît jamais dans la navigation Next/Back
                 ni dans la numérotation StepLabel). Un guerrier qui saute plusieurs paliers d'un coup a
                 une carte par palier (AdvanceRolls), chacune avec ses propres outils Tirer/Voir le
                 résultat - même principe que les Blessures Graves, purement descriptif. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsStep3}">
                <Label Text="{loc:Loc EndOfGameAdvanceHeading}" FontAttributes="Bold"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <Border Style="{StaticResource SectionCardBorderStyle}" IsVisible="{Binding HasMilestone}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="{Binding RoleLabel}" TextColor="{DynamicResource AppTextMuted}"/>
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AdvanceRolls}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="local:AdvanceRollEntry">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding Label}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                                        <Entry Grid.Column="0" Text="{Binding ManualRoll}" Keyboard="Numeric"
                                                               Placeholder="{loc:Loc EndOfGameAdvanceRollPh}" WidthRequest="70"/>
                                                        <components:FaIconButtonView Grid.Column="1" Icon="{x:Static icons:SolidFont.Dice}"
                                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=AutoRollAdvanceCommand}"
                                                                                      CommandParameter="{Binding .}"
                                                                                      Tooltip="{loc:Loc EndOfGameRoll}"/>
                                                        <components:FaIconButtonView Grid.Column="2" Icon="{x:Static icons:SolidFont.Eye}"
                                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=ShowAdvanceResultCommand}"
                                                                                      CommandParameter="{Binding .}"
                                                                                      Tooltip="{loc:Loc EndOfGameShowResult}"/>
                                                    </Grid>
                                                    <Label Text="{Binding ResultText}" FontSize="12"/>
                                                    <!-- Résultat "Compétence" (Héros 2-5/10-12 uniquement, voir
                                                         HeroAdvanceTable.IsSkill) : choix direct dans la Bibliothèque,
                                                         rattachée au guerrier à l'enregistrement du wizard. -->
                                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSkillResult}">
                                                        <Button Text="{loc:Loc EndOfGamePickSkill}"
                                                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                                                FontSize="12" Padding="8,4"
                                                                IsVisible="{Binding HasSkillSelected, Converter={StaticResource InverseBoolConverter}}"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGameDialogViewModel}}, Path=PickAdvanceSkillCommand}"
                                                                CommandParameter="{Binding .}"/>
                                                        <Label Text="{Binding SelectedSkillsText}" FontSize="12"
                                                               FontAttributes="Bold" TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"
                                                               IsVisible="{Binding HasSkillSelected}"/>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Étape 5 : Revenus (livre, étape 3 - trésor trouvé) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsStep4}">
                <Label Text="{loc:Loc EndOfGameTreasuryHeading}" FontAttributes="Bold"/>
                <Entry Text="{Binding TreasuryFound}" Keyboard="Numeric" Placeholder="{loc:Loc EndOfGameTreasuryPh}"/>
            </VerticalStackLayout>

            <!-- Étape 6 : Récapitulatif (pas une étape du livre - relecture avant d'enregistrer) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsStep5}">
                <Label Text="{loc:Loc EndOfGameRecapHeading}" FontAttributes="Bold"/>
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Loc EndOfGameResultPh}"/>
                            <Span Text=" : "/>
                            <Span Text="{Binding SelectedResult}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Loc EndOfGameTreasuryPh}"/>
                            <Span Text=" : "/>
                            <Span Text="{Binding TreasuryFound}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WarriorRows}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:WarriorOutcomeRow">
                            <Label Text="{Binding SummaryText}" FontSize="13"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc LibBack}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"/>
                <Button Grid.Column="2"
                        Text="{loc:Loc LibNext}"
                        Command="{Binding NextCommand}"
                        IsVisible="{Binding IsLastStep, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Grid.Column="2"
                        Text="{loc:Loc BtnSave}"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding IsLastStep}"/>
            </Grid>
        </VerticalStackLayout>
        </ScrollView>
    </Border>
</dialogs:DialogContent>
