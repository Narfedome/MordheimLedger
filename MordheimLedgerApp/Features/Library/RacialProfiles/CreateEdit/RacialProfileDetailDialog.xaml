<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.RacialProfiles.CreateEdit"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.RacialProfiles.CreateEdit.RacialProfileDetailDialog"
               x:DataType="local:RacialProfileDetailDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0">
    <Border Style="{StaticResource DialogCardBorderStyle}">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}"
                       Style="{StaticResource DialogTitleLabelStyle}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Xmark}"
                                              IconSize="14" ButtonWidthRequest="24" ButtonHeightRequest="24"
                                              Command="{Binding CancelCommand}"/>
            </Grid>
            <dialogs:AnimatedHeightScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16">

                    <!-- Grille des 9 maximums en lecture seule - même composant/mêmes libellés que le profil
                         d'un WarriorArchetype (StatRowView), voir RacialProfile pour pourquoi les noms de champ
                         ne portent pas de préfixe "Max". -->
                    <components:StatRowView Item="{Binding Item}" MovementText="{Binding Item.MovementDisplay}"/>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding Item.Description, Converter={StaticResource IsNotNullConverter}}">
                        <Label Text="{loc:Loc LibDescriptionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Label Text="{Binding Item.Description}" TextColor="{DynamicResource AppText}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </dialogs:AnimatedHeightScrollView>
        </Grid>
    </Border>
</dialogs:DialogContent>
