<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.Steps.PairEngagementStepView"
             x:DataType="local:EndOfGamePageViewModel">
            <!-- Étape : Une Poignée d'Or - une carte par personnage ou duo portant la règle (FistfulOfCrownsEntry,
                 2026-11-14). Corruption si la bande ne l'a pas, Rétention si elle l'a ; « Où est l'Argent ? » sous la
                 carte quand elle ne peut pas payer en or (réglé automatiquement, dans l'ordre des cartes). -->
            <VerticalStackLayout Spacing="12">
                <Label Text="{loc:Loc EndOfGamePairEngagementHeading}" FontAttributes="Bold"/>
                <Label Text="{Binding DramatisPersonaeBaselineTreasuryDisplay}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding FistfulOfCrownsEntries}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:FistfulOfCrownsEntry">
                            <Border Style="{StaticResource SectionCardBorderStyle}" IsVisible="{Binding IsActive}">
                                <VerticalStackLayout Spacing="6">
                                    <!-- Corruption : Grid Auto,* (un HorizontalStackLayout ne laisse jamais le libellé
                                         passer à la ligne). -->
                                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowCorruption}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding WantsToRecordCorruption}" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding CorruptionLabel}" VerticalOptions="Center"/>
                                        </Grid>
                                        <Label Text="{loc:Loc EndOfGamePairCorruptionHint}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                        <VerticalStackLayout Spacing="4" IsVisible="{Binding WantsToRecordCorruption}">
                                            <Entry Text="{Binding CorruptionAmount}" Keyboard="Numeric"
                                                   Placeholder="{loc:Loc EndOfGamePairCorruptionAmountPh}" WidthRequest="120" HorizontalOptions="Start">
                                                <Entry.Behaviors>
                                                    <components:DigitsOnlyBehavior/>
                                                </Entry.Behaviors>
                                            </Entry>
                                            <Label Text="{Binding CorruptionError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                                                   IsVisible="{Binding CorruptionError, Converter={StaticResource IsNotNullConverter}}"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Rétention : champ libre, 0/vide = aucune tentative adverse cette partie. -->
                                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowRetention}">
                                        <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                        <Label Text="{loc:Loc EndOfGamePairRetentionHint}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                        <Entry Text="{Binding RetentionAmount}" Keyboard="Numeric"
                                               Placeholder="{loc:Loc EndOfGamePairCorruptionAmountPh}" WidthRequest="120" HorizontalOptions="Start">
                                            <Entry.Behaviors>
                                                <components:DigitsOnlyBehavior/>
                                            </Entry.Behaviors>
                                        </Entry>
                                    </VerticalStackLayout>

                                    <!-- Où est l'Argent ? -->
                                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsUnaffordable}">
                                        <Label Text="{loc:Loc EndOfGameWheresMoneyHeading}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource AppDanger}"/>
                                        <Label Text="{loc:Loc EndOfGameWheresMoneyHint}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                        <VerticalStackLayout Spacing="4" IsVisible="{Binding WantsEquipmentSeizure}">
                                            <Label Text="{Binding SeizedEquipmentTotalDisplay}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SeizedEquipmentItems}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="local:ReserveLine">
                                                        <components:ChipView Item="{Binding .}"
                                                                              IconGlyph="{Binding Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                                              IconFontFamily="RpgAwesome"/>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                        <Label Text="{loc:Loc EndOfGameWheresMoneyDuelNote}" FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource AppDanger}" IsVisible="{Binding WantsDuel}"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

</ContentView>
