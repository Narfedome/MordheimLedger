<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Class="MordheimLedgerApp.Components.DetailPageHeader.DetailPageHeaderView"
             x:Name="root">
    <!-- Custom header for pages pushed via Shell routes, used instead of Shell's native nav bar: on
         Windows the native back arrow sits in the unthemed native title bar, above the Shell's own
         styled title — two stacked bars that don't match. The host page must set
         Shell.NavBarIsVisible="False" and hide Shell.BackButtonBehavior. -->
    <Grid ColumnDefinitions="auto,*" Margin="16,8">
        <components:FaIconButtonView Grid.Column="0"
                                      Style="{StaticResource GhostIconButtonStyle}"
                                      Icon="{x:Static icons:SolidFont.ChevronLeft}"
                                      IsVisible="{Binding Source={x:Reference root}, Path=ShowBack}"
                                      Command="{Binding Source={x:Reference root}, Path=BackCommand}"/>
        <Label Grid.Column="1" Text="{Binding Source={x:Reference root}, Path=Title}"
               FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"
               Padding="8,0" VerticalOptions="Center"/>
    </Grid>
</ContentView>
