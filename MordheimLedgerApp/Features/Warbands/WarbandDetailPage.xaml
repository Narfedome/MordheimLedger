<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MordheimLedgerApp.Features.Warbands"
             xmlns:models="clr-namespace:MordheimLedgerApp.Core.Models;assembly=MordheimLedgerApp.Core"
             xmlns:header="clr-namespace:MordheimLedgerApp.Components.DetailPageHeader"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:xp="clr-namespace:MordheimLedgerApp.Components.ExperienceTrack"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             x:Class="MordheimLedgerApp.Features.Warbands.WarbandDetailPage"
             x:DataType="vm:WarbandDetailViewModel"
             Shell.NavBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Carte guerrier partagée entre les sections Heroes/Henchmen : le contenu ne dépend que
                 du Warrior lié (IsHero pilote directement ExperienceTrackView), pas du groupe qui
                 l'affiche. -->
            <DataTemplate x:Key="WarriorCardTemplate" x:DataType="vm:WarriorRow">
                <Border Style="{StaticResource SectionCardBorderStyle}" Margin="12,6">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" Text="{Binding Warrior.Name}" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"/>
                            <Label Grid.Column="1" Text="{Binding RoleName}" TextColor="{DynamicResource AppAccent}" FontSize="12" VerticalOptions="Center"/>
                            <components:FaIconButtonView Grid.Column="2" Style="{StaticResource GhostIconButtonStyle}"
                                                          Icon="{x:Static icons:SolidFont.Pen}"
                                                          IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=EditWarriorCommand}"
                                                          CommandParameter="{Binding .}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0" Text="M" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Grid.Row="0" Grid.Column="1" Text="WS" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Grid.Row="0" Grid.Column="2" Text="BS" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Grid.Row="0" Grid.Column="3" Text="S" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Grid.Row="0" Grid.Column="4" Text="T" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Grid.Row="0" Grid.Column="5" Text="W" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Grid.Row="0" Grid.Column="6" Text="I" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Grid.Row="0" Grid.Column="7" Text="A" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Grid.Row="0" Grid.Column="8" Text="Ld" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Warrior.Movement}" FontSize="13" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Warrior.WeaponSkill}" FontSize="13" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="2" Text="{Binding Warrior.BallisticSkill}" FontSize="13" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="3" Text="{Binding Warrior.Strength}" FontSize="13" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="4" Text="{Binding Warrior.Toughness}" FontSize="13" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="5" Text="{Binding Warrior.Wounds}" FontSize="13" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="6" Text="{Binding Warrior.Initiative}" FontSize="13" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="7" Text="{Binding Warrior.Attacks}" FontSize="13" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="8" Text="{Binding Warrior.Leadership}" FontSize="13" HorizontalTextAlignment="Center"/>
                        </Grid>

                        <!-- Blessures : lecture seule ici (pas de bouton "+"/"x") - gérées depuis le
                             dialog d'édition (voir WarriorEditDialog). Alimenté à la fois par le jet de
                             Fin de partie et par les ajouts manuels. Même style de puce que
                             Équipement/Compétences. -->
                        <VerticalStackLayout Spacing="2" IsVisible="{Binding HasInjuries}">
                            <Label Text="{loc:Loc WarriorsInjuriesHeading}" FontSize="10" TextColor="{DynamicResource AppTextMuted}"/>
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Injuries}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WarriorInjury">
                                        <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="{x:Static icons:RpgFont.RaBrokenBone}"
                                                       FontFamily="RpgAwesome" FontSize="12"
                                                       TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                                <Label Text="{Binding Item.Name}" FontSize="11" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Loc WarriorsEquipmentHeading}" FontSize="10" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                            <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                          Icon="{x:Static icons:SolidFont.Plus}"
                                                          IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=AddEquipmentCommand}"
                                                          CommandParameter="{Binding .}"/>
                        </Grid>
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Equipment}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:WarriorEquipment">
                                    <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                                   FontFamily="RpgAwesome" FontSize="12"
                                                   TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                            <Label Text="{Binding Item.Name}" FontSize="11" VerticalOptions="Center"/>
                                            <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                          Icon="{x:Static icons:SolidFont.Xmark}"
                                                                          IconSize="10" ButtonWidthRequest="18" ButtonHeightRequest="18"
                                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=RemoveEquipmentCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Loc WarriorsSkillsHeading}" FontSize="10" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                            <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                          Icon="{x:Static icons:SolidFont.Plus}"
                                                          IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=AddSkillCommand}"
                                                          CommandParameter="{Binding .}"/>
                        </Grid>
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Skills}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:WarriorSkill">
                                    <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding Item.Category, Converter={StaticResource SkillCategoryIconConverter}}"
                                                   FontFamily="RpgAwesome" FontSize="12"
                                                   TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                            <Label Text="{Binding Item.Name}" FontSize="11" VerticalOptions="Center"/>
                                            <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                          Icon="{x:Static icons:SolidFont.Xmark}"
                                                                          IconSize="10" ButtonWidthRequest="18" ButtonHeightRequest="18"
                                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WarbandDetailViewModel}}, Path=RemoveSkillCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Label Text="{loc:Loc WarriorsExperienceHeading}" FontSize="10" TextColor="{DynamicResource AppTextMuted}"/>
                        <xp:ExperienceTrackView Experience="{Binding Warrior.Experience}" IsHero="{Binding Warrior.IsHero}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <components:WatermarkedLayout>
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid Grid.Row="0" x:Name="Header" ColumnDefinitions="*,Auto">
            <header:DetailPageHeaderView Grid.Column="0" Title="{Binding Warband.Name}" BackCommand="{Binding BackCommand}"/>
            <components:IconTextButton Grid.Column="1" Margin="0,0,16,0"
                                        Icon="{x:Static icons:SolidFont.FlagCheckered}"
                                        Text="{loc:Loc EndOfGameTitle}"
                                        TextColor="{DynamicResource AppAccent}"
                                        Command="{Binding EndOfGameCommand}"/>
        </Grid>

        <Label Grid.Row="1" Margin="16,0,16,8" TextColor="{DynamicResource AppTextMuted}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{loc:Loc WarbandsTreasuryLabel}"/>
                    <Span Text="{Binding Warband.Treasury, StringFormat=' {0} gc'}"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!-- Roster / Historique : pas de précédent DmTools pour des "onglets" internes à une page de
             détail - toggle minimal (deux boutons + IsVisible) plutôt qu'un vrai TabbedPage/Shell tab.
             Recruter vit ici (pas en bas de page, isolé) car il n'a de sens que sur l'onglet Roster -
             même logique que "Ajouter une note" ci-dessous, contextuel à l'onglet Historique. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="16,0,16,8">
            <HorizontalStackLayout Grid.Column="0" Spacing="16">
                <Button Text="{loc:Loc TabRoster}" Command="{Binding ShowRosterCommand}"
                        BackgroundColor="Transparent" TextColor="{DynamicResource AppAccent}" Padding="0"/>
                <Button Text="{loc:Loc TabHistory}" Command="{Binding ShowHistoryTabCommand}"
                        BackgroundColor="Transparent" TextColor="{DynamicResource AppAccent}" Padding="0"/>
            </HorizontalStackLayout>
            <components:IconTextButton Grid.Column="1"
                                        IsVisible="{Binding ShowHistory, Converter={StaticResource InverseBoolConverter}}"
                                        Icon="{x:Static icons:SolidFont.Plus}"
                                        Text="{loc:Loc BtnRecruit}"
                                        TextColor="{DynamicResource AppAccent}"
                                        Command="{Binding RecruitWarriorCommand}"/>
        </Grid>

        <!-- Pas de CollectionView ici (virtualisation inutile pour un roster de quelques dizaines de
             guerriers max, et une CollectionView imbriquée dans un ScrollView pose des soucis de
             hauteur) : un simple ScrollView + BindableLayout par groupe. -->
        <ScrollView Grid.Row="3" x:Name="RosterScroll" IsVisible="{Binding ShowHistory, Converter={StaticResource InverseBoolConverter}}">
            <VerticalStackLayout Spacing="0" Margin="0,8">

                <Grid Padding="16,10,16,4" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleHeroesCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc WarriorsGroupHeroes}"/>
                                <Span Text="{Binding Heroes.Count, StringFormat=' · {0}'}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{Binding HeroesExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                  Command="{Binding ToggleHeroesCommand}"/>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding HeroesExpanded}"
                                     BindableLayout.ItemsSource="{Binding Heroes}"
                                     BindableLayout.ItemTemplate="{StaticResource WarriorCardTemplate}"/>

                <Grid Padding="16,10,16,4" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleHenchmenCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc WarriorsGroupHenchmen}"/>
                                <Span Text="{Binding Henchmen.Count, StringFormat=' · {0}'}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                                  Icon="{Binding HenchmenExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                  Command="{Binding ToggleHenchmenCommand}"/>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding HenchmenExpanded}"
                                     BindableLayout.ItemsSource="{Binding Henchmen}"
                                     BindableLayout.ItemTemplate="{StaticResource WarriorCardTemplate}"/>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="0,8" IsVisible="{Binding ShowHistory}">
            <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="16,0,16,8">
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                     Command="{Binding AddNoteCommand}"
                                     Tooltip="{loc:Loc HistoryAddNote}"/>
            </HorizontalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding HistoryEntries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryEntry">
                        <Border Style="{StaticResource SectionCardBorderStyle}" Margin="12,6">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Date, StringFormat='{0:g}'}" FontSize="12"
                                       TextColor="{DynamicResource AppTextMuted}"/>
                                <Label Text="{Binding Text}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
    </components:WatermarkedLayout>
</ContentPage>
