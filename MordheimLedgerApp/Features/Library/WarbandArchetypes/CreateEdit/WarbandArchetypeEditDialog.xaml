<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.WarbandArchetypes.CreateEdit"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.WarbandArchetypes.CreateEdit.WarbandArchetypeEditDialog"
               x:DataType="local:WarbandArchetypeEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <Grid RowDefinitions="*,Auto" RowSpacing="16">
            <ScrollView Grid.Row="0" x:Name="ContentScroll" VerticalOptions="Start">
                <VerticalStackLayout x:Name="RootContent" Spacing="16" SizeChanged="OnRootContentSizeChanged">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding Title}"
                       Style="{StaticResource DialogTitleLabelStyle}" VerticalOptions="Center"/>
                        <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Xmark}"
                                              IconSize="14" ButtonWidthRequest="24" ButtonHeightRequest="24"
                                              Command="{Binding CancelCommand}"/>
                    </Grid>

                    <!-- Création (IsWizardMode) : pas à pas, ordre fixe Général→Règles→Magie→Équipement→Guerriers
                 (les listes d'équipement doivent exister avant qu'un guerrier puisse en choisir une - voir
                 AddWarrior) - onglets remplacés par un simple libellé d'étape, navigation via
                 Précédent/Suivant en bas. Édition : mêmes 5 onglets que WarbandArchetypeDetailDialog,
                 librement navigables. Champs modifiables (Entry/Editor/Picker au lieu de Label) et
                 Guerriers/Équipement en CRUD inline via ChipListView.AddCommand/RemoveCommand plutôt qu'en
                 lecture seule, dans les deux cas. -->
                    <!-- ScrollableTabStripView (générique, ne connaît pas IsWizardMode) factorise juste le
                 conteneur scrollable, même composant que WarbandEditDialog.xaml - évite le débordement
                 des 5 onglets dans ce dialog large de 340px. -->
                    <Label Text="{Binding StepLabel}" TextColor="{DynamicResource AppTextMuted}"
                   IsVisible="{Binding IsWizardMode}"/>
                    <components:ScrollableTabStripView IsVisible="{Binding IsWizardMode, Converter={StaticResource InverseBoolConverter}}">
                        <HorizontalStackLayout Spacing="16">
                            <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabGeneral}" Command="{Binding ShowGeneralTabCommand}"
                                                 IsActive="{Binding IsGeneralTab}" FontSize="12"/>
                            <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabRules}" Command="{Binding ShowRulesTabCommand}"
                                                 IsActive="{Binding IsRulesTab}" FontSize="12"/>
                            <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabMagic}" Command="{Binding ShowMagicTabCommand}"
                                                 IsActive="{Binding IsMagicTab}" FontSize="12"/>
                            <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabEquipment}" Command="{Binding ShowEquipmentTabCommand}"
                                                 IsActive="{Binding IsEquipmentTab}" FontSize="12"/>
                            <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabWarriors}" Command="{Binding ShowWarriorsTabCommand}"
                                                 IsActive="{Binding IsWarriorsTab}" FontSize="12"/>
                        </HorizontalStackLayout>
                    </components:ScrollableTabStripView>

                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGeneralTab}">
                        <VerticalStackLayout Spacing="4">
                            <!-- Astérisque = champ obligatoire (marqueur statique) ; Label d'erreur en dessous =
                         retour dynamique (posé par ValidateGeneralStep, vérifié par étape au clic sur
                         Suivant en mode assistant, sur Enregistrer en mode édition) - les deux coexistent,
                         l'un indique la règle, l'autre signale qu'elle n'est pas respectée. -->
                            <Label FontSize="12" TextColor="{DynamicResource AppTextMuted}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{loc:Loc WarbandArchetypeNamePh}"/>
                                        <Span Text=" *" TextColor="{StaticResource AppDanger}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Entry Text="{Binding Item.Name}"/>
                            <Label Text="{Binding NameError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                           IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}"/>
                        </VerticalStackLayout>
                        <Picker Title="{loc:Loc WarbandGradePh}"
                        ItemsSource="{Binding GradeOptions}"
                        SelectedItem="{Binding SelectedGradeLabel}"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{loc:Loc WarbandArchetypeTreasuryPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                                <Entry Text="{Binding Item.StartingTreasury}" Keyboard="Numeric"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{loc:Loc WarbandArchetypeMinWarriorsPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                                <Entry Text="{Binding Item.MinWarriors}" Keyboard="Numeric"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="{loc:Loc WarbandArchetypeMaxWarriorsPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                                <Entry Text="{Binding Item.MaxWarriors}" Keyboard="Numeric"/>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Loc LibDescriptionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                            <Editor Text="{Binding Item.Description}" HeightRequest="80"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsRulesTab}">
                        <components:ChipListView HeaderText="{loc:Loc LibSpecialRulesPh}"
                                          ItemsSource="{Binding SpecialRules}"
                                          IconGlyph="{x:Static icons:SolidFont.Scroll}"
                                          Command="{Binding ShowSpecialRuleDetailCommand}"
                                          AddCommand="{Binding AddSpecialRuleCommand}"
                                          RemoveCommand="{Binding RemoveSpecialRuleCommand}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsMagicTab}">
                        <components:ChipListView HeaderText="{loc:Loc LibMagicSchoolsPh}"
                                          ItemsSource="{Binding MagicSchools}"
                                          IconGlyph="{x:Static icons:RpgFont.RaCrystalBall}"
                                          IconFontFamily="RpgAwesome"
                                          Command="{Binding ShowMagicSchoolDetailCommand}"
                                          AddCommand="{Binding AddMagicSchoolCommand}"
                                          RemoveCommand="{Binding RemoveMagicSchoolCommand}"/>
                    </VerticalStackLayout>

                    <!-- Guerriers/Équipement se chargent au premier passage sur leur onglet/étape, comme le récap
                 en lecture seule - toujours vide pour une bande en cours de création (Item.Id == 0), voir
                 EnsureWarriorsLoadedAsync/EnsureEquipmentListsLoadedAsync. Équipement avant Guerriers
                 (ordre inverse du visuel Codex) : un guerrier a besoin des listes d'équipement de la
                 bande pour choisir la sienne, voir AddWarrior. -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEquipmentTab}">
                        <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                                   HorizontalOptions="Center" WidthRequest="60" HeightRequest="60"/>
                        <components:ChipListView ItemsSource="{Binding EquipmentLists}"
                                          HeaderText="{loc:Loc WarbandArchetypeTabEquipment}"
                                          IconGlyph="{x:Static icons:SolidFont.ListCheck}"
                                          Command="{Binding EditEquipmentListCommand}"
                                          AddCommand="{Binding AddEquipmentListCommand}"
                                          RemoveCommand="{Binding RemoveEquipmentListCommand}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsWarriorsTab}">
                        <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                                   HorizontalOptions="Center" WidthRequest="60" HeightRequest="60"/>
                        <!-- Regroupé en deux sections Héros/Hommes de main (icônes Crown/Shield) plutôt qu'une
                             liste plate sans distinction - voir WarriorRoleChipListView. -->
                        <components:WarriorRoleChipListView ItemsSource="{Binding Warriors}"
                                          Command="{Binding EditWarriorCommand}"
                                          AddCommand="{Binding AddWarriorCommand}"
                                          RemoveCommand="{Binding RemoveWarriorCommand}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Boutons toujours ancrés en bas du dialog (ligne Auto de la Grid englobante, hors ScrollView) -
             plutôt que collés au contenu de l'onglet/étape courante, dont la hauteur varie. -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding IsWizardMode}">
                <Button Grid.Column="0"
                    Text="{loc:Loc BtnCancel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                    Text="{loc:Loc LibBack}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding BackCommand}"
                    IsEnabled="{Binding CanGoBack}"/>
                <Button Grid.Column="2"
                    Text="{loc:Loc LibNext}"
                    Command="{Binding NextCommand}"
                    IsVisible="{Binding IsLastStep, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Grid.Column="2"
                    Text="{loc:Loc BtnSave}"
                    Command="{Binding SaveCommand}"
                    IsVisible="{Binding IsLastStep}"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsWizardMode, Converter={StaticResource InverseBoolConverter}}">
                <Button Grid.Column="0"
                    Text="{loc:Loc BtnCancel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                    Text="{loc:Loc BtnSave}"
                    Command="{Binding SaveCommand}"/>
            </Grid>
        </Grid>
    </Border>
</dialogs:DialogContent>
