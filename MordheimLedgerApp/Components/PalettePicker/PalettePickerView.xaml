<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Components.PalettePicker.PalettePickerView">
    <!-- Un Border par palette (comme DmTools) plutôt qu'un ItemsSource : une seule entrée pour
         l'instant (Cendre & Wyrdstone), copier ce bloc pour en ajouter une nouvelle. -->
    <Grid ColumnDefinitions="*" ColumnSpacing="8">

        <!-- A: Cendre & Wyrdstone -->
        <Border x:Name="BorderA" Grid.Column="0" HeightRequest="90" StrokeShape="RoundRectangle 10" StrokeThickness="1">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="SelectA"/>
            </Border.GestureRecognizers>
            <Grid RowDefinitions="*,26">
                <Grid Grid.Row="0" ColumnDefinitions="*,*">
                    <BoxView Grid.Column="0" Color="#17151A"/>
                    <BoxView Grid.Column="1" Color="#EDE7D9"/>
                </Grid>
                <BoxView Grid.Row="0" HeightRequest="5" VerticalOptions="End" Color="#7FA34F"/>
                <Label Grid.Row="1" Text="Cendre &amp; Wyrdstone" FontSize="{OnIdiom Default=10, Desktop=9}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</ContentView>
