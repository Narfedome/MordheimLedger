<?xml version="1.0" encoding="utf-8" ?>
<!-- Remplace le Picker natif (boîte système hors thème sur Android, « Cancel » en anglais) : champ au
     style des Entry de l'appli qui ouvre l'ActionSheetDialog thémé au tap. Voir SelectFieldView.xaml.cs. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             x:Class="MordheimLedgerApp.Components.SelectFieldView"
             x:Name="Root">
    <Grid x:Name="Field" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8"
          MinimumHeightRequest="{DynamicResource AppMinTouchTarget}" BackgroundColor="Transparent">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </Grid.GestureRecognizers>
        <Label x:Name="ValueLabel" Grid.Column="0" VerticalOptions="Center" Margin="4,0,0,0"
               FontFamily="OpenSansRegular" FontSize="{DynamicResource AppFontSizeBase}"
               LineBreakMode="TailTruncation" MaxLines="1"/>
        <Label Grid.Column="1" Text="{x:Static icons:SolidFont.ChevronDown}" FontFamily="FontSolid"
               FontSize="11" VerticalOptions="Center" Margin="0,0,4,0"
               TextColor="{DynamicResource AppTextMuted}"/>
        <BoxView x:Name="Underline" Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1"
                 Color="{DynamicResource AppTextMuted}"/>
    </Grid>
</ContentView>
