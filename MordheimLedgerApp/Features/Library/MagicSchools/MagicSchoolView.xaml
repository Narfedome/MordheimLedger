<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Features.Library.MagicSchools.MagicSchoolView"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.MagicSchools"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Name="root">

    <!-- Pas de filtre par catégorie (comme SpecialRuleView) : une école de magie n'a pas de
         regroupement par type dans le livre de règles. -->
    <Grid Margin="5" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="120" HeightRequest="120"/>

        <!-- Simple liste nommée (pas de tuiles à image comme les autres catalogues) : une école de
             magie n'a ni artwork ni besoin d'un aperçu visuel, seul le nom compte au quotidien - même
             gabarit de ligne que WarbandListPage (BoxView ChapterDividerStyle/SelectionMarkerStyle),
             pas de zone "Jouer" ici. -->
        <CollectionView Grid.Row="0" x:Name="ItemsCollection"
                ItemsSource="{Binding MagicSchools}"
                SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MagicSchoolRow">
                    <Grid ColumnDefinitions="4,*" Padding="{DynamicResource AppChapterRowPadding}" MinimumHeightRequest="48" ColumnSpacing="8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference root}, Path=BindingContext.SelectCommand}"
                                CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <BoxView Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ChapterDividerStyle}"/>
                        <BoxView Grid.Column="0" Style="{StaticResource SelectionMarkerStyle}"/>
                        <Label Grid.Column="1" Text="{Binding Item.Name}"
                               FontSize="{OnIdiom Default=15, Desktop=13}"
                               VerticalOptions="Center" Style="{StaticResource TruncatedLabelStyle}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center" Margin="0,8"
                               IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                         Command="{Binding CreateCommand}"
                                         Tooltip="{loc:Loc BtnAdd}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                         Command="{Binding EditCommand}"
                                         Tooltip="{loc:Loc BtnRename}"
                                         IsEnabled="{Binding SelectedRow, Converter={StaticResource IsNotNullConverter}}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                         Command="{Binding DeleteCommand}"
                                         Tooltip="{loc:Loc BtnDelete}"
                                         IsEnabled="{Binding SelectedRow, Converter={StaticResource IsNotNullConverter}}"/>
        </HorizontalStackLayout>

        <!-- Multi-sélection : un tap bascule le liseré bleu (IsSelected) de la tuile, Confirmer ajoute
             toutes les tuiles cochées d'un coup. -->
        <HorizontalStackLayout Grid.Row="1" Spacing="20" HorizontalOptions="Center" Margin="0,8"
                               IsVisible="{Binding Source={x:Reference root}, Path=IsCrud, Converter={StaticResource InverseBoolConverter}}">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CircleCheck}"
                                         Command="{Binding ConfirmSelectionCommand}"
                                         Tooltip="{loc:Loc LibConfirm}"
                                         IsEnabled="{Binding HasSelectedRows}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CircleXmark}"
                                         Command="{Binding CancelCommand}"
                                         Tooltip="{loc:Loc LibCancel}"/>
        </HorizontalStackLayout>

    </Grid>
</ContentView>
