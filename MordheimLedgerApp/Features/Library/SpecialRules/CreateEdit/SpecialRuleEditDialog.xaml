<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.SpecialRules.CreateEdit"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.SpecialRules.CreateEdit.SpecialRuleEditDialog"
               x:DataType="local:SpecialRuleEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <Grid RowDefinitions="*,Auto" RowSpacing="16">
        <dialogs:StableHeightScrollView Grid.Row="0">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>
            <VerticalStackLayout Spacing="4">
                <Label FontSize="12" TextColor="{DynamicResource AppTextMuted}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Loc SpecialRuleNamePh}"/>
                            <Span Text=" *" TextColor="{StaticResource AppDanger}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Entry Text="{Binding Item.Name}"/>
                <Label Text="{Binding NameError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                       IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}"/>
            </VerticalStackLayout>

            <components:ScrollableTabStripView>
                <HorizontalStackLayout Spacing="16">
                    <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabGeneral}" Command="{Binding ShowGeneralTabCommand}"
                                                 IsActive="{Binding IsGeneralTab}" FontSize="12"/>
                    <components:TabToggleButton Text="{loc:Loc SpecialRuleTabMaterials}" Command="{Binding ShowMaterialsTabCommand}"
                                                 IsActive="{Binding IsMaterialsTab}" FontSize="12"
                                                 IsVisible="{Binding IsMaterialRule}"/>
                </HorizontalStackLayout>
            </components:ScrollableTabStripView>

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGeneralTab}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Loc LibDescriptionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Editor Text="{Binding Item.Description}" HeightRequest="100"/>
                </VerticalStackLayout>
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding IsMaterialRule}" VerticalOptions="Center"/>
                    <Label Text="{loc:Loc SpecialRuleIsMaterialRule}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Multiplicateur/Abréviation/Rareté ne sont significatifs que pour une règle "matériau"
                 (voir SpecialRule.CostMultiplier) - regroupés dans leur propre onglet plutôt que mêlés
                 aux champs génériques d'une règle spéciale ordinaire. -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsMaterialsTab}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Loc SpecialRuleCostMultiplierPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Entry Text="{Binding Item.CostMultiplier}" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Loc SpecialRuleAbbreviationPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Entry Text="{Binding Item.Abbreviation}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Loc EquipmentItemRarityPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Entry Text="{Binding Item.Rarity}" Keyboard="Numeric"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
        </dialogs:StableHeightScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="{loc:Loc BtnCancel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="1"
                    Text="{loc:Loc BtnSave}"
                    Command="{Binding SaveCommand}"/>
        </Grid>
        </Grid>
    </Border>
</dialogs:DialogContent>
