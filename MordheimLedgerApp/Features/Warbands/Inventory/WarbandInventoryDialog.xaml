<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.Inventory"
               xmlns:models="clr-namespace:MordheimLedgerApp.Core.Models;assembly=MordheimLedgerApp.Core"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Warbands.Inventory.WarbandInventoryDialog"
               x:DataType="local:WarbandInventoryDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <dialogs:StableHeightScrollView>
        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}"
                       Style="{StaticResource DialogTitleLabelStyle}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Xmark}"
                                              IconSize="14" ButtonWidthRequest="24" ButtonHeightRequest="24"
                                              Command="{Binding CancelCommand}"/>
            </Grid>

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Inventory}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:WarbandEquipment">
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="12"
                                           TextColor="{DynamicResource AppTextMuted}"/>
                                </VerticalStackLayout>
                                <!-- Uniquement pour une trouvaille explicitement désignée vendable par
                                     le livre (voir WarbandEquipment.IsSellable, ex. Charrette Renversée)
                                     - pas un "vendre n'importe quel objet", absent des règles core. -->
                                <Button Grid.Column="1" Text="{loc:Loc InventorySell}"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        FontSize="12" Padding="10,4" VerticalOptions="Center"
                                        IsVisible="{Binding IsSellable}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarbandInventoryDialogViewModel}}, Path=SellCommand}"
                                        CommandParameter="{Binding .}"/>
                                <Button Grid.Column="2" Text="{loc:Loc InventoryEquip}"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        FontSize="12" Padding="10,4" VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarbandInventoryDialogViewModel}}, Path=EquipCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
        </dialogs:StableHeightScrollView>
    </Border>
</dialogs:DialogContent>
