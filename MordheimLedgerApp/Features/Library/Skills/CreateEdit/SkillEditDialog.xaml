<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.Skills.CreateEdit"
               xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               xmlns:effects="clr-namespace:MordheimLedgerApp.Features.Library.Skills.Effects"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.Skills.CreateEdit.SkillEditDialog"
               x:DataType="local:SkillEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <Grid RowDefinitions="*,Auto" RowSpacing="16">
        <dialogs:AnimatedHeightScrollView Grid.Row="0">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>
            <VerticalStackLayout Spacing="4">
                <Label FontSize="12" TextColor="{DynamicResource AppTextMuted}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Loc SkillNamePh}"/>
                            <Span Text=" *" TextColor="{StaticResource AppDanger}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Entry Text="{Binding Item.Name}"/>
                <Label Text="{Binding NameError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                       IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="{loc:Loc SkillCategoryPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Picker ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategoryLabel}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="{loc:Loc LibDescriptionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Editor Text="{Binding Item.Description}" HeightRequest="100"/>
            </VerticalStackLayout>

            <!-- Réservé à ces bandes : vide = commun à toutes les bandes (voir Skill.
                 RestrictedToWarbandArchetypeIds). Contrôle unique factorisant chips + bascule
                 Inclure/Exclure. -->
            <components:WarbandRestrictionEditorView Editor="{Binding WarbandRestriction}"/>

            <!-- Réservé à ces guerriers : n'apparaît qu'une fois au moins une bande sélectionnée
                 ci-dessus - vide = tout guerrier des bandes sélectionnées (voir Skill.
                 RestrictedToWarriorArchetypeIds). Même principe HeaderText dynamique que ci-dessus. -->
            <components:ChipListView IsVisible="{Binding HasRestrictedWarbands}"
                                      HeaderText="{Binding RestrictedWarriorsHeaderText}"
                                      ItemsSource="{Binding RestrictedWarriors}"
                                      IconGlyph="{x:Static icons:SolidFont.User}"
                                      AddCommand="{Binding AddRestrictedWarriorCommand}"
                                      RemoveCommand="{Binding RemoveRestrictedWarriorCommand}"/>

            <!-- Effets (maquette « Modifier Marchandage ») : ce que l'app propose à partir de cette
                 compétence. Toucher une ligne ouvre le popup de l'effet (SkillEffectEditDialog). -->
            <VerticalStackLayout Spacing="8">
                <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}"/>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" FontFamily="FontSolid" FontSize="14" VerticalOptions="Center"
                           Text="{x:Static icons:SolidFont.Bolt}" TextColor="{DynamicResource AppAccent}"/>
                    <Label Grid.Column="1" Text="{loc:Loc EffectsHeading}" FontAttributes="Bold" VerticalOptions="Center"/>
                    <components:FaIconButtonView Grid.Column="2" Style="{StaticResource GhostIconButtonStyle}" Icon="{x:Static icons:SolidFont.Plus}"
                                                  IconSize="14" ButtonWidthRequest="32" ButtonHeightRequest="32"
                                                  SemanticProperties.Description="{loc:Loc EffectsAdd}"
                                                  Command="{Binding AddEffectCommand}"/>
                </Grid>
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding EffectRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="effects:SkillEffectRow">
                            <effects:SkillEffectRowView>
                                <effects:SkillEffectRowView.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:SkillEditDialogViewModel}}, Path=EditEffectCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </effects:SkillEffectRowView.GestureRecognizers>
                            </effects:SkillEffectRowView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding EffectsHint}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
        </dialogs:AnimatedHeightScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="{loc:Loc BtnCancel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="1"
                    Text="{loc:Loc BtnSave}"
                    Command="{Binding SaveCommand}"/>
        </Grid>
        </Grid>
    </Border>
</dialogs:DialogContent>
