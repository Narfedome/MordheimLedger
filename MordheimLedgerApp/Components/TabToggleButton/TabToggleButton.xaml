<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MordheimLedgerApp.Components.TabToggleButton"
             x:Name="root">
    <!-- BindingContext="{x:Reference root}" sur l'enfant plutôt que sur la ContentView elle-même :
         évite le piège rencontré sur LibraryPage (poser BindingContext et une autre liaison sur le
         même élément fait chercher cette liaison sur le nouveau contexte). Ici la ContentView garde son
         BindingContext hérité (peu importe, rien ne s'y lie directement), et tout le contenu interne
         (Text/Command/IsActive/FontSize) lit les bindable properties de la ContentView via cette
         référence explicite. -->
    <!-- PointerGestureRecognizer (Desktop uniquement - no-op sur mobile, pas de souris) plutôt qu'un
         VisualStateManager PointerOver : ce n'est pas un Button, pas d'état PointerOver natif ici. -->
    <VerticalStackLayout Spacing="4" BindingContext="{x:Reference root}" HorizontalOptions="Center" Opacity="1">
        <VerticalStackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command}"/>
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"/>
        </VerticalStackLayout.GestureRecognizers>
        <VerticalStackLayout.Triggers>
            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsHovered}" Value="True">
                <Setter Property="Opacity" Value="0.7"/>
            </DataTrigger>
        </VerticalStackLayout.Triggers>
        <Label Text="{Binding Text}" FontSize="{Binding FontSize}"
               TextColor="{DynamicResource AppTextMuted}" HorizontalOptions="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                    <Setter Property="TextColor" Value="{DynamicResource AppAccent}"/>
                    <Setter Property="FontAttributes" Value="Bold"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <BoxView HeightRequest="2" BackgroundColor="Transparent" HorizontalOptions="Fill">
            <BoxView.Triggers>
                <DataTrigger TargetType="BoxView" Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BackgroundColor" Value="{DynamicResource AppAccent}"/>
                </DataTrigger>
            </BoxView.Triggers>
        </BoxView>
    </VerticalStackLayout>
</ContentView>
