<?xml version="1.0" encoding="utf-8" ?>
<form:FormContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:form="clr-namespace:MordheimLedgerApp.Components.FormPage"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.Skills.CreateEdit"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="local:SkillEffectEditResult"
               x:Class="MordheimLedgerApp.Features.Library.Skills.CreateEdit.SkillEffectEditForm"
               x:DataType="local:SkillEffectEditDialogViewModel">
    <!-- Page plein écran (autrefois SkillEffectEditDialog, voir Components/FormPage) : titre et
         ✕ dans l'en-tête, Annuler / Enregistrer dans le pied, contenu en carte. -->
    <form:FormPageLayout Title="{Binding Title}"
                         Subtitle="{loc:Loc EffectDialogSubtitle}"
                         CloseCommand="{Binding CancelCommand}"
                         SecondaryText="{loc:Loc BtnCancel}"
                         SecondaryCommand="{Binding CancelCommand}"
                         PrimaryText="{loc:Loc BtnSave}"
                         PrimaryCommand="{Binding SaveCommand}">
        <form:FormPageLayout.HeaderActions>
            <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}" Icon="{x:Static icons:SolidFont.TrashCan}"
                                          IconSize="16" ButtonWidthRequest="44" ButtonHeightRequest="44"
                                          IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}"/>
        </form:FormPageLayout.HeaderActions>
        <Border Style="{StaticResource SectionCardBorderStyle}">
            <VerticalStackLayout Spacing="16">

                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Loc EffectMomentPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <components:SelectFieldView Title="{loc:Loc EffectMomentPh}" ItemsSource="{Binding MomentOptions}" SelectedIndex="{Binding SelectedMoment}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Loc EffectKindPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <components:SelectFieldView Title="{loc:Loc EffectKindPh}" ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding SelectedKind}"/>
                </VerticalStackLayout>

                <!-- Compteur −/+ pour un bonus ou un nombre de dés (même contrôle que les PX de l'étape Expérience
                     du wizard) ; saisie libre seulement pour une réduction (formule de dés). -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding ShowNumericValue}">
                    <Label Grid.Column="0" Text="{loc:Loc EffectValuePh}" VerticalOptions="Center"
                           TextColor="{DynamicResource AppTextMuted}"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Minus}" Style="{StaticResource GhostIconButtonStyle}"
                                                      Command="{Binding DecrementValueCommand}"/>
                        <Label Text="{Binding ValueText}" WidthRequest="48" HorizontalTextAlignment="Center"
                               VerticalOptions="Center" FontAttributes="Bold" TextColor="{DynamicResource AppText}"/>
                        <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}" Style="{StaticResource GhostIconButtonStyle}"
                                                      Command="{Binding IncrementValueCommand}"/>
                    </HorizontalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ShowTextValue}">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{loc:Loc EffectValuePh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Entry Text="{Binding ValueText}" Placeholder="{loc:Loc EffectValueHint}"/>
                        <Label Text="{Binding ValueError}" FontSize="11" TextColor="{StaticResource AppDanger}"
                               IsVisible="{Binding ValueError, Converter={StaticResource IsNotNullConverter}}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding ShowMinimumPrice}">
                        <Label Text="{loc:Loc EffectMinimumPricePh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Entry Text="{Binding MinimumPriceText}" Keyboard="Numeric"/>
                    </VerticalStackLayout>
                </Grid>

                <components:ChipListView IsVisible="{Binding ShowTargets}"
                                          AlwaysShowSection="True" Margin="0,-10,0,0"
                                          HeaderText="{loc:Loc EffectTargetsPh}"
                                          EmptyHintText="{Binding TargetsEmptyHint}"
                                          ItemsSource="{Binding Targets}"
                                          AddCommand="{Binding AddTargetCommand}"
                                          RemoveCommand="{Binding RemoveTargetCommand}"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{loc:Loc EffectConditionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <components:SelectFieldView Title="{loc:Loc EffectConditionPh}" ItemsSource="{Binding ConditionOptions}" SelectedIndex="{Binding SelectedCondition}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="{loc:Loc EffectFrequencyPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <components:SelectFieldView Title="{loc:Loc EffectFrequencyPh}" ItemsSource="{Binding FrequencyOptions}" SelectedIndex="{Binding SelectedFrequency}"/>
                    </VerticalStackLayout>
                </Grid>

                <components:ChipListView IsVisible="{Binding ShowConditionTargets}"
                                          AlwaysShowSection="True" Margin="0,-10,0,0"
                                          HeaderText="{Binding ConditionTargetsHeader}"
                                          ItemsSource="{Binding ConditionTargets}"
                                          AddCommand="{Binding AddConditionTargetCommand}"
                                          RemoveCommand="{Binding RemoveConditionTargetCommand}"/>

                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Loc EffectNotePh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                    <Entry Text="{Binding Note}" Placeholder="{loc:Loc EffectNotePlaceholder}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </form:FormPageLayout>
</form:FormContent>
