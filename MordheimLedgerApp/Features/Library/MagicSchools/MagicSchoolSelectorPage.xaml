<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.MagicSchools"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:picker="clr-namespace:MordheimLedgerApp.Components.PickerSelectorLayout"
             x:Class="MordheimLedgerApp.Features.Library.MagicSchools.MagicSchoolSelectorPage"
             Shell.NavBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <!-- Poussée nue (pas de NavigationPage, voir MagicSchoolPickerService) - voir PickerSelectorLayout
         pour le pourquoi. -->
    <picker:PickerSelectorLayout Title="{loc:Loc MagicSchoolSelectTitle}" BackCommand="{Binding CancelCommand}">
        <local:MagicSchoolView IsCrud="False" UseTileLayout="True"/>
    </picker:PickerSelectorLayout>
</ContentPage>
