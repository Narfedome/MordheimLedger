<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.Steps.EquipmentReallocationStepView"
             x:DataType="local:EndOfGamePageViewModel">
            <!-- Étape : Réallouer l'équipement (livre, étape 9 - "Swap equipment between models as
                 desired") - dernière étape avant le Récapitulatif, après Achat/Vente ET tout le
                 recrutement. Héros existants + nouvelles recrues de cette partie + Réserve uniquement
                 (jamais un groupe d'Hommes de main, équipement partagé pour tout le groupe) - une
                 ChipListView par porteur, icône ⇄ sur chaque chip pour déplacer CET objet précis,
                 gratuitement. Voir EndOfGamePageViewModel.Reallocation.cs. -->
            <VerticalStackLayout Spacing="12">
                <Label Text="{loc:Loc EndOfGameEquipmentReallocationHeading}" FontAttributes="Bold"/>
                <Label Text="{loc:Loc EndOfGameEquipmentReallocationHint}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReallocationCarriers}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ReallocationCarrier">
                            <!-- Nom du porteur en Label séparé, HORS de la ChipListView (pas
                                 HeaderText/AlwaysShowSection) - le guerrier doit rester visible même à 0
                                 objet (retour utilisateur 2026-09-22), et ChipListView.AlwaysShowSection ne
                                 s'appliquait pas de façon fiable une fois généré dynamiquement par ce
                                 BindableLayout imbriqué. -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource AppTextMuted}"/>
                                <components:ChipListView ItemsSource="{Binding Items}"
                                                          IconGlyph="{x:Static icons:SolidFont.BoxOpen}"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=ShowReallocationItemDetailCommand}"
                                                          MoveCommand="{Binding Source={RelativeSource AncestorType={x:Type local:EndOfGamePageViewModel}}, Path=MoveReallocationItemCommand}"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

</ContentView>
