<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.EndOfGame"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Warbands.EndOfGame.SellEquipmentDialog"
               x:DataType="local:SellEquipmentDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <dialogs:StableHeightScrollView>
        <VerticalStackLayout Spacing="12">
            <Label Text="{loc:Loc EndOfGameSellEquipmentDialogTitle}" Style="{StaticResource DialogTitleLabelStyle}"/>

            <!-- Une carte tapotable par ligne vendable (réserve + équipement porté), liseré accentué sur
                 celles sélectionnées (SelectableCardBorderStyle, même idiome que MaterialPickerDialog) -
                 pas de checkbox séparée, toute la carte est la zone tapable. -->
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Candidates}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:SellableEquipmentCandidate">
                        <Border Style="{StaticResource SelectableCardBorderStyle}" Padding="10,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:SellEquipmentDialogViewModel}}, Path=ToggleSelectionCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Item.Category, Converter={StaticResource EquipmentCategoryIconConverter}}"
                                       FontFamily="RpgAwesome" FontSize="16" TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold"/>
                                    <Label Text="{Binding SourceLabel}" FontSize="11" TextColor="{DynamicResource AppTextMuted}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding SellPrice}" FontSize="12" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:Loc EndOfGameSellEquipmentTotalLabel}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding TotalSellPrice}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="{loc:Loc BtnCancel}" Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1" Text="{loc:Loc BtnSave}" Command="{Binding ConfirmCommand}"/>
            </Grid>
        </VerticalStackLayout>
        </dialogs:StableHeightScrollView>
    </Border>
</dialogs:DialogContent>
