<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.EquipmentItems.CreateEdit"
               xmlns:library="clr-namespace:MordheimLedgerApp.Core.Models.Library;assembly=MordheimLedgerApp.Core"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.EquipmentItems.CreateEdit.EquipmentItemDetailDialog"
               x:DataType="local:EquipmentItemDetailDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0">
    <Border Style="{StaticResource DialogCardBorderStyle}">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}"
                       Style="{StaticResource DialogTitleLabelStyle}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Xmark}"
                                              IconSize="14" ButtonWidthRequest="24" ButtonHeightRequest="24"
                                              Command="{Binding CancelCommand}"/>
            </Grid>
            <dialogs:AnimatedHeightScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Loc EquipmentItemCategoryPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Label Text="{Binding CategoryLabel}" TextColor="{DynamicResource AppText}"/>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{loc:Loc EquipmentItemCostPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Text="{Binding CostDisplay}" TextColor="{DynamicResource AppText}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{loc:Loc EquipmentItemRarityPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                            <Label Text="{Binding RarityDisplay}" TextColor="{DynamicResource AppText}"/>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Loc LibDescriptionPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Label Text="{Binding Item.Description}" TextColor="{DynamicResource AppText}"/>
                    </VerticalStackLayout>

                    <!-- Profil - uniquement pour la catégorie Animal (une monture), voir
                         EquipmentItemEditDialog pour le même principe en édition. -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsAnimalCategory}">
                        <Label Text="{loc:Loc LibTabProfile}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <components:StatRowView Item="{Binding Item}" MovementText="{Binding Item.Movement}"/>
                    </VerticalStackLayout>

                    <components:ChipListView HeaderText="{Binding RestrictedWarbandsHeaderText}"
                                              AlwaysShowSection="True"
                                              ItemsSource="{Binding RestrictedWarbands}"
                                              IconGlyph="{x:Static icons:SolidFont.Users}"
                                              Command="{Binding ShowWarbandDetailCommand}"/>

                    <components:ChipListView HeaderText="{loc:Loc LibRestrictedToWarriorsPh}"
                                              ItemsSource="{Binding RestrictedWarriors}"
                                              IconGlyph="{x:Static icons:SolidFont.User}"
                                              Command="{Binding ShowWarriorDetailCommand}"/>

                    <components:ChipListView HeaderText="{loc:Loc LibSpecialRulesPh}"
                                              ItemsSource="{Binding DisplayedSpecialRules}"
                                              IconGlyph="{x:Static icons:SolidFont.Scroll}"
                                              Command="{Binding ShowSpecialRuleDetailCommand}"/>
                </VerticalStackLayout>
            </dialogs:AnimatedHeightScrollView>
        </Grid>
    </Border>
</dialogs:DialogContent>
