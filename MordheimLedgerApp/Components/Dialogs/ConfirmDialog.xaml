<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Components.Dialogs.ConfirmDialog"
               x:DataType="dialogs:ConfirmDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="Center">
    <!-- Centré sur toutes les plateformes, contrairement aux autres dialogs (Start + marge haute sur
         mobile pour laisser la place au clavier) : aucun champ de saisie ici, donc pas de clavier à
         éviter - et une confirmation ouverte par-dessus un autre dialog (abandon des modifications,
         DialogViewModel.Cancel) se retrouvait collée en haut, sur le dialog parent. -->
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="320">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   Style="{StaticResource DialogTitleLabelStyle}"/>
            <Label Text="{Binding Message}"
                   TextColor="{DynamicResource AppTextMuted}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{Binding CancelLabel}"
                        IsVisible="{Binding HasCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Grid.ColumnSpan="{Binding ConfirmButtonColumnSpan}"
                        Text="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</dialogs:DialogContent>
