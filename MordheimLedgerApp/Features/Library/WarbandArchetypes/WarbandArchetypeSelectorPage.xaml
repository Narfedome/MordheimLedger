<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.WarbandArchetypes"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:picker="clr-namespace:MordheimLedgerApp.Components.PickerSelectorLayout"
             x:Class="MordheimLedgerApp.Features.Library.WarbandArchetypes.WarbandArchetypeSelectorPage"
             Shell.NavBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <!-- Poussée nue (pas de NavigationPage, voir WarbandArchetypePickerService) - voir
         PickerSelectorLayout pour le pourquoi. -->
    <!-- Titre posé par le code-behind selon SelectionMode (une bande / plusieurs bandes). -->
    <picker:PickerSelectorLayout x:Name="PickerLayout" Title="{loc:Loc WarbandArchetypeSelectTitle}" BackCommand="{Binding CancelCommand}">
        <local:WarbandArchetypeView IsCrud="False"/>
    </picker:PickerSelectorLayout>
</ContentPage>
