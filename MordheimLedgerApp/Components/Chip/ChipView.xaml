<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Class="MordheimLedgerApp.Components.ChipView"
             x:Name="root">

    <Border Style="{StaticResource ChipBorderStyle}" Margin="0,0,4,4" HorizontalOptions="Start">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Command, Source={x:Reference root}}"
                CommandParameter="{Binding Item, Source={x:Reference root}}"/>
        </Border.GestureRecognizers>
        <Grid BindingContext="{Binding Item, Source={x:Reference root}}"
              ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="4" HeightRequest="36" Margin="8,0">
            <Label Grid.Column="0" Text="{Binding IconGlyph, Source={x:Reference root}}"
                   FontFamily="{Binding IconFontFamily, Source={x:Reference root}}"
                   FontSize="12" TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
            <Label Grid.Column="1" Text="{Binding Name}" FontSize="11" VerticalOptions="Center"/>
            <components:FaIconButtonView Grid.Column="2" Style="{StaticResource GhostIconButtonStyle}"
                                          Icon="{x:Static icons:SolidFont.Xmark}"
                                          IconSize="10" Padding="0,0,-8,0"
                                          IsVisible="{Binding RemoveCommand, Source={x:Reference root}, Converter={StaticResource IsNotNullConverter}}"
                                          Command="{Binding RemoveCommand, Source={x:Reference root}}"
                                          CommandParameter="{Binding Item, Source={x:Reference root}}"/>
        </Grid>
    </Border>
</ContentView>
