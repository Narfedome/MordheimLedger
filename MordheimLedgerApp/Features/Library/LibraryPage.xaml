<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library"
             xmlns:warbandArchetypes="clr-namespace:MordheimLedgerApp.Features.Library.WarbandArchetypes"
             xmlns:equipmentItems="clr-namespace:MordheimLedgerApp.Features.Library.EquipmentItems"
             xmlns:skills="clr-namespace:MordheimLedgerApp.Features.Library.Skills"
             xmlns:injuries="clr-namespace:MordheimLedgerApp.Features.Library.Injuries"
             xmlns:spells="clr-namespace:MordheimLedgerApp.Features.Library.Spells"
             xmlns:specialRules="clr-namespace:MordheimLedgerApp.Features.Library.SpecialRules"
             xmlns:mutations="clr-namespace:MordheimLedgerApp.Features.Library.Mutations"
             xmlns:animals="clr-namespace:MordheimLedgerApp.Features.Library.Animals"
             xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
             xmlns:components="clr-namespace:MordheimLedgerApp.Components"
             x:Class="MordheimLedgerApp.Features.Library.LibraryPage"
             x:DataType="local:LibraryViewModel">

    <components:WatermarkedLayout>
    <Grid RowDefinitions="Auto,*">
        <!-- Sélecteur de section (Bandes/Marché/Compétences/Blessures/...) : un seul bouton affichant la
             section active, ouvrant un ActionSheet listant les 8 au tap - même mécanisme que le filtre
             par catégorie de SkillView/MutationView (SelectCategoryCommand), préféré à 8 boutons côte à
             côte pour rester compact quel que soit le nombre de sections. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,auto" Margin="16,10,16,8">
            <Button Grid.Column="0"
                    Text="{Binding SelectedTabLabel}"
                    Command="{Binding SelectTabCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource AppAccent}"
                    FontAttributes="Bold"
                    FontSize="{DynamicResource AppFontSizeSectionTitle}"
                    HorizontalOptions="Center"
                    Padding="0"/>
        </Grid>

        <!-- Chaque section garde son ViewModel/*View existant tel quel (BindingContext explicite,
             plutôt qu'hérité du parent) - le conteneur ne fait que le toggle. IsVisible doit sourcer
             explicitement l'ancêtre (Source={RelativeSource AncestorType=...}) : poser BindingContext
             sur le même élément que IsVisible="{Binding IsXTab}" ferait chercher IsXTab sur le
             sous-ViewModel (qui ne l'a pas) au lieu du conteneur - liaison en échec, IsVisible reste à
             sa valeur par défaut (true), les 4 sections restent toutes visibles superposées. -->
        <warbandArchetypes:WarbandArchetypeView Grid.Row="1" BindingContext="{Binding WarbandArchetypes}"
            IsVisible="{Binding IsWarbandsTab, Source={RelativeSource AncestorType={x:Type local:LibraryViewModel}}}"/>
        <equipmentItems:EquipmentItemView Grid.Row="1" BindingContext="{Binding EquipmentItems}"
            IsVisible="{Binding IsTradingPostTab, Source={RelativeSource AncestorType={x:Type local:LibraryViewModel}}}"/>
        <skills:SkillView Grid.Row="1" BindingContext="{Binding Skills}"
            IsVisible="{Binding IsSkillsTab, Source={RelativeSource AncestorType={x:Type local:LibraryViewModel}}}"/>
        <injuries:InjuryView Grid.Row="1" BindingContext="{Binding Injuries}"
            IsVisible="{Binding IsInjuriesTab, Source={RelativeSource AncestorType={x:Type local:LibraryViewModel}}}"/>
        <spells:SpellView Grid.Row="1" BindingContext="{Binding Spells}"
            IsVisible="{Binding IsSpellsTab, Source={RelativeSource AncestorType={x:Type local:LibraryViewModel}}}"/>
        <specialRules:SpecialRuleView Grid.Row="1" BindingContext="{Binding SpecialRules}"
            IsVisible="{Binding IsSpecialRulesTab, Source={RelativeSource AncestorType={x:Type local:LibraryViewModel}}}"/>
        <mutations:MutationView Grid.Row="1" BindingContext="{Binding Mutations}"
            IsVisible="{Binding IsMutationsTab, Source={RelativeSource AncestorType={x:Type local:LibraryViewModel}}}"/>
        <animals:AnimalView Grid.Row="1" BindingContext="{Binding Animals}"
            IsVisible="{Binding IsAnimalsTab, Source={RelativeSource AncestorType={x:Type local:LibraryViewModel}}}"/>
    </Grid>
    </components:WatermarkedLayout>
</ContentPage>
