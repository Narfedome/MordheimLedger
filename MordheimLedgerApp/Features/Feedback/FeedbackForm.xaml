<?xml version="1.0" encoding="utf-8" ?>
<form:FormContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:form="clr-namespace:MordheimLedgerApp.Components.FormPage"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Feedback"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Feedback.FeedbackForm"
               x:DataType="local:FeedbackFormViewModel">
    <!-- « Nous écrire » (maquette mockups/report-issue.html, 2026-11-27) : message sans compte, envoyé au relais qui crée
         un ticket dans le dépôt privé de support. -->
    <form:FormPageLayout Title="{loc:Loc FeedbackTitle}"
                         Subtitle="{Binding Subtitle}"
                         CloseCommand="{Binding CancelCommand}"
                         SecondaryText="{loc:Loc BtnCancel}"
                         SecondaryCommand="{Binding CancelCommand}"
                         PrimaryText="{loc:Loc FeedbackSend}"
                         PrimaryCommand="{Binding SendCommand}">
        <VerticalStackLayout Spacing="12">

            <!-- Type de message : une ligne par type, bordure accent sur le type choisi. Bouton transparent par-dessus
                 chaque carte (accessibilité, voir CLAUDE.md § Accessibilité). -->
            <Border Style="{StaticResource SectionCardBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Loc FeedbackKindHeading}" FontAttributes="Bold"/>
                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Kinds}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:FeedbackKindOption">
                                <Grid>
                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{DynamicResource AppBorder}"
                                            Padding="10,8" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource AppAccent}"/>
                                                <Setter Property="StrokeThickness" Value="2"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource AppAccent}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Button BackgroundColor="Transparent" BorderWidth="0" CornerRadius="8" Padding="0"
                                            SemanticProperties.Description="{Binding Title}"
                                            SemanticProperties.Hint="{Binding Description}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:FeedbackFormViewModel}}, Path=SelectKindCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{loc:Loc FeedbackTranslationNote}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"
                           IsVisible="{Binding ShowTranslationNote}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Le message -->
            <Border Style="{StaticResource SectionCardBorderStyle}">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{loc:Loc FeedbackSummary}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Entry AutomationId="FeedbackSummary" Text="{Binding Summary}" MaxLength="{Binding MaxSummaryLength}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2" IsVisible="{Binding ShowWhere}">
                        <Label Text="{loc:Loc FeedbackWhere}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Entry Text="{Binding Where}" Placeholder="{loc:Loc FeedbackWherePh}" MaxLength="{Binding MaxWhereLength}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding DetailsLabel}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Editor AutomationId="FeedbackDetails" Text="{Binding Details}" HeightRequest="140"
                                MaxLength="{Binding MaxDetailsLength}" AutoSize="TextChanges"/>
                        <Label Text="{Binding DetailsHint}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"
                               IsVisible="{Binding HasDetailsHint}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Captures d'écran -->
            <Border Style="{StaticResource SectionCardBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Loc FeedbackScreenshots}"/>
                                <Span Text=" "/>
                                <Span Text="{loc:Loc FeedbackScreenshotsMax}" FontAttributes="None" TextColor="{DynamicResource AppTextMuted}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Screenshots}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:FeedbackScreenshot">
                                <Grid WidthRequest="64" HeightRequest="64">
                                    <Border StrokeShape="RoundRectangle 6" StrokeThickness="1" Stroke="{DynamicResource AppBorder}">
                                        <Image Source="{Binding Image}" Aspect="AspectFill"/>
                                    </Border>
                                    <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                                  Icon="{x:Static icons:SolidFont.Xmark}" IconSize="12"
                                                                  ButtonWidthRequest="22" ButtonHeightRequest="22"
                                                                  HorizontalOptions="End" VerticalOptions="Start"
                                                                  AccessibleName="{loc:Loc FeedbackScreenshotRemove}"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:FeedbackFormViewModel}}, Path=RemoveScreenshotCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <components:IconTextButton Icon="{x:Static icons:SolidFont.Image}" IconSize="13" FontSize="13"
                                               Text="{loc:Loc FeedbackScreenshotAdd}" TextColor="{DynamicResource AppAccent}"
                                               IsVisible="{Binding CanAddScreenshot}"
                                               Command="{Binding AddScreenshotCommand}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Informations techniques -->
            <Border Style="{StaticResource SectionCardBorderStyle}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding AttachTechnical}" VerticalOptions="Center"
                                  SemanticProperties.Description="{loc:Loc FeedbackAttachTechnical}"/>
                        <Label Grid.Column="1" Text="{loc:Loc FeedbackAttachTechnical}" VerticalOptions="Center"/>
                    </Grid>
                    <components:IconTextButton Icon="{x:Static icons:SolidFont.CircleInfo}" IconSize="12" FontSize="12"
                                               Text="{loc:Loc FeedbackShowTechnical}" TextColor="{DynamicResource AppAccent}"
                                               IsVisible="{Binding AttachTechnical}"
                                               Command="{Binding ToggleTechnicalCommand}"/>
                    <Border IsVisible="{Binding ShowTechnical}" StrokeShape="RoundRectangle 6" StrokeThickness="1"
                            Stroke="{DynamicResource AppBorder}" BackgroundColor="{DynamicResource AppBackground}" Padding="10,8">
                        <Label Text="{Binding TechnicalPreview}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"
                               FontFamily="{OnPlatform WinUI=Consolas, Android=monospace}"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:Loc FeedbackPrivacy}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" Margin="4,0"/>
        </VerticalStackLayout>
    </form:FormPageLayout>
</form:FormContent>
