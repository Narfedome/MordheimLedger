<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MordheimLedgerApp.Components.ExperienceTrack"
             x:Class="MordheimLedgerApp.Components.ExperienceTrack.ExperienceTrackView"
             x:Name="root">
    <!-- Box positions, milestone spacing and the row split (forced line breaks every RowSize boxes,
         independent of the container's width) are computed in code-behind (Rebuild) - see the tier
         tables there. -->
    <VerticalStackLayout x:Name="TrackLayout" Spacing="1" HorizontalOptions="Center">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="local:ExperienceRow">
                <HorizontalStackLayout Spacing="1" BindableLayout.ItemsSource="{Binding Boxes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ExperienceBox">
                            <Border WidthRequest="12" HeightRequest="12" Padding="0"
                                    StrokeShape="Rectangle" Stroke="{DynamicResource AppBorder}" StrokeThickness="1"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsFilled}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AppAccent}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMilestone}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource AppMilestone}"/>
                                        <Setter Property="StrokeThickness" Value="3"/>
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
