<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Warbands.CreateEdit"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:stepper="clr-namespace:MordheimLedgerApp.Components.StatStepper"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               xmlns:models="clr-namespace:MordheimLedgerApp.Core.Models;assembly=MordheimLedgerApp.Core"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Warbands.CreateEdit.WarriorEditDialog"
               x:DataType="local:WarriorEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <ScrollView x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}"
                       FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"
                       TextColor="{DynamicResource AppText}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Trash}"
                                              IconSize="14" ButtonWidthRequest="28" ButtonHeightRequest="28"
                                              Command="{Binding DeleteCommand}"/>
            </Grid>

            <Entry Text="{Binding Item.Name}" Placeholder="{loc:Loc PromptName}"/>
            <VerticalStackLayout Spacing="2">
                <Label Text="{loc:Loc WarriorExperiencePh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                <Entry Text="{Binding Item.Experience}" Keyboard="Numeric"/>
            </VerticalStackLayout>

            <!-- Abréviations officielles du livre de règles, pas de traduction - même grille que
                 WarriorArchetypeEditDialog (étape profil). Steppers +/- (StatStepperView) : les
                 avances (jets d'Advance) se font quasi toujours de ±1. -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="auto,auto,auto" RowSpacing="8" ColumnSpacing="8">
                <stepper:StatStepperView Grid.Row="0" Grid.Column="0" Label="M" Value="{Binding Item.Movement}"/>
                <stepper:StatStepperView Grid.Row="0" Grid.Column="1" Label="WS" Value="{Binding Item.WeaponSkill}"/>
                <stepper:StatStepperView Grid.Row="0" Grid.Column="2" Label="BS" Value="{Binding Item.BallisticSkill}"/>
                <stepper:StatStepperView Grid.Row="1" Grid.Column="0" Label="S" Value="{Binding Item.Strength}"/>
                <stepper:StatStepperView Grid.Row="1" Grid.Column="1" Label="T" Value="{Binding Item.Toughness}"/>
                <stepper:StatStepperView Grid.Row="1" Grid.Column="2" Label="W" Value="{Binding Item.Wounds}"/>
                <stepper:StatStepperView Grid.Row="2" Grid.Column="0" Label="I" Value="{Binding Item.Initiative}"/>
                <stepper:StatStepperView Grid.Row="2" Grid.Column="1" Label="A" Value="{Binding Item.Attacks}"/>
                <stepper:StatStepperView Grid.Row="2" Grid.Column="2" Label="Ld" Value="{Binding Item.Leadership}"/>
            </Grid>

            <!-- Blessures : alimenté à la fois par le jet de Fin de partie et par le "+" ci-dessous
                 (retrait par la croix sur chaque puce) - même style de puce que Équipement/Compétences
                 sur la carte guerrier. -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:Loc WarriorsInjuriesHeading}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Plus}"
                                              IconSize="12" ButtonWidthRequest="22" ButtonHeightRequest="22"
                                              Command="{Binding AddInjuryCommand}"/>
            </Grid>
            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Injuries}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:WarriorInjury">
                        <Border Style="{StaticResource SectionCardBorderStyle}" Padding="6,3" Margin="0,0,4,4">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{x:Static icons:RpgFont.RaBrokenBone}"
                                       FontFamily="RpgAwesome" FontSize="12"
                                       TextColor="{DynamicResource AppAccent}" VerticalOptions="Center"/>
                                <Label Text="{Binding Item.Name}" FontSize="11" VerticalOptions="Center"/>
                                <components:FaIconButtonView Style="{StaticResource GhostIconButtonStyle}"
                                                              Icon="{x:Static icons:SolidFont.Xmark}"
                                                              IconSize="10" ButtonWidthRequest="18" ButtonHeightRequest="18"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type local:WarriorEditDialogViewModel}}, Path=RemoveInjuryCommand}"
                                                              CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc BtnSave}"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>
