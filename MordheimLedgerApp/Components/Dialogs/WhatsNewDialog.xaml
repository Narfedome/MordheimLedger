<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogContent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:dialogs="clr-namespace:MordheimLedgerApp.Components.Dialogs"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Components.Dialogs.WhatsNewDialog"
               x:DataType="dialogs:WhatsNewDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0">
    <!-- Centré comme le dialog d'information (ConfirmDialog sans Annuler) ; titre et pied hors de la zone qui
         défile, comme les autres dialogs (maquette « Dialog Nouveautés », 2026-11-13). -->
    <Border Style="{StaticResource DialogCardBorderStyle}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="{Binding Title}" Style="{StaticResource DialogTitleLabelStyle}" HorizontalTextAlignment="Center"/>
                <Label Text="{Binding VersionText}" FontSize="12" TextColor="{DynamicResource AppTextMuted}" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <dialogs:AnimatedHeightScrollView Grid.Row="1" MaxHeightFactor="0.75">
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="system:String">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="•" TextColor="{DynamicResource AppAccent}" FontAttributes="Bold" FontSize="{OnIdiom Default=14, Desktop=12}"/>
                                <Label Grid.Column="1" Text="{Binding .}" TextColor="{DynamicResource AppText}" FontSize="{OnIdiom Default=14, Desktop=12}"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </dialogs:AnimatedHeightScrollView>

            <VerticalStackLayout Grid.Row="2" Spacing="4">
                <Button Text="{loc:Loc WhatsNewAllVersions}"
                        Command="{Binding OpenAllVersionsCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource AppAccent}"
                        FontSize="{OnIdiom Default=14, Desktop=12}"
                        Padding="8,0"
                        HorizontalOptions="Center"
                        MinimumHeightRequest="{DynamicResource AppInlineButtonMinSize}"/>
                <Button Text="{loc:Loc DialogOk}"
                        Command="{Binding CancelCommand}"
                        HorizontalOptions="Center"
                        MinimumWidthRequest="140"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
</dialogs:DialogContent>
