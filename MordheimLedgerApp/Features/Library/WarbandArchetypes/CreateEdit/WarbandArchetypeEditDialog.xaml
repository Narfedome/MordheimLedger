<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:local="clr-namespace:MordheimLedgerApp.Features.Library.WarbandArchetypes.CreateEdit"
               xmlns:icons="clr-namespace:MordheimLedgerApp.Resources.Icons"
               xmlns:loc="clr-namespace:MordheimLedgerApp.Extensions"
               xmlns:components="clr-namespace:MordheimLedgerApp.Components"
               x:TypeArguments="system:Boolean"
               x:Class="MordheimLedgerApp.Features.Library.WarbandArchetypes.CreateEdit.WarbandArchetypeEditDialog"
               x:DataType="local:WarbandArchetypeEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="340">
        <ScrollView x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout x:Name="RootContent" Spacing="16" SizeChanged="OnRootContentSizeChanged">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}"
                       FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"
                       TextColor="{DynamicResource AppText}" VerticalOptions="Center"/>
                <components:FaIconButtonView Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}"
                                              Icon="{x:Static icons:SolidFont.Xmark}"
                                              IconSize="14" ButtonWidthRequest="24" ButtonHeightRequest="24"
                                              Command="{Binding CancelCommand}"/>
            </Grid>

            <!-- Même structure à 3 onglets que WarbandArchetypeDetailDialog (visuel repris tel quel),
                 champs modifiables (Entry/Editor/Picker au lieu de Label) et Guerriers/Équipement en
                 CRUD inline via ChipListView.AddCommand/RemoveCommand plutôt qu'en lecture seule. -->
            <HorizontalStackLayout Spacing="16">
                <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabGeneral}" Command="{Binding ShowGeneralTabCommand}"
                                             IsActive="{Binding IsGeneralTab}" FontSize="12"/>
                <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabWarriors}" Command="{Binding ShowWarriorsTabCommand}"
                                             IsActive="{Binding IsWarriorsTab}" FontSize="12"/>
                <components:TabToggleButton Text="{loc:Loc WarbandArchetypeTabEquipment}" Command="{Binding ShowEquipmentTabCommand}"
                                             IsActive="{Binding IsEquipmentTab}" FontSize="12"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGeneralTab}">
                <Entry Text="{Binding Item.Name}" Placeholder="{loc:Loc WarbandArchetypeNamePh}"/>
                <Picker Title="{loc:Loc WarbandGradePh}"
                        ItemsSource="{Binding GradeOptions}"
                        SelectedItem="{Binding SelectedGradeLabel}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{loc:Loc WarbandArchetypeTreasuryPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Entry Text="{Binding Item.StartingTreasury}" Keyboard="Numeric"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="{loc:Loc WarbandArchetypeMaxWarriorsPh}" FontSize="12" TextColor="{DynamicResource AppTextMuted}"/>
                        <Entry Text="{Binding Item.MaxWarriors}" Keyboard="Numeric"/>
                    </VerticalStackLayout>
                </Grid>
                <Editor Text="{Binding Item.Description}" Placeholder="{loc:Loc LibDescriptionPh}" HeightRequest="80"/>
                <components:ChipListView HeaderText="{loc:Loc LibSpecialRulesPh}"
                                          ItemsSource="{Binding SpecialRules}"
                                          IconGlyph="{x:Static icons:SolidFont.Scroll}"
                                          Command="{Binding ShowSpecialRuleDetailCommand}"
                                          AddCommand="{Binding AddSpecialRuleCommand}"
                                          RemoveCommand="{Binding RemoveSpecialRuleCommand}"/>
                <components:ChipListView HeaderText="{loc:Loc LibMagicSchoolsPh}"
                                          ItemsSource="{Binding MagicSchools}"
                                          IconGlyph="{x:Static icons:RpgFont.RaCrystalBall}"
                                          IconFontFamily="RpgAwesome"
                                          Command="{Binding ShowMagicSchoolDetailCommand}"
                                          AddCommand="{Binding AddMagicSchoolCommand}"
                                          RemoveCommand="{Binding RemoveMagicSchoolCommand}"/>
            </VerticalStackLayout>

            <!-- Guerriers/Équipement se chargent au premier passage sur leur onglet, comme le récap en
                 lecture seule - toujours vide pour une bande en cours de création (Item.Id == 0), voir
                 EnsureWarriorsLoadedAsync/EnsureEquipmentListsLoadedAsync. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsWarriorsTab}">
                <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                                   HorizontalOptions="Center" WidthRequest="60" HeightRequest="60"/>
                <components:ChipListView ItemsSource="{Binding Warriors}"
                                          IconGlyph="{x:Static icons:SolidFont.Shield}"
                                          Command="{Binding EditWarriorCommand}"
                                          AddCommand="{Binding AddWarriorCommand}"
                                          RemoveCommand="{Binding RemoveWarriorCommand}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEquipmentTab}">
                <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                                   HorizontalOptions="Center" WidthRequest="60" HeightRequest="60"/>
                <components:ChipListView ItemsSource="{Binding EquipmentLists}"
                                          IconGlyph="{x:Static icons:SolidFont.ListCheck}"
                                          Command="{Binding EditEquipmentListCommand}"
                                          AddCommand="{Binding AddEquipmentListCommand}"
                                          RemoveCommand="{Binding RemoveEquipmentListCommand}"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc BtnSave}"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>
